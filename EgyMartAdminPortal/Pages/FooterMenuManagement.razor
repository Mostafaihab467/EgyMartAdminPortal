@page "/footer"
@inject FooterMenuService FooterMenuService
@inject ToastrService ToastService

<PageTitle>Footer</PageTitle>
<h3>Footer</h3>

<div class="mt-2">
    <button class="btn btn-primary" @onclick="() => ShowPopup(0)"><i class="fas fa-plus-circle"></i> Add New</button>
</div>

<Popup IsVisible="showPopup" Title="@popupTitle" OnSave="CreateAsync" FormModel="newItem">
    <div class="form-group">
        <label for="pageTitle">Page Title</label>
        <input type="text" class="form-control" id="pageTitle" @bind="newItem.FooterItemTitle" @ref="itemRef" />
        <ValidationMessage For="@(() => newItem.FooterItemTitle)" />
    </div>
    <div class="form-group">
        <label for="targetUrl">Target Url</label>
        <input class="form-control" id="targetUrl" @bind="@newItem.TargetUrl" />
        <ValidationMessage For="@(() => newItem.TargetUrl)" />
    </div>
    <div class="form-group">
        <label for="displayOrder">Display Order</label>
        <InputPositiveNumber Value="@newItem.DisplayOrder"
                             ValueChanged="@(value => { newItem.DisplayOrder = value; StateHasChanged(); })" />
        <ValidationMessage For="@(() => newItem.DisplayOrder)" />
    </div>
    <div class="form-group">
        <label for="columnIndex">Column Index</label>
        <InputPositiveNumber Value="@newItem.ColumnIndex"
                             ValueChanged="@(value => { newItem.ColumnIndex = value; StateHasChanged(); })" />
        <ValidationMessage For="@(() => newItem.ColumnIndex)" />
    </div>
</Popup>

<div class="mt-3 text-center">
    <LoadingSpinner IsLoading="isLoading" />
</div>

@if (!isLoading)
{
    @if (allItems.Count == 0)
    {
        <p class="text-center">@notFound</p>
    }
    else
    {
        <PageSelect PageSize="@PageSize" Count="@allItems.Count" OnPageSizeChanged="HandlePageSizeChanged"></PageSelect>
        <table class="table accordion">
            <thead>
                <tr>
                    <th scope="col">MenuItem Title</th>
                    <th scope="col">Target Url</th>
                    <th scope="col">Display Order</th>
                    <th scope="col">Column Index</th>
                    <th scope="col">Status</th>
                    <th scope="col">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in pagedItems)
                {
                    <tr>

                        <td>
                            <EditableField T="string" Value="@item.FooterItemTitle" Width="100" ValueChanged="value => SaveEdit(item, nameof(item.FooterItemTitle), value)" />
                        </td>
                        <td>
                            <EditableField T="string" Value="@item.TargetUrl" ValueChanged="value => SaveEdit(item, nameof(item.TargetUrl), value)" />
                        </td>
                        <td>
                            <EditableField T="int" InputType="number" Width="100" Value="@item.DisplayOrder" ValueChanged="value => SaveEdit(item, nameof(item.DisplayOrder), value)" />
                        </td>
                        <td>
                            <EditableField T="int" InputType="number" Width="100" Value="@item.ColumnIndex" ValueChanged="value => SaveEdit(item, nameof(item.ColumnIndex), value)" />
                        </td>
                        <td class="cursor-pointer" style="width: 10%;" @onclick="() => ToggleStatus(item.FooterItemID, item.IsActive)">
                            <Badge Class="@($"p-2 {(item.IsActive ? "btn-success" : "btn-danger")}")"
                                   IndicatorType="BadgeIndicatorType.RoundedPill">
                                @(item.IsActive ? "Active" : "Not Active")
                            </Badge>
                        </td>
                         <td>
                            <TranslatePopup Item="@newItem" Service="FooterMenuService" BaseID="item.FooterItemID" OnTranslationSuccess="Refresh" CurrentData="@(new Dictionary<string, object>
                 {
                     { "ColumnIndex", item.ColumnIndex }
                 })">
                                  <label for="pageTitle">Page Title</label>
                                  <input id="pageTitle" class="form-control" @bind="@newItem.FooterItemTitle" />
                                <ValidationMessage For="@(() => newItem.FooterItemTitle)" />
                                    <label for="pageTitle">Page Url</label>
                                  <input id="pageTitle" class="form-control" @bind="@newItem.TargetUrl" />
                                <ValidationMessage For="@(() => newItem.TargetUrl)" />
                             </TranslatePopup>
                         </td>
                    </tr>
                }
            </tbody>
        </table>
    }
}

<!-- Pagination Component -->
<MPagination TItem="FooterMenu"
             Items="allItems"
             CurrentPage="@CurrentPage"
             PageSize="@PageSize"
             OnPageChanged="HandlePageChanged" />

@code {
    private List<FooterMenu> allItems = new();
    private List<FooterMenu> pagedItems = new();
    private FooterMenu newItem = new();
    private Dictionary<long, List<FooterMenu>> childItems = new();
    private HashSet<long> expandedItems = new();
    public ElementReference itemRef;

    private bool isLoading = true;
    private string notFound = "No Pages Found";
    private string popupTitle = "Add New Page";
    private bool showPopup;
    private int CurrentPage = 1;
    private int PageSize = 25;

    protected override async Task OnInitializedAsync()
    {
        await GetItemsAsync();
    }

    private async Task GetItemsAsync()
    {
        var response = await FooterMenuService.GetAsync();
        if (response != null)
        {
            allItems = response;
            isLoading = false;
            UpdatePagedItems();
        }
        else
        {
            isLoading = false;
            await ToastService.ShowErrorAsync("Error While Getting Pages", "Error");
        }
    }

    private async Task CreateAsync()
    {
        var response = await FooterMenuService.CreateAsync(newItem);

        if (response.IsSuccessStatusCode)
        {
            await ToastService.ShowSuccessAsync("Page Created Successfully", "Success");
            showPopup = false;
            await GetItemsAsync();
        }
        else
        {
            await ToastService.ShowErrorAsync("Error While Creating New Page", "Error");
        }
    }

    private void ShowPopup(int parentID)
    {
        showPopup = true;
        newItem = new FooterMenu();
        newItem.ParentID = parentID;
        StateHasChanged();
        Task.Delay(100).ContinueWith(async _ => await itemRef.FocusAsync());

    }

    private async Task ToggleStatus(int itemID, bool currentStatus)
    {
        showPopup = false;
        var item = allItems.FirstOrDefault(i => i.FooterItemID == itemID);

        if (item == null)
        {
            await ToastService.ShowErrorAsync("Item not found", "Error");
            return;
        }

        item.IsActive = !currentStatus;

        var response = await FooterMenuService.ChangeStatusAsync(itemID, item.IsActive);

        if (response.Data == 0)
        {
            item.IsActive = currentStatus;
            await ToastService.ShowErrorAsync("Error updating status", "Error");
        }

        StateHasChanged();
    }

    private async Task SaveEdit(FooterMenu item, string fieldName, object newValue)
    {
        showPopup = false;
        var property = typeof(FooterMenu).GetProperty(fieldName);
        if (property == null) return;

        var currentValue = property.GetValue(item);
        
        if (property.PropertyType == typeof(int))
        {
            if (int.TryParse(newValue?.ToString(), out int newIntValue) &&
                currentValue is int currentIntValue &&
                newIntValue == currentIntValue)
            {
                return;
            }
        }
        else if (property.PropertyType == typeof(string))
        {
            if (currentValue?.ToString() == newValue?.ToString()) return;
        }

        if (fieldName == nameof(FooterMenu.FooterItemTitle) && string.IsNullOrWhiteSpace(newValue?.ToString()))
        {
            await ToastService.ShowErrorAsync("Menu Title is empty", "Validation Error");
            return;
        }

        if (fieldName == nameof(FooterMenu.TargetUrl) && string.IsNullOrWhiteSpace(newValue?.ToString()))
        {
            await ToastService.ShowErrorAsync("Menu Url is empty", "Validation Error");
            return;
        }

        if (property.PropertyType == typeof(int) && int.TryParse(newValue!.ToString(), out int intValue))
        {
            property.SetValue(item, intValue);
        }
        else if (property.PropertyType == typeof(string))
        {
            property.SetValue(item, newValue!.ToString());
        }

        var response = await FooterMenuService.EditAsync(item);
        if (response.IsSuccessStatusCode)
        {
            // Ensure the updated value is assigned to the list
            var updatedItem = allItems.FirstOrDefault(i => i.FooterItemID == item.FooterItemID);
            if (updatedItem != null)
            {
                property.SetValue(updatedItem, property.GetValue(item));
            }

            await ToastService.ShowSuccessAsync("Update successful", "Success");
            await GetItemsAsync();
        }
        else
        {
            await ToastService.ShowErrorAsync("Error updating item", "Error");
        }

        StateHasChanged();
    }


    private void UpdatePagedItems()
    {
        pagedItems = allItems.Skip((CurrentPage - 1) * PageSize).Take(PageSize).ToList();
    }

    private void HandlePageChanged(int newPage)
    {
        CurrentPage = newPage;
        UpdatePagedItems();
    }

    private void HandlePageSizeChanged(int newSize)
    {
        PageSize = newSize;
        CurrentPage = 1;
        UpdatePagedItems();
    }

    private async Task Refresh()
    {
        await ToastService.ShowSuccessAsync("Menu translation completed!", "Success");
    }
}
