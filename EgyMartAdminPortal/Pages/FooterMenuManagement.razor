@page "/footer-menu"
@inject FooterMenuService FooterMenuService
@inject ToastrService ToastService

<PageTitle>FooterMenu Management</PageTitle>
<h3>FooterMenuManagement</h3>

<div class="mt-2">
    <button class="btn btn-primary" @onclick="() => ShowPopup(0)"><i class="fas fa-plus-circle"></i> Add New</button>
</div>

<Popup IsVisible="showPopup" Title="@popupTitle" OnSave="CreateAsync">
    <div class="form-group">
        <label for="pageTitle">Page Title</label>
        <input type="text" class="form-control" id="pageTitle" @bind="newItem.FooterItemTitle" @ref="itemRef" />
    </div>
    <div class="form-group">
        <label for="pageBody">Page Body</label>
        <textarea class="form-control" id="pageBody" @bind="@newItem.TargetUrl" rows="4" />
    </div>
    <div class="form-group">
        <label for="displayOrder">Display Order</label>
        <input type="number" class="form-control" id="displayOrder" @bind="newItem.DisplayOrder" />
    </div>
    <div class="form-group">
        <label for="columnIndex">Column Index</label>
        <input type="number" class="form-control" id="columnIndex" @bind="newItem.ColumnIndex" />
    </div>
</Popup>

<div class="mt-3 text-center">
    <LoadingSpinner IsLoading="isLoading" />
</div>

@if (!isLoading)
{
    @if (allItems.Count == 0)
    {
        <p class="text-center">@notFound</p>
    }
    else
    {
        <PageSelect PageSize="@PageSize" Count="@allItems.Count" OnPageSizeChanged="HandlePageSizeChanged"></PageSelect>
        <table class="table accordion">
            <thead>
                <tr>
                    <th scope="col">MenuItem Title</th>
                    <th scope="col">Target Url</th>
                    <th scope="col">Display Order</th>
                    <th scope="col">Column Index</th>
                    <th scope="col">Status</th>
                    <th scope="col">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in pagedItems)
                {
                    <tr>
                        <th data-bs-toggle="collapse" data-bs-target="#@item.FooterItemID" class="cursor-pointer" scope="row">
                            <i class="fas fa-caret-right colored p-2 fs-6 @(expandedItems.Contains(item.FooterItemID) ? "rotate-45" : "")" @onclick="() => ToggleChildItems(item.FooterItemID)"></i>
                            <EditableField T="string" Value="@item.FooterItemTitle" ValueChanged="value => SaveEdit(item, nameof(item.FooterItemTitle), value)" />
                        </th>
                        <td data-bs-toggle="collapse" data-bs-target="#@item.FooterItemID" class="cursor-pointer">
                            <EditableField T="string" Value="@item.TargetUrl" ValueChanged="value => SaveEdit(item, nameof(item.TargetUrl), value)" />
                        </td>
                        <td data-bs-toggle="collapse" data-bs-target="#@item.FooterItemID" class="cursor-pointer">
                            <EditableField T="int" InputType="number" Value="@item.DisplayOrder" ValueChanged="value => SaveEdit(item, nameof(item.DisplayOrder), value)" />
                        </td>
                        <td data-bs-toggle="collapse" data-bs-target="#@item.FooterItemID" class="cursor-pointer">
                            <EditableField T="int" InputType="number" Value="@item.ColumnIndex" ValueChanged="value => SaveEdit(item, nameof(item.ColumnIndex), value)" />
                        </td>
                        <td class="cursor-pointer">
                            @if (item.IsActive)
                            {
                                <Badge Class="p-2 btn-success" IndicatorType="BadgeIndicatorType.RoundedPill" @onclick="() => ToggleStatus(item.FooterItemID, item.IsActive, true)">Active</Badge>
                            }
                            else
                            {
                                <Badge Class="p-2 btn-danger" IndicatorType="BadgeIndicatorType.RoundedPill" @onclick="() => ToggleStatus(item.FooterItemID, item.IsActive, true)">Not Active</Badge>
                            }
                        </td>
                        <td>
                            <Button class="btn btn-primary d-inline-block" TooltipTitle="Create Child" TooltipPlacement="TooltipPlacement.Top" data-bs-original-title="Create Child" @onclick="() => ShowPopup(item.FooterItemID)">
                                <i class="fas fa-id-badge"></i>
                            </Button>

                            <TranslatePopup Item="item" Service="FooterMenuService" BaseID="item.FooterItemID" OnTranslationSuccess="Refresh">
                                <label for="pageTitle">Page Title</label>
                                <input id="pageTitle" class="form-control" @bind="item.FooterItemTitle" />
                            </TranslatePopup>
                        </td>
                    </tr>
                    <tr class="collapse @(expandedItems.Contains(item.FooterItemID) ? "show" : "")" id="@($"child-{item.FooterItemID}")" data-bs-parent=".table">
                        <td colspan="5">
                            @if (childItems.ContainsKey(item.FooterItemID) && childItems[item.FooterItemID].Any())
                            {
                                <p>Child Header Menu: @childItems[item.FooterItemID].Count</p>
                                <table class="table childTable">
                                    <thead>
                                        <tr>
                                            <th scope="col">MenuItem Title</th>
                                            <th scope="col">Target Url</th>
                                            <th scope="col">Display Order</th>
                                            <th scope="col">Column Index</th>
                                            <th scope="col">Status</th>
                                            <th scope="col">Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var child in childItems[item.FooterItemID])
                                        {
                                            <tr class="child">
                                                <td class="cursor-pointer">
                                                    <EditableField T="string" Value="@child.FooterItemTitle" ValueChanged="value => SaveEdit(child, nameof(child.FooterItemTitle), value)" />
                                                </td>
                                                <td class="cursor-pointer">
                                                    <EditableField T="string" Value="@child.TargetUrl" ValueChanged="value => SaveEdit(child, nameof(child.TargetUrl), value)" />
                                                </td>
                                                <td class="cursor-pointer">
                                                    <EditableField T="int" InputType="number" Value="@child.DisplayOrder" ValueChanged="value => SaveEdit(child, nameof(child.DisplayOrder), value)" />
                                                </td>
                                                <td class="cursor-pointer">
                                                    @if (child.IsActive)
                                                    {
                                                        <Badge Class="p-2 btn-success" IndicatorType="BadgeIndicatorType.RoundedPill" @onclick="() => ToggleStatus(child.FooterItemID, child.IsActive, false)">Active</Badge>
                                                    }
                                                    else
                                                    {
                                                        <Badge Class="p-2 btn-danger" IndicatorType="BadgeIndicatorType.RoundedPill" @onclick="() => ToggleStatus(child.FooterItemID, child.IsActive, false)">Not Active</Badge>
                                                    }
                                                </td>
                                                <td>
                                                    <TranslatePopup Item="item" Service="FooterMenuService" BaseID="child.FooterItemID" OnTranslationSuccess="Refresh">
                                                        <label for="mainItemTitle">Main Title</label>
                                                        <input id="mainItemTitle" class="form-control" bind="@item.FooterItemTitle" />
                                                    </TranslatePopup>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            }
                            else
                            {
                                <p class="text-center">@notFound</p>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
}

<!-- Pagination Component -->
<MPagination TItem="FooterMenu"
             Items="allItems"
             CurrentPage="@CurrentPage"
             PageSize="@PageSize"
             OnPageChanged="HandlePageChanged" />

@code {
    private List<FooterMenu> allItems = new();
    private List<FooterMenu> pagedItems = new();
    private FooterMenu newItem = new();
    private Dictionary<long, List<FooterMenu>> childItems = new();
    private HashSet<long> expandedItems = new();
    public ElementReference itemRef;

    private bool isLoading = true;
    private string notFound = "No Pages Found";
    private string popupTitle = "Add New Page";
    private bool showPopup;
    private int CurrentPage = 1;
    private int PageSize = 25;

    protected override async Task OnInitializedAsync()
    {
         await GetItemsAsync();
    }

    private async Task GetItemsAsync()
    {
        var response = await FooterMenuService.GetAsync();
        if (response != null)
        {
            allItems = response;
            isLoading = false;
            UpdatePagedItems();
        }
        else
        {
            isLoading = false;
            await ToastService.ShowErrorAsync("Error While Getting Items", "Error");
        }
    }

    private async Task CreateAsync()
    {
        var response = await FooterMenuService.CreateAsync(newItem);

        if (response.IsSuccessStatusCode)
        {
            await ToastService.ShowSuccessAsync("Page Created Successfully", "Success");
            showPopup = false;
            if (newItem.ParentID == 0)
            {
                await GetItemsAsync();
            }
            else
            {
                await GetChild(newItem.ParentID);
            }
        }
        else
        {
            await ToastService.ShowErrorAsync("Error While Creating New Icon", "Error");
        }
    }

    private async Task GetChild(int ItemID)
    {
        // var response = await FooterMenuService.GetChildAsync(ItemID);
        // if (response.Count > 0)
        // {

        //     childItems[ItemID] = response.Any() ? response : new List<FooterMenu>(); ✅ Ensure key exists
        // }
        // else
        // {
        //     notFound = "No Child Item Found";
        //     childItems[ItemID] = new List<FooterMenu>();
        // }
        // ✅ Ensure UI updates
        // StateHasChanged();
    }

    private async Task ToggleChildItems(int itemID)
    {
        showPopup = false;
        if (expandedItems.Contains(itemID))
        {
            expandedItems.Remove(itemID);
            childItems.Remove(itemID); // ✅ Collapse: Remove child data
        }
        else
        {
            expandedItems.Add(itemID);
            await GetChild(itemID);
        }

        // Trigger UI refresh
        StateHasChanged();
    }

    private void ShowPopup(int parentID)
    {
        showPopup = true;
        newItem = new FooterMenu();
        newItem.ParentID = parentID;
        StateHasChanged();
        Task.Delay(100).ContinueWith(async _ => await itemRef.FocusAsync());

    }

    private async Task ToggleStatus(int itemID, bool currentStatus, bool isParent)
    {
        showPopup = false;
        var item = isParent
            ? allItems.FirstOrDefault(i => i.FooterItemID == itemID)
            : childItems.Values.SelectMany(list => list).FirstOrDefault(i => i.FooterItemID == itemID);

        if (item == null)
        {
            await ToastService.ShowErrorAsync("Item not found", "Error");
            return;
        }

        item.IsActive = !currentStatus;

        var response = await FooterMenuService.ChangeStatusAsync(itemID, item.IsActive);

        if (response.Data == 0)
        {
            item.IsActive = currentStatus;
            await ToastService.ShowErrorAsync("Error updating status", "Error");
        }

        StateHasChanged();
    }

    private async Task SaveEdit(FooterMenu item, string fieldName, object newValue)
    {
        showPopup = false;
        var property = typeof(FooterMenu).GetProperty(fieldName);
        if (property == null) return;

        var currentValue = property.GetValue(item);
        if (currentValue?.ToString() == newValue?.ToString()) return;

        if (property.PropertyType == typeof(int) && int.TryParse(newValue!.ToString(), out int intValue))
        {
            property.SetValue(item, intValue);
        }
        else if (property.PropertyType == typeof(string))
        {
            property.SetValue(item, newValue!.ToString());
        }

        var response = await FooterMenuService.EditAsync(item);
        if (response.IsSuccessStatusCode)
        {
            await ToastService.ShowSuccessAsync("Update successful", "Success");
        }
        else
        {
            await ToastService.ShowErrorAsync("Error updating item", "Error");
        }

        StateHasChanged();
    }

    private void UpdatePagedItems()
    {
        pagedItems = allItems.Skip((CurrentPage - 1) * PageSize).Take(PageSize).ToList();
    }

    private void HandlePageChanged(int newPage)
    {
        CurrentPage = newPage;
        UpdatePagedItems();
    }

    private void HandlePageSizeChanged(int newSize)
    {
        PageSize = newSize;
        CurrentPage = 1;
        UpdatePagedItems();
    }

    private async Task Refresh()
    {
        await ToastService.ShowSuccessAsync("Menu translation completed!", "Success");
    }
}
