@page "/ads-management"

@inject NavigationManager NavigationManager
@inject SubscriptionService SubscriptionService
@inject ToastrService ToastService

<PageTitle>Ads Management</PageTitle>
<h1>Ads Management</h1>
<div class="mt-2">
    <button class="btn btn-primary" @onclick="() => ShowPopup(false, 0)"><i class="fas fa-plus-circle"></i> Add New</button>
</div>

<Popup IsVisible="showPopup" Title="@popupTitle" OnSave="CreateEditAdvertising">
    <div class="form-group">
        <label for="planTitle">Plan Title</label>
        <input type="text" class="form-control" id="planTitle" @bind="newItem.PlanTitle" @ref="itemRef" />
    </div>
    <div class="form-group">
        <label for="planLocation">Plan Location</label>
        <select class="form-control" id="planLocation" @bind="newItem.LocationID">
            <option value="0" disabled selected>Select Plan Location</option>
            @foreach (var location in locations)
            {
                <option value="@location.AdsLocationID">@location.AdsLocationTitle</option>
            }
        </select>
    </div>
    <div class="form-group">
        <label for="durationDays">Duration Per Day</label>
        <input type="number" class="form-control" id="durationDays" @bind="newItem.DurationDays" />
    </div>
    <div class="form-group">
        <label for="costBefore">Cost Before</label>
        <input type="number" class="form-control" id="costBefore" @bind="newItem.CostBefore" />
    </div>
    <div class="form-group">
        <label for="cost">Cost</label>
        <input type="number" class="form-control" id="cost" @bind="newItem.Cost" />
    </div>
    <div class="form-group">
        <label for="planDescription">Plan Description</label>
        <textarea class="form-control" id="planDescription" @bind="@newItem.PlanDescription" Rows="3" />
    </div>
</Popup>

<div class="mt-3 text-center">
    <LoadingSpinner IsLoading="isLoading" />
</div>


@if (!isLoading)
{
    @if (allItems.Count == 0)
    {
        <p class="text-center">@notFound</p>
    }
    else
    {
        <PageSelect PageSize="@PageSize" Count="@allItems.Count" OnPageSizeChanged="HandlePageSizeChanged"></PageSelect>
        <table class="table">
            <thead>
                <tr>
                    <th>PlanTitle</th>
                    <th>AdsLocationTitle</th>
                    <th>PlanDescription</th>
                    <th>DurationDays</th>
                    <th>Cost Before</th>
                    <th>Cost</th>
                    <th>Status</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in pagedItems)
                {
                    <tr id="ad-@item.AdsPlanID">
                        <td>@item.PlanTitle</td>
                        <td>@item.AdsLocationTitle</td>
                        <td>@item.PlanDescription</td>
                        <td>@item.DurationDays</td>
                        <td>@item.CostBefore</td>
                        <td>@item.Cost</td>
                        <td class="cursor-pointer">
                            @if (item.IsActive)
                            {
                                <Badge Class="p-2 btn-success" IndicatorType="BadgeIndicatorType.RoundedPill" @onclick="() => ToggleStatus(item.AdsPlanID, item.IsActive, false)">Active</Badge>
                            }
                            else
                            {
                                <Badge Class="p-2 btn-danger" IndicatorType="BadgeIndicatorType.RoundedPill" @onclick="() => ToggleStatus(item.AdsPlanID, item.IsActive, false)">Not Active</Badge>
                            }
                        </td>
                        <td>
                            <Button class="btn btn-primary" TooltipTitle="Edit" TooltipPlacement="TooltipPlacement.Top" data-bs-original-title="Edit" @onclick="() => ShowPopup(true, item.AdsPlanID)"><i class="far fa-edit"></i></Button>
                            <TranslatePopup Item="@newItem" Service="SubscriptionService" BaseID="item.AdsPlanID" OnTranslationSuccess="Refresh">
                                <label for="planTitle">Plan Title</label>
                                <input id="planTitle" class="form-control" @bind="@newItem.PlanTitle" />

                                <label for="planDescription" class="mt-2">Plan Description</label>
                                <textarea id="planDescription" class="form-control" @bind="@newItem.PlanDescription"></textarea>
                            </TranslatePopup>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }

    <!-- Pagination Component -->
    <MPagination TItem="Subscription"
    Items="allItems"
    CurrentPage="@CurrentPage"
    PageSize="@PageSize"
    OnPageChanged="HandlePageChanged" />
}

@code {
    private List<Subscription> allItems = new();
    private List<Subscription> pagedItems = new();
    private Subscription newItem = new();
    private List<AdsLocation> locations = new();
    public ElementReference itemRef;

    private string notFound = "No Advertising Plans Found";
    private string popupTitle = "Add New Plan";
    private bool showPopup = false;
    private bool isEdit = false;
    private bool isLoading = true;

    private int CurrentPage = 1;
    private int PageSize = 25;

    private void ShowPopup(bool editMode, long ID)
    {
        isEdit = editMode;
        showPopup = true;
        newItem = editMode ? allItems.FirstOrDefault(a => a.AdsPlanID == ID)! : new Subscription();
        StateHasChanged();
        Task.Delay(100).ContinueWith(async _ => await itemRef.FocusAsync());
        if (ID == 0)
        {
            newItem.BaseID = 0;
            newItem.LangID = 1;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await GetSubscriptionsAsync();
        await GetAdsLocationsAsync();
    }

    private async Task CreateEditAdvertising()
    {
        if (newItem.CostBefore > 0)
        {
            if (newItem.Cost >= newItem.CostBefore)
            {
                await ToastService.ShowErrorAsync("Cost must be less than Cost Before.");
                return;
            }
        }
        if (newItem.DurationDays <= 0)
        {
            await ToastService.ShowErrorAsync("Duration Days must be bigger than 0.");
            return;
        }
        if (newItem.AdsPlanID == 0)
        {
            var response = await SubscriptionService.CreateAsync(newItem);

            if (response.IsSuccessStatusCode)
            {
                await ToastService.ShowSuccessAsync("Plan Created Successfully", "Success");
                showPopup = false;
                await GetSubscriptionsAsync();
            }
            else
            {
                await ToastService.ShowErrorAsync("Error While Creating New Category", "Error");
            }
        }
        else
        {
            var response = await SubscriptionService.EditAsync(newItem);
            if (response.IsSuccessStatusCode)
            {
                await ToastService.ShowSuccessAsync("Plan Updated Successfully", "Success");
                showPopup = false;
                await GetSubscriptionsAsync();
            }
            else
            {
                await ToastService.ShowErrorAsync("Error While Updating Plan", "Error");
            }
        }
    }

    private async Task GetAdsLocationsAsync()
    {
        try
        {
            var response = await SubscriptionService.GetLocationsAsync();
            if (response.Success)
            {
                locations = response.Data;
                StateHasChanged();
            }
            else await ToastService.ShowErrorAsync(response.ResponseEngMsg);
        }
        catch (Exception ex)
        {
            await ToastService.ShowErrorAsync(ex.Message);
        }
    }

    private async Task GetSubscriptionsAsync()
    {
        try
        {
            var response = await SubscriptionService.GetSubscriptionsAsync();
            if (response.Success)
            {
                allItems = response.Data;
                isLoading = false;
                UpdatePagedItems();
            }
            else
            {
                await ToastService.ShowErrorAsync(response.ResponseEngMsg);
            }

        }
        catch (Exception ex)
        {
            await ToastService.ShowErrorAsync(ex.Message);
        }
    }

    private async Task ToggleStatus(long itemID, bool currentStatus, bool isParent)
    {
        showPopup = false;
        var item = allItems.FirstOrDefault(i => i.AdsPlanID == itemID);
        if (item == null)
        {
            await ToastService.ShowErrorAsync("Item not found", "Error");
            return;
        }
        item.IsActive = !currentStatus;
        var response = await SubscriptionService.ChangeStatusAsync(itemID, item.IsActive);

        if (!response.Success)
        {
            item.IsActive = currentStatus;
            await ToastService.ShowErrorAsync("Error updating status", "Error");
        }
        StateHasChanged();
    }

    private void OnLocationChange(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int locationId))
        {
            newItem.LocationID = locationId;

            var selectedLocation = locations.FirstOrDefault(loc => loc.AdsLocationID == locationId);
            if (selectedLocation != null)
            {
                Console.WriteLine($"Selected Location: {selectedLocation.AdsLocationID}");
            }
        }
    }

    private void UpdatePagedItems()
    {
        showPopup = false;
        pagedItems = allItems.Skip((CurrentPage - 1) * PageSize).Take(PageSize).ToList();
    }

    private void HandlePageChanged(int newPage)
    {
        CurrentPage = newPage;
        UpdatePagedItems();
    }

    private void HandlePageSizeChanged(int newSize)
    {
        showPopup = false;
        PageSize = newSize;
        CurrentPage = 1;
        UpdatePagedItems();
    }

    private async Task Refresh()
    {
        showPopup = false;
        await ToastService.ShowSuccessAsync("Page translation completed!", "Success");
    }
}
