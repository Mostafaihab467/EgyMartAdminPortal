@page "/pages"
@inject FixedPageService FixedPageService
@inject ToastrService ToastService
@inject IJSRuntime JSRuntime

<PageTitle>Pages</PageTitle>
<h3>Pages</h3>

<div class="mt-2">
    <button class="btn btn-primary" @onclick="() => ShowPopup()"><i class="fas fa-plus-circle"></i> Add New</button>
</div>

<Popup IsVisible="showPopup" Title="@popupTitle" Class="m-model" OnSave="CreateAsync" FormModel="newItem">
    <div class="form-group">
        <label for="pageTitle">Page Title</label>
        <input type="text" class="form-control" id="pageTitle" @bind="newItem.PageTitle" @ref="itemRef" />
        <ValidationMessage For="@(() => newItem.PageTitle)" />
    </div>
    <div class="form-group h-100">
        <label for="pageBody">Page Body</label>
        <HtmlEditor @bind-Value="@newItem.PageBody"/>
        <ValidationMessage For="@(() => newItem.PageBody)" />
    </div>
</Popup>

<div class="mt-3 text-center">
    <LoadingSpinner IsLoading="isLoading" />
</div>

@if (!isLoading)
{
    @if (allItems.Count == 0)
    {
        <p class="text-center">@notFound</p>
    }
    else
    {
        <PageSelect PageSize="@PageSize" Count="@allItems.Count" OnPageSizeChanged="HandlePageSizeChanged"></PageSelect>
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Page ID</th>
                    <th>Page Title</th>
                    <th>Page Body</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in pagedItems)
                {
                    <tr>
                        <td>
                            <span>@item.PageID</span>
                        </td>
                        <td class="cursor-pointer">
                            <EditableField T="string" Value="@item.PageTitle" ValueChanged="value => SaveEdit(item, nameof(item.PageTitle), value)" />
                        </td>
                        <td>
                            <EditableField T="string" InputType="textarea" Frame="true" Width="100" Value="@item.PageBody" ValueChanged="value => SaveEdit(item, nameof(item.PageBody), value)" />
                        </td>
                        <td class="cursor-pointer" style="width: 10%;" @onclick="() => ToggleStatus(item.PageID, item.IsActive)">
                            <Badge Class="@($"p-2 {(item.IsActive ? "btn-success" : "btn-danger")}")"
                                   IndicatorType="BadgeIndicatorType.RoundedPill">
                                @(item.IsActive ? "Active" : "Not Active")
                            </Badge>
                        </td>
                        <td>
                            <TranslatePopup Item="@newItem" Class="tr-model" Service="FixedPageService" IsHtmlEditor="true" BaseID="@item.PageID" OnTranslationSuccess="Refresh">
                                <label for="pageTitle">Page Title</label>
                                <input id="pageTitle" class="form-control" @bind="@newItem.PageTitle" />
                                <ValidationMessage For="@(() => newItem.PageTitle)" />
                                <label for="pageBody" class="mt-2">Page Body</label>
                                <HtmlEditor @bind-Value="@newItem.PageBody" />
                                <ValidationMessage For="@(() => newItem.PageBody)" />
                            </TranslatePopup>
                            <button class="btn btn-outline-danger btn-sm ms-1" title="Delete" @onclick="() => DeleteItemAsync(item)"><i class="fas fa-trash"></i></button>

                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
}

<!-- Pagination Component -->
<MPagination TItem="FixedPage"
             Items="allItems"
             CurrentPage="@CurrentPage"
             PageSize="@PageSize"
             OnPageChanged="HandlePageChanged" />

@code {
    private List<FixedPage> allItems = new();
    private List<FixedPage> pagedItems = new();
    private FixedPage newItem = new();
    public ElementReference itemRef;

    private bool isLoading = true;
    private string notFound = "No Pages Found";
    private string popupTitle = "Add New Page";
    private bool showPopup;
    private int CurrentPage = 1;
    private int PageSize = 25;

    protected override async Task OnInitializedAsync()
    {
        await GetAsync();
    }

    private void ShowPopup()
    {
        showPopup = true;
        newItem = new FixedPage();
        StateHasChanged();
        Task.Delay(100).ContinueWith(async _ => await itemRef.FocusAsync());
    }

    private async Task CreateAsync()
    {
        var response = await FixedPageService.CreateAsync(newItem);

        if (response.IsSuccessStatusCode)
        {
            await ToastService.ShowSuccessAsync("Page Created Successfully", "Success");
            showPopup = false;
            await GetAsync();
        }
        else
        {
            await ToastService.ShowErrorAsync("Error While Creating New Icon", "Error");
        }
    }

    private async Task SaveEdit(FixedPage item, string fieldName, object newValue)
    {
        showPopup = false;
        var property = typeof(FixedPage).GetProperty(fieldName);
        if (property == null) return;

        var currentValue = property.GetValue(item);
        
        if (property.PropertyType == typeof(int))
        {
            if (int.TryParse(newValue?.ToString(), out int newIntValue) &&
                currentValue is int currentIntValue &&
                newIntValue == currentIntValue)
            {
                return;
            }
        }
        else if (property.PropertyType == typeof(string))
        {
            if (currentValue?.ToString() == newValue?.ToString()) return;
        }

        if (fieldName == nameof(FixedPage.PageTitle) && string.IsNullOrWhiteSpace(newValue?.ToString()))
        {
            await ToastService.ShowErrorAsync("Page Title is empty", "Validation Error");
            return;
        }

        if (fieldName == nameof(FixedPage.PageBody) && string.IsNullOrWhiteSpace(newValue?.ToString()))
        {
            await ToastService.ShowErrorAsync("Page Body is empty", "Validation Error");
            return;
        }

        if (property.PropertyType == typeof(int) && int.TryParse(newValue!.ToString(), out int intValue))
        {
            property.SetValue(item, intValue);
        }
        else if (property.PropertyType == typeof(string))
        {
            property.SetValue(item, newValue!.ToString());
        }

        var response = await FixedPageService.EditAsync(item);
        if (response.IsSuccessStatusCode)
        {
            await ToastService.ShowSuccessAsync("Update successful", "Success");
        }
        else
        {
            await ToastService.ShowErrorAsync("Error updating page", "Error");
        }

        StateHasChanged();
    }

    private async Task GetAsync()
    {
        var response = await FixedPageService.GetAsync();
        if (response != null)
        {
            allItems = response;
            isLoading = false;
            UpdatePagedItems();
        }
        else
        {
            isLoading = false;
            await ToastService.ShowErrorAsync("Error While Getting Items", "Error");
        }
    }

    private async Task ToggleStatus(int ID, bool currentStatus)
    {
        showPopup = false;
        var item = allItems.FirstOrDefault(i => i.PageID == ID);

        if (item == null)
        {
            await ToastService.ShowErrorAsync("Item not found", "Error");
            return;
        }

        item.IsActive = !currentStatus;
        var response = await FixedPageService.ChangeStatusAsync(ID, item.IsActive);

        if (response.Data == 0)
        {
            item.IsActive = currentStatus;
            await ToastService.ShowErrorAsync("Error updating status", "Error");
        }

        StateHasChanged();
    }

    // --- Delete Fixed Page ---
    private async Task DeleteItemAsync(FixedPage item)
    {
        bool confirmed = await JSRuntime.InvokeAsync<bool>("confirm", $"Delete '{item.PageTitle}'? Its sub items and translations are deleted too. This cannot be undone.");
        if (!confirmed) return;

        var response = await FixedPageService.DeleteAsync(item.PageID);
        if (response.IsSuccessStatusCode)
        {
            allItems.RemoveAll(i => i.PageID == item.PageID);
            var maxPage = Math.Max(1, (int)Math.Ceiling(allItems.Count / (double)PageSize));
            if (CurrentPage > maxPage) CurrentPage = maxPage;
            UpdatePagedItems();
            await ToastService.ShowSuccessAsync("Deleted successfully", "Success");
        }
        else
        {
            var message = await ReadErrorMessageAsync(response);
            await ToastService.ShowErrorAsync(message ?? "Error while deleting item", "Error");
        }
    }

    private static async Task<string?> ReadErrorMessageAsync(HttpResponseMessage response)
    {
        try
        {
            var body = await response.Content.ReadAsStringAsync();
            if (string.IsNullOrWhiteSpace(body)) return null;

            using var document = System.Text.Json.JsonDocument.Parse(body);
            if (document.RootElement.ValueKind != System.Text.Json.JsonValueKind.Object) return null;

            foreach (var name in new[] { "responseEngMsg", "ResponseEngMsg", "message", "Message" })
            {
                if (document.RootElement.TryGetProperty(name, out var element) &&
                    element.ValueKind == System.Text.Json.JsonValueKind.String)
                {
                    var value = element.GetString();
                    if (!string.IsNullOrWhiteSpace(value)) return value;
                }
            }
        }
        catch (Exception)
        {
            // Response body is not JSON - fall back to the generic message.
        }

        return null;
    }

    private void UpdatePagedItems()
    {
        pagedItems = allItems.Skip((CurrentPage - 1) * PageSize).Take(PageSize).ToList();
    }

    private void HandlePageChanged(int newPage)
    {
        CurrentPage = newPage;
        UpdatePagedItems();
    }

    private void HandlePageSizeChanged(int newSize)
    {
        PageSize = newSize;
        CurrentPage = 1;
        UpdatePagedItems();
    }

    private async Task Refresh()
    {
        await ToastService.ShowSuccessAsync("Page translation completed!", "Success");
    }
}
