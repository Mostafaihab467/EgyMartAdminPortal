@page "/fixed-page"
@inject FixedPageService FixedPageService
@inject ToastrService ToastService

<PageTitle>FixedPage Management</PageTitle>
<h3>FixedPageManagement</h3>

<div class="mt-2">
    <button class="btn btn-primary" @onclick="() => ShowPopup()"><i class="fas fa-plus-circle"></i> Add New</button>
</div>

<Popup IsVisible="showPopup" Title="@popupTitle" OnSave="CreateAsync">
    <div class="form-group">
        <label for="pageTitle">Page Title</label>
        <input type="text" class="form-control" id="pageTitle" @bind="newItem.PageTitle" @ref="itemRef" />
    </div>
    <div class="form-group">
        <label for="pageBody">Page Body</label>
        <textarea class="form-control" id="pageBody" @bind="@newItem.PageBody" rows="4" />
    </div>
</Popup>

<div class="mt-3 text-center">
    <LoadingSpinner IsLoading="isLoading" />
</div>

@if (!isLoading)
{
    @if (allItems.Count == 0)
    {
        <p class="text-center">@notFound</p>
    }
    else
    {
        <PageSelect PageSize="@PageSize" Count="@allItems.Count" OnPageSizeChanged="HandlePageSizeChanged"></PageSelect>
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Page Title</th>
                    <th>Page Body</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in pagedItems)
                {
                    <tr>
                        <td class="cursor-pointer">
                            <EditableField T="string" Value="@item.PageTitle" ValueChanged="value => SaveEdit(item, nameof(item.PageTitle), value)" />
                        </td>
                        <td class="cursor-pointer">
                            <EditableField T="string" InputType="textarea" Value="@item.PageBody" ValueChanged="value => SaveEdit(item, nameof(item.PageBody), value)" />
                        </td>
                        <td class="cursor-pointer">
                            @if (item.IsActive)
                            {
                                <Badge Class="p-2 btn-success" IndicatorType="BadgeIndicatorType.RoundedPill" @onclick="() => ToggleStatus(item.PageID, item.IsActive)">Active</Badge>
                            }
                            else
                            {
                                <Badge Class="p-2 btn-danger" IndicatorType="BadgeIndicatorType.RoundedPill" @onclick="() => ToggleStatus(item.PageID, item.IsActive)">Not Active</Badge>
                            }
                        </td>
                        <td>
                            <TranslatePopup Item="@newItem" Service="FixedPageService" BaseID="@item.PageID" OnTranslationSuccess="Refresh">
                                <label for="pageTitle">Page Title</label>
                                <input id="pageTitle" class="form-control" @bind="@newItem.PageTitle" />

                                <label for="pageBody" class="mt-2">Answer</label>
                                <textarea id="pageBody" class="form-control" @bind="@newItem.PageBody"></textarea>
                            </TranslatePopup>

                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
}

<!-- Pagination Component -->
<MPagination TItem="FixedPage"
Items="allItems"
CurrentPage="@CurrentPage"
PageSize="@PageSize"
OnPageChanged="HandlePageChanged" />

@code {
    private List<FixedPage> allItems = new();
    private List<FixedPage> pagedItems = new();
    private FixedPage newItem = new();
    public ElementReference itemRef;

    private bool isLoading = true;
    private string notFound = "No Pages Found";
    private string popupTitle = "Add New Page";
    private bool showPopup;
    private int CurrentPage = 1;
    private int PageSize = 25;

    protected override async Task OnInitializedAsync()
    {
        await GetAsync();
    }

    private void ShowPopup()
    {
        showPopup = true;
        newItem = new FixedPage();
        StateHasChanged();
        Task.Delay(100).ContinueWith(async _ => await itemRef.FocusAsync());
    }

    private async Task CreateAsync()
    {
        var response = await FixedPageService.CreateAsync(newItem);

        if (response.IsSuccessStatusCode)
        {
            await ToastService.ShowSuccessAsync("Page Created Successfully", "Success");
            showPopup = false;
            await GetAsync();
        }
        else
        {
            await ToastService.ShowErrorAsync("Error While Creating New Icon", "Error");
        }
    }

    private async Task SaveEdit(FixedPage item, string fieldName, object newValue)
    {
        showPopup = false;
        var property = typeof(FixedPage).GetProperty(fieldName);
        if (property == null) return;

        var currentValue = property.GetValue(item);
        if (currentValue?.ToString() == newValue?.ToString()) return;

        if (property.PropertyType == typeof(int) && int.TryParse(newValue!.ToString(), out int intValue))
        {
            property.SetValue(item, intValue);
        }
        else if (property.PropertyType == typeof(string))
        {
            property.SetValue(item, newValue!.ToString());
        }

        var response = await FixedPageService.EditAsync(item);
        if (response.IsSuccessStatusCode)
        {
            await ToastService.ShowSuccessAsync("Update successful", "Success");
        }
        else
        {
            await ToastService.ShowErrorAsync("Error updating page", "Error");
        }

        StateHasChanged();
    }

    private async Task GetAsync()
    {
        var response = await FixedPageService.GetAsync();
        if (response != null)
        {
            allItems = response;
            isLoading = false;
            UpdatePagedItems();
        }
        else
        {
            isLoading = false;
            await ToastService.ShowErrorAsync("Error While Getting Items", "Error");
        }
    }

    private async Task ToggleStatus(int ID, bool currentStatus)
    {
        showPopup = false;
        var item = allItems.FirstOrDefault(i => i.PageID == ID);

        if (item == null)
        {
            await ToastService.ShowErrorAsync("Item not found", "Error");
            return;
        }

        item.IsActive = !currentStatus;
        var response = await FixedPageService.ChangeStatusAsync(ID, item.IsActive);

        if (response.Data == 0)
        {
            item.IsActive = currentStatus;
            await ToastService.ShowErrorAsync("Error updating status", "Error");
        }

        StateHasChanged();
    }

    private void UpdatePagedItems()
    {
        pagedItems = allItems.Skip((CurrentPage - 1) * PageSize).Take(PageSize).ToList();
    }

    private void HandlePageChanged(int newPage)
    {
        CurrentPage = newPage;
        UpdatePagedItems();
    }

    private void HandlePageSizeChanged(int newSize)
    {
        PageSize = newSize;
        CurrentPage = 1;
        UpdatePagedItems();
    }

    private async Task Refresh()
    {
        await ToastService.ShowSuccessAsync("Page translation completed!", "Success");
    }
}
