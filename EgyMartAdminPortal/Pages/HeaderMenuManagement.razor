@page "/header-menu"

@inject NavigationManager NavigationManager
@inject HeaderMenuService HeaderMenuService
@inject ToastrService ToastService

<PageTitle>HeaderMenu Management</PageTitle>
<h1>HeaderMenu Management</h1>

<div class="mt-2">
    <button class="btn btn-primary" @onclick="() => ShowPopup(0)"><i class="fas fa-plus-circle"></i> Add New</button>
</div>

<Popup IsVisible="showPopup" Title="@popupTitle" OnSave="CreateItem" FormModel="newItem">
    <div class="form-group">
        <label for="menuTitle">Menu Item Title</label>
        <input type="text" class="form-control" id="menuTitle" @bind="newItem.MenuItemTitle" @ref="itemRef" />
        <ValidationMessage For="@(() => newItem.MenuItemTitle)" />
    </div>
    <div class="form-group">
        <label for="targetURL">Target URL</label>
        <input type="text" class="form-control" id="targetURL" @bind="newItem.TargetUrl" />
        <ValidationMessage For="@(() => newItem.TargetUrl)" />
    </div>
    <div class="form-group">
        <label for="displayOrder">Display Order</label>
        <InputPositiveNumber Value="@newItem.DisplayOrder"
                             ValueChanged="@(value => { newItem.DisplayOrder = value; StateHasChanged(); })" />
        <ValidationMessage For="@(() => newItem.DisplayOrder)" />
    </div>
</Popup>

<div class="mt-3 text-center">
    <LoadingSpinner IsLoading="isLoading" />
</div>

@if (!isLoading)
{
    @if (allItems.Count == 0)
    {
        <p class="text-center">@notFound</p>
    }
    else
    {
        <PageSelect PageSize="@PageSize" Count="@allItems.Count" OnPageSizeChanged="HandlePageSizeChanged"></PageSelect>
        <table class="table accordion">
            <thead>
                <tr>
                    <th>MenuItem Title</th>
                    <th>Target Url</th>
                    <th>Display Order</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in pagedItems)
                {
                    <tr>
                        <th data-bs-toggle="collapse" data-bs-target="#@item.MenuItemID" class="cursor-pointer" scope="row">
                            <i class="fas fa-caret-right colored p-2 fs-6 @(expandedItems.Contains(item.MenuItemID) ? "rotate-45" : "")" @onclick="() => ToggleChildItems(item.MenuItemID)"></i>
                            <EditableField T="string" Value="@item.MenuItemTitle" ValueChanged="value => SaveEdit(item, nameof(item.MenuItemTitle), value)" />
                        </th>
                        <td data-bs-toggle="collapse" data-bs-target="#@item.MenuItemID" class="cursor-pointer">
                            <EditableField T="string" Value="@item.TargetUrl" ValueChanged="value => SaveEdit(item, nameof(item.TargetUrl), value)" />
                        </td>
                        <td data-bs-toggle="collapse" data-bs-target="#@item.MenuItemID" class="cursor-pointer">
                            <EditableField T="int" InputType="number" Value="@item.DisplayOrder" ValueChanged="value => SaveEdit(item, nameof(item.DisplayOrder), value)" />
                        </td>
                        <td class="cursor-pointer" style="width: 5%;" @onclick="() => ToggleStatus(item.MenuItemID, item.IsActive, true)">
                            <Badge Class="@($"p-2 {(item.IsActive ? "btn-success" : "btn-danger")}")"
                                   IndicatorType="BadgeIndicatorType.RoundedPill">
                                @(item.IsActive ? "Active" : "Not Active")
                            </Badge>
                        </td>
                        <td>
                            <Button class="btn btn-primary" TooltipTitle="Create Child" TooltipPlacement="TooltipPlacement.Top" data-bs-original-title="Create Child" @onclick="() => ShowPopup(item.MenuItemID)">
                                <i class="fas fa-id-badge"></i>
                            </Button>

                @*             <TranslatePopup Item="@newItem" Service="HeaderMenuService" BaseID="item.MenuItemID" *@
                @*             OnTranslationSuccess="Refresh" CurrentData="@(new Dictionary<string, object> *@
                @* { *@
                @*     { "TargetUrl", item.TargetUrl } *@
                @* })"> *@
                @*                 <label for="pageTitle">Page Title</label> *@
                @*                 <input id="pageTitle" class="form-control" @bind="@newItem.MenuItemTitle" /> *@
                @*             </TranslatePopup> *@
                        </td>
                    </tr>
                    <tr class="collapse @(expandedItems.Contains(item.MenuItemID) ? "show" : "")" id="@($"child-{item.MenuItemID}")" data-bs-parent=".table">
                        <td colspan="5">
                            @if (childItems.ContainsKey(item.MenuItemID) && childItems[item.MenuItemID].Any())
                            {
                                <p>Child Header Menu: @childItems[item.MenuItemID].Count</p>
                                <table class="table childTable">
                                    <thead>
                                        <tr>
                                            <th scope="col">MenuItem Title</th>
                                            <th scope="col">Target Url</th>
                                            <th scope="col">Display Order</th>
                                            <th scope="col">Status</th>
                                            <th scope="col">Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var child in childItems[item.MenuItemID])
                                        {
                                            <tr class="child">
                                                <td class="cursor-pointer">
                                                    <EditableField T="string" Value="@child.MenuItemTitle" ValueChanged="value => SaveEdit(child, nameof(child.MenuItemTitle), value)" />
                                                </td>
                                                <td class="cursor-pointer">
                                                    <EditableField T="string" Value="@child.TargetUrl" ValueChanged="value => SaveEdit(child, nameof(child.TargetUrl), value)" />
                                                </td>
                                                <td class="cursor-pointer">
                                                    <EditableField T="int" InputType="number" Value="@child.DisplayOrder" ValueChanged="value => SaveEdit(child, nameof(child.DisplayOrder), value)" />
                                                </td>
                                                <td class="cursor-pointer" style="width: 5%;" @onclick="() => ToggleStatus(child.MenuItemID, item.IsActive, false)">
                                                    <Badge Class="@($"p-2 {(child.IsActive ? "btn-success" : "btn-danger")}")"
                                                           IndicatorType="BadgeIndicatorType.RoundedPill">
                                                        @(child.IsActive ? "Active" : "Not Active")
                                                    </Badge>
                                                </td>
                                                <td>
                @*                                     <TranslatePopup Item="@newItem" Service="HeaderMenuService" BaseID="child.MenuItemID" *@
                @*                                                     OnTranslationSuccess="Refresh" CurrentData="@(new Dictionary<string, object> *@
                @* { *@
                @*     { "TargetUrl", child.TargetUrl } *@
                @* })"> *@
                @*                                         <label for="mainItemTitle">Main Title</label> *@
                @*                                         <input id="mainItemTitle" class="form-control" bind="@child.MenuItemTitle" /> *@
                @*                                     </TranslatePopup> *@
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            }
                            else
                            {
                                <p class="text-center">@notFound</p>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
}

<!-- Pagination Component -->
<MPagination TItem="HeaderMenu"
             Items="allItems"
             CurrentPage="@CurrentPage"
             PageSize="@PageSize"
             OnPageChanged="HandlePageChanged" />

@code {
    private List<HeaderMenu> allItems = new();
    private List<HeaderMenu> pagedItems = new();
    private HeaderMenu newItem = new();
    private Dictionary<long, List<HeaderMenu>> childItems = new();
    private HashSet<long> expandedItems = new();
    public ElementReference itemRef;

    private string popupTitle = "Add New Item";
    private string notFound = "No Items Found";
    private bool showPopup = false;
    private bool isLoading = true;

    private int CurrentPage = 1;
    private int PageSize = 25;

    protected override async Task OnInitializedAsync()
    {
        await GetItemsAsync();
    }

    private async Task GetItemsAsync()
    {
        var response = await HeaderMenuService.GetTopLevelAsync();
        if (response != null)
        {
            allItems = response;
            isLoading = false;
            UpdatePagedItems();
        }
        else
        {
            isLoading = false;
            await ToastService.ShowErrorAsync("Error While Getting Items", "Error");
        }
    }

    private async Task CreateItem()
    {
        newItem.LangID = 1;
        newItem.BaseID = 0;
        var response = await HeaderMenuService.CreateAsync(newItem);
        if (response.IsSuccessStatusCode)
        {
            // ✅ Ensure parent category expands
            if (!expandedItems.Contains(newItem.ParentID))
            {
                expandedItems.Add(newItem.ParentID);
            }
            await ToastService.ShowSuccessAsync("Header Menu Created Successfully", "Success");
            showPopup = false;

            if (newItem.ParentID == 0)
            {
                await GetItemsAsync();
            }
            else
            {
                await GetChild(newItem.ParentID);
            }
        }
        else
        {
            await ToastService.ShowErrorAsync("Error While Creating New Header Menu", "Error");
        }

    }

    private async Task GetChild(long ItemID)
    {
        var response = await HeaderMenuService.GetChildAsync(ItemID);
        if (response.Count > 0)
        {

            childItems[ItemID] = response.Any() ? response : new List<HeaderMenu>(); // ✅ Ensure key exists
        }
        else
        {
            notFound = "No Child Item Found";
            childItems[ItemID] = new List<HeaderMenu>();
        }
        // ✅ Ensure UI updates
        StateHasChanged();
    }

    private async Task ToggleChildItems(long itemID)
    {
        showPopup = false;
        if (expandedItems.Contains(itemID))
        {
            expandedItems.Remove(itemID);
            childItems.Remove(itemID); // ✅ Collapse: Remove child data
        }
        else
        {
            expandedItems.Add(itemID);
            await GetChild(itemID);
        }

        // Trigger UI refresh
        StateHasChanged();
    }

    private void ShowPopup(long parentID)
    {
        showPopup = true;
        newItem = new HeaderMenu();
        newItem.ParentID = parentID;
        StateHasChanged();
        Task.Delay(100).ContinueWith(async _ => await itemRef.FocusAsync());

    }

    private async Task ToggleStatus(long itemID, bool currentStatus, bool isParent)
    {
        showPopup = false;
        var item = isParent
            ? allItems.FirstOrDefault(i => i.MenuItemID == itemID)
            : childItems.Values.SelectMany(list => list).FirstOrDefault(i => i.MenuItemID == itemID);

        if (item == null)
        {
            await ToastService.ShowErrorAsync("Item not found", "Error");
            return;
        }

        item.IsActive = !currentStatus;

        var response = await HeaderMenuService.ChangeStatusAsync(itemID, item.IsActive);

        if (!response.IsSuccessStatusCode)
        {
            item.IsActive = currentStatus;
            await ToastService.ShowErrorAsync("Error updating status", "Error");
        }

        StateHasChanged();
    }

    private async Task SaveEdit(HeaderMenu item, string fieldName, object newValue)
    {
        showPopup = false;
        var property = typeof(HeaderMenu).GetProperty(fieldName);
        if (property == null) return;

        var currentValue = property.GetValue(item);
        if (currentValue?.ToString() == newValue?.ToString()) return;

        if (property.PropertyType == typeof(int) && int.TryParse(newValue!.ToString(), out int intValue))
        {
            property.SetValue(item, intValue);
        }
        else if (property.PropertyType == typeof(string))
        {
            property.SetValue(item, newValue!.ToString());
        }

        var response = await HeaderMenuService.EditAsync(item);
        if (response.IsSuccessStatusCode)
        {
            await ToastService.ShowSuccessAsync("Update successful", "Success");
        }
        else
        {
            await ToastService.ShowErrorAsync("Error updating item", "Error");
        }

        StateHasChanged();
    }

    private void UpdatePagedItems()
    {
        pagedItems = allItems.Skip((CurrentPage - 1) * PageSize).Take(PageSize).ToList();
    }

    private void HandlePageChanged(int newPage)
    {
        CurrentPage = newPage;
        UpdatePagedItems();
    }

    private void HandlePageSizeChanged(int newSize)
    {
        showPopup = false;
        PageSize = newSize;
        CurrentPage = 1;
        UpdatePagedItems();

    }

    private async Task Refresh()
    {
        showPopup = false;
        await ToastService.ShowSuccessAsync("Menu translation completed!", "Success");
    }
}
