    // Console.WriteLine($"UserSubscriptionCountByPlan - {await DashboardService.UserSubscriptionCountByPlan()}");
    // Console.WriteLine($"TrendingUserSubscriptionsCount - {await DashboardService.TrendingUserSubscriptionsCount(20)}");
    // Console.WriteLine($"TrendingProductHistoryGetTop10 - {await DashboardService.TrendingProductHistoryGetTop10(20)}");
    // Console.WriteLine($"TotalViewsByWeekdays - {await DashboardService.TotalViewsByWeekdays()}");
    // Console.WriteLine($"TotaViewByRegister - {await DashboardService.TotaViewByRegister(50)}");
    // Console.WriteLine($"TotalCostByPlan - {await DashboardService.TotalCostByPlan()}");
    // Console.WriteLine($"TopUsersViewProducts - {await DashboardService.TopUsersViewProducts(20,10)}");
    // Console.WriteLine($"TopRateProducts - {await DashboardService.TopRateProducts(10)}");
    // Console.WriteLine($"ProductTotalView - {await DashboardService.ProductTotalView(3,20)}");
    // Console.WriteLine($"ProductViewCountEveryDay - {await DashboardService.ProductViewCountEveryDay(20)}");
    // Console.WriteLine($"PlatformsViewCount - {await DashboardService.PlatformsViewCount(60)}");
    // Console.WriteLine($"OSViewsCount - {await DashboardService.OSViewsCount(60)}");
    // Console.WriteLine($"LocationViewCount - {await DashboardService.LocationViewCount(120)}");
    // Console.WriteLine($"LastMonthTotalViewByRegister - {await DashboardService.LastMonthTotalViewByRegister(3)}");
    // Console.WriteLine($"IpAdressViewCount - {await DashboardService.IpAdressViewCount(120)}");
    // Console.WriteLine($"CategoryViewSumByDays - {await DashboardService.CategoryViewSumByDays(120)}");
    // Console.WriteLine($"BrowserViewsCount - {await DashboardService.BrowserViewsCount(120)}");
}