@page "/coupons"
@inject CouponService CouponService
@inject UserService UserService
@inject ToastrService ToastService
@inject IJSRuntime JSRuntime
@implements IDisposable

<PageTitle>@Loc["Coupon Management"]</PageTitle>

<div class="d-flex align-items-center justify-content-between mb-4">
    <div>
        <h3 class="mb-0">@Loc["Coupon Management"]</h3>
        <small class="text-muted">@Loc["Create discount codes, configure spending rules and usage limits, and manage vendor-scoped or platform-wide coupons."]</small>
    </div>
    <button class="btn btn-primary" @onclick="OpenCreateModal">
        <i class="fas fa-plus me-1"></i> @Loc["Add New Coupon"]
    </button>
</div>

<!-- Statistics Cards -->
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3">
        <div class="card shadow-sm border-0">
            <div class="card-body d-flex align-items-center">
                <div class="rounded-circle p-3 bg-primary bg-opacity-10 text-primary me-3">
                    <i class="fas fa-ticket-alt fa-2x"></i>
                </div>
                <div>
                    <h6 class="text-muted mb-1">@Loc["Total Coupons"]</h6>
                    <h3 class="mb-0">@allCoupons.Count</h3>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card shadow-sm border-0">
            <div class="card-body d-flex align-items-center">
                <div class="rounded-circle p-3 bg-success bg-opacity-10 text-success me-3">
                    <i class="fas fa-check-circle fa-2x"></i>
                </div>
                <div>
                    <h6 class="text-muted mb-1">@Loc["Active Coupons"]</h6>
                    <h3 class="mb-0">@allCoupons.Count(c => c.IsActive && !c.IsExpired && !c.IsExhausted)</h3>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card shadow-sm border-0">
            <div class="card-body d-flex align-items-center">
                <div class="rounded-circle p-3 bg-warning bg-opacity-10 text-warning me-3">
                    <i class="fas fa-history fa-2x"></i>
                </div>
                <div>
                    <h6 class="text-muted mb-1">@Loc["Total Redemptions"]</h6>
                    <h3 class="mb-0">@allCoupons.Sum(c => c.UsedCount)</h3>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card shadow-sm border-0">
            <div class="card-body d-flex align-items-center">
                <div class="rounded-circle p-3 bg-danger bg-opacity-10 text-danger me-3">
                    <i class="fas fa-calendar-times fa-2x"></i>
                </div>
                <div>
                    <h6 class="text-muted mb-1">@Loc["Expired / Inactive"]</h6>
                    <h3 class="mb-0">@allCoupons.Count(c => !c.IsActive || c.IsExpired)</h3>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Loading Spinner -->
<div class="text-center my-3">
    <LoadingSpinner IsLoading="isLoading" />
</div>

@if (!isLoading)
{
    @if (allCoupons.Count == 0)
    {
        <div class="card p-5 text-center shadow-sm">
            <i class="fas fa-ticket-alt fa-3x text-muted mb-3"></i>
            <h5>@Loc["No Coupons Found"]</h5>
            <p class="text-muted">@Loc["No coupons have been created yet."]</p>
            <div class="mt-2">
                <button class="btn btn-primary" @onclick="OpenCreateModal">
                    <i class="fas fa-plus me-1"></i> @Loc["Create First Coupon"]
                </button>
            </div>
        </div>
    }
    else
    {
        <!-- Filters Row -->
        <div class="row align-items-center mb-3 g-2">
            <div class="col-md-4">
                <div class="input-group">
                    <span class="input-group-text bg-white border-end-0">
                        <i class="fas fa-search text-muted"></i>
                    </span>
                    <input type="text" class="form-control border-start-0"
                           placeholder="@Loc["Search by coupon code or store name..."]"
                           @bind="searchTerm" @bind:event="oninput" @onkeyup="FilterCoupons" />
                    @if (!string.IsNullOrEmpty(searchTerm))
                    {
                        <button class="btn btn-outline-secondary" type="button" @onclick="ClearSearch">
                            <i class="fas fa-times"></i>
                        </button>
                    }
                </div>
            </div>

            <div class="col-md-3">
                <select class="form-select" @bind="statusFilter" @bind:after="FilterCoupons">
                    <option value="All">@Loc["All Statuses"]</option>
                    <option value="Active">@Loc["Active Only"]</option>
                    <option value="Inactive">@Loc["Inactive Only"]</option>
                    <option value="Expired">@Loc["Expired Only"]</option>
                </select>
            </div>

            <div class="col-md-2">
                <select class="form-select" @bind="discountTypeFilter" @bind:after="FilterCoupons">
                    <option value="All">@Loc["All Discount Types"]</option>
                    <option value="Percent">@Loc["Percentage Only"]</option>
                    <option value="Fixed">@Loc["Fixed Amount Only"]</option>
                </select>
            </div>

            <div class="col-md-3 text-md-end">
                <PageSelect PageSize="@PageSize" Count="@filteredCoupons.Count" OnPageSizeChanged="HandlePageSizeChanged" />
            </div>
        </div>

        <!-- Coupons Table -->
        <div class="table-responsive shadow-sm rounded bg-white">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width: 60px;">@Loc["ID"]</th>
                        <th>@Loc["Coupon Code"]</th>
                        <th>@Loc["Scope / Store"]</th>
                        <th>@Loc["Discount"]</th>
                        <th>@Loc["Minimum Spend"]</th>
                        <th>@Loc["Uses"]</th>
                        <th>@Loc["Valid To"]</th>
                        <th>@Loc["Status"]</th>
                        <th class="text-end" style="min-width: 170px;">@Loc["Actions"]</th>
                    </tr>
                </thead>
                <tbody>
                    @if (pagedCoupons.Count == 0)
                    {
                        <tr>
                            <td colspan="9" class="text-center py-4 text-muted">
                                @Loc["No coupons match your search criteria."]
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var coupon in pagedCoupons)
                        {
                            <tr>
                                <td><span class="badge bg-light text-dark">#@coupon.CouponId</span></td>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <span class="badge bg-primary bg-opacity-10 text-primary border border-primary px-2 py-1 fs-6 font-monospace">
                                            @coupon.Code
                                        </span>
                                    </div>
                                    <small class="text-muted">@Loc["Created Date"]: @coupon.CreatedAt.ToString("yyyy-MM-dd")</small>
                                </td>
                                <td>
                                    @if (coupon.IsGeneral)
                                    {
                                        <span class="badge bg-info text-white">
                                            <i class="fas fa-globe me-1"></i> @Loc["All Stores"]
                                        </span>
                                    }
                                    else
                                    {
                                        <div>
                                            <i class="fas fa-user-tag text-secondary me-1"></i>
                                            <span>@GetVendorDisplayName(coupon.Type)</span>
                                        </div>
                                        <small class="text-muted">@Loc["Vendor ID"]: @coupon.Type</small>
                                    }
                                </td>
                                <td>
                                    @if (string.Equals(coupon.DiscountType, "Percent", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <strong class="text-primary">@coupon.DiscountValue%</strong>
                                    }
                                    else
                                    {
                                        <strong class="text-success">@coupon.DiscountValue.ToString("C2")</strong>
                                    }
                                </td>
                                <td>
                                    @if (coupon.MinOrderTotal > 0)
                                    {
                                        <span>@coupon.MinOrderTotal.ToString("C2")</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <span>@coupon.UsedCount / @(coupon.MaxUses.HasValue ? coupon.MaxUses.Value.ToString() : "∞")</span>
                                    </div>
                                    @if (coupon.MaxUses.HasValue && coupon.MaxUses > 0)
                                    {
                                        var pct = Math.Min(100, (int)((double)coupon.UsedCount / coupon.MaxUses.Value * 100));
                                        <div class="progress mt-1" style="height: 4px; width: 80px;">
                                            <div class="progress-bar @(pct >= 100 ? "bg-danger" : "bg-primary")" role="progressbar" style="width: @pct%"></div>
                                        </div>
                                    }
                                </td>
                                <td>
                                    @if (coupon.ExpireDate.HasValue)
                                    {
                                        <div class="@(coupon.IsExpired ? "text-danger fw-bold" : "")">
                                            @coupon.ExpireDate.Value.ToString("yyyy-MM-dd HH:mm")
                                        </div>
                                        @if (coupon.IsExpired)
                                        {
                                            <small class="badge bg-danger">@Loc["Expired"]</small>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td>
                                    <span class="badge @coupon.StatusBadgeClass">
                                        @Loc[coupon.StatusText]
                                    </span>
                                </td>
                                <td class="text-end">
                                    <div class="btn-group btn-group-sm" role="group">
                                        <button class="btn @(coupon.IsActive ? "btn-outline-warning" : "btn-outline-success")"
                                                title="@(coupon.IsActive ? Loc["Inactive"] : Loc["Active"])"
                                                @onclick="() => ToggleActiveAsync(coupon)">
                                            <i class="fas @(coupon.IsActive ? "fa-pause" : "fa-play")"></i>
                                        </button>
                                        <button class="btn btn-outline-primary" title="@Loc["Edit Coupon"]"
                                                @onclick="() => OpenEditModal(coupon)">
                                            <i class="fas fa-pen"></i>
                                        </button>
                                        <button class="btn btn-outline-danger" title="@Loc["Delete Coupon"]"
                                                @onclick="() => DeleteCouponAsync(coupon)">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        <!-- Pagination Component -->
        <div class="mt-3">
            <MPagination TItem="CouponItem"
                         Items="filteredCoupons"
                         CurrentPage="@CurrentPage"
                         PageSize="@PageSize"
                         OnPageChanged="HandlePageChanged" />
        </div>
    }
}

<!-- Create Coupon Popup -->
<Popup IsVisible="showCreatePopup" Title="@Loc["Create New Coupon"]" OnSave="CreateCouponAsync" FormModel="@newCoupon">
    <div class="mb-3">
        <label for="createCode" class="form-label">@Loc["Coupon Code"] <span class="text-danger">*</span></label>
        <input type="text" class="form-control font-monospace text-uppercase" id="createCode"
               placeholder="e.g. SUMMER25, SAVE50"
               @bind="newCoupon.Code" />
        <ValidationMessage For="@(() => newCoupon.Code)" />
    </div>

    <div class="row g-2 mb-3">
        <div class="col-md-6">
            <label for="createDiscountType" class="form-label">@Loc["Discount Type"] <span class="text-danger">*</span></label>
            <select class="form-select" id="createDiscountType" @bind="newCoupon.DiscountType">
                <option value="Percent">@Loc["Percentage (%)"]</option>
                <option value="Fixed">@Loc["Fixed Amount ($)"]</option>
            </select>
        </div>
        <div class="col-md-6">
            <label for="createDiscountValue" class="form-label">
                @Loc["Discount Amount"] @(newCoupon.DiscountType == "Percent" ? "(%)" : "($)") <span class="text-danger">*</span>
            </label>
            <input type="number" step="0.01" class="form-control" id="createDiscountValue"
                   @bind="newCoupon.DiscountValue" />
            <ValidationMessage For="@(() => newCoupon.DiscountValue)" />
        </div>
    </div>

    <div class="mb-3">
        <label class="form-label">@Loc["Scope"] <span class="text-danger">*</span></label>
        <div class="d-flex gap-3 mb-2">
            <div class="form-check">
                <input class="form-check-input" type="radio" name="scopeRadio" id="scopeAll"
                       checked="@(selectedScope == "All")"
                       @onchange="@(() => OnScopeChanged("All"))" />
                <label class="form-check-label" for="scopeAll">@Loc["All Stores"]</label>
            </div>
            <div class="form-check">
                <input class="form-check-input" type="radio" name="scopeRadio" id="scopeVendor"
                       checked="@(selectedScope == "Vendor")"
                       @onchange="@(() => OnScopeChanged("Vendor"))" />
                <label class="form-check-label" for="scopeVendor">@Loc["Store Specific"]</label>
            </div>
        </div>

        @if (selectedScope == "Vendor")
        {
            <select class="form-select mt-2" @bind="newCoupon.SelectedVendorId">
                <option value="">-- @Loc["Select"] @Loc["Vendor"] --</option>
                @foreach (var supplier in suppliersList)
                {
                    <option value="@supplier.UserID">@supplier.DisplayName (@supplier.UserName)</option>
                }
            </select>
        }
    </div>

    <div class="row g-2 mb-3">
        <div class="col-md-6">
            <label for="createMinOrder" class="form-label">@Loc["Minimum Spend"]</label>
            <input type="number" step="0.01" class="form-control" id="createMinOrder"
                   placeholder="0"
                   @bind="newCoupon.MinOrderTotal" />
            <ValidationMessage For="@(() => newCoupon.MinOrderTotal)" />
        </div>
        <div class="col-md-6">
            <label for="createMaxUses" class="form-label">@Loc["Max Uses"]</label>
            <input type="number" class="form-control" id="createMaxUses"
                   placeholder="∞"
                   @bind="newCoupon.MaxUses" />
        </div>
    </div>

    <div class="mb-3">
        <label for="createExpireDate" class="form-label">@Loc["Valid To"]</label>
        <input type="datetime-local" class="form-control" id="createExpireDate"
               @bind="newCoupon.ExpireDate" />
    </div>
</Popup>

<!-- Edit Coupon Popup -->
<Popup IsVisible="showEditPopup" Title="@Loc["Edit Coupon"]" OnSave="SaveEditCouponAsync" FormModel="@editCoupon">
    <div class="mb-3">
        <label for="editCode" class="form-label">@Loc["Coupon Code"] <span class="text-danger">*</span></label>
        <input type="text" class="form-control font-monospace text-uppercase" id="editCode"
               @bind="editCoupon.Code" />
        <ValidationMessage For="@(() => editCoupon.Code)" />
    </div>

    <div class="row g-2 mb-3">
        <div class="col-md-6">
            <label for="editDiscountType" class="form-label">@Loc["Discount Type"] <span class="text-danger">*</span></label>
            <select class="form-select" id="editDiscountType" @bind="editCoupon.DiscountType">
                <option value="Percent">@Loc["Percentage (%)"]</option>
                <option value="Fixed">@Loc["Fixed Amount ($)"]</option>
            </select>
        </div>
        <div class="col-md-6">
            <label for="editDiscountValue" class="form-label">
                @Loc["Discount Amount"] @(editCoupon.DiscountType == "Percent" ? "(%)" : "($)") <span class="text-danger">*</span>
            </label>
            <input type="number" step="0.01" class="form-control" id="editDiscountValue"
                   @bind="editCoupon.DiscountValue" />
            <ValidationMessage For="@(() => editCoupon.DiscountValue)" />
        </div>
    </div>

    <div class="row g-2 mb-3">
        <div class="col-md-6">
            <label for="editMinOrder" class="form-label">@Loc["Minimum Spend"]</label>
            <input type="number" step="0.01" class="form-control" id="editMinOrder"
                   @bind="editCoupon.MinOrderTotal" />
        </div>
        <div class="col-md-6">
            <label for="editMaxUses" class="form-label">@Loc["Max Uses"]</label>
            <input type="number" class="form-control" id="editMaxUses"
                   @bind="editCoupon.MaxUses" />
        </div>
    </div>

    <div class="mb-3">
        <label for="editExpireDate" class="form-label">@Loc["Valid To"]</label>
        <input type="datetime-local" class="form-control" id="editExpireDate"
               @bind="editCoupon.ExpireDate" />
    </div>

    <div class="form-check form-switch mb-3">
        <input class="form-check-input" type="checkbox" id="editIsActive" @bind="editCoupon.IsActive" />
        <label class="form-check-label" for="editIsActive">@Loc["Active"]</label>
    </div>
</Popup>

@code {
    private List<CouponItem> allCoupons = new();
    private List<CouponItem> filteredCoupons = new();
    private List<CouponItem> pagedCoupons = new();
    private List<Person> suppliersList = new();

    private bool isLoading = true;
    private string searchTerm = "";
    private string statusFilter = "All";
    private string discountTypeFilter = "All";
    private int CurrentPage = 1;
    private int PageSize = 10;

    // Create modal state
    private bool showCreatePopup = false;
    private CreateCouponModel newCoupon = new();
    private string selectedScope = "All";

    // Edit modal state
    private bool showEditPopup = false;
    private EditCouponModel editCoupon = new();

    protected override async Task OnInitializedAsync()
    {
        Loc.OnLanguageChanged += HandleLanguageChanged;
        await LoadSuppliersAsync();
        await LoadCouponsAsync();
    }

    private void HandleLanguageChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Loc.OnLanguageChanged -= HandleLanguageChanged;
    }

    private async Task LoadSuppliersAsync()
    {
        try
        {
            var response = await UserService.GetListByTypeAsync(2, pageNumber: 1, sizePerPage: 100);
            if (response != null && response.Success && response.Data != null)
            {
                suppliersList = response.Data;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[LoadSuppliersAsync] Error: {ex.Message}");
        }
    }

    private string GetVendorDisplayName(string type)
    {
        if (long.TryParse(type, out long vendorId))
        {
            var supplier = suppliersList.FirstOrDefault(s => s.UserID == vendorId);
            if (supplier != null && !string.IsNullOrWhiteSpace(supplier.DisplayName))
            {
                return supplier.DisplayName;
            }
            return $"{Loc["Vendor"]} #{vendorId}";
        }
        return type;
    }

    private async Task LoadCouponsAsync()
    {
        isLoading = true;
        try
        {
            var response = await CouponService.GetAllCouponsAsync();
            if (response.Success && response.Data != null)
            {
                allCoupons = response.Data;
                FilterCoupons();
            }
            else
            {
                await ToastService.ShowErrorAsync(response.ResponseEngMsg ?? Loc["No data available"]);
                allCoupons = new();
                filteredCoupons = new();
                pagedCoupons = new();
            }
        }
        catch (Exception ex)
        {
            await ToastService.ShowErrorAsync($"{Loc["Error"]}: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private void FilterCoupons()
    {
        IEnumerable<CouponItem> query = allCoupons;

        if (!string.IsNullOrWhiteSpace(searchTerm))
        {
            var term = searchTerm.Trim().ToLowerInvariant();
            query = query.Where(c =>
                (!string.IsNullOrEmpty(c.Code) && c.Code.ToLowerInvariant().Contains(term)) ||
                (!string.IsNullOrEmpty(c.Type) && c.Type.ToLowerInvariant().Contains(term)) ||
                GetVendorDisplayName(c.Type).ToLowerInvariant().Contains(term)
            );
        }

        if (statusFilter == "Active")
        {
            query = query.Where(c => c.IsActive && !c.IsExpired && !c.IsExhausted);
        }
        else if (statusFilter == "Inactive")
        {
            query = query.Where(c => !c.IsActive);
        }
        else if (statusFilter == "Expired")
        {
            query = query.Where(c => c.IsExpired);
        }

        if (discountTypeFilter != "All")
        {
            query = query.Where(c => string.Equals(c.DiscountType, discountTypeFilter, StringComparison.OrdinalIgnoreCase));
        }

        filteredCoupons = query.ToList();
        CurrentPage = 1;
        UpdatePagedCoupons();
    }

    private void UpdatePagedCoupons()
    {
        pagedCoupons = filteredCoupons
            .Skip((CurrentPage - 1) * PageSize)
            .Take(PageSize)
            .ToList();
    }

    private void HandlePageChanged(int newPage)
    {
        CurrentPage = newPage;
        UpdatePagedCoupons();
    }

    private void HandlePageSizeChanged(int newSize)
    {
        PageSize = newSize;
        CurrentPage = 1;
        UpdatePagedCoupons();
    }

    private void ClearSearch()
    {
        searchTerm = "";
        FilterCoupons();
    }

    // --- Create Coupon ---
    private void OpenCreateModal()
    {
        newCoupon = new CreateCouponModel();
        selectedScope = "All";
        showCreatePopup = true;
    }

    private void OnScopeChanged(string scope)
    {
        selectedScope = scope;
        if (scope == "All")
        {
            newCoupon.Type = "All";
            newCoupon.SelectedVendorId = null;
        }
    }

    private async Task CreateCouponAsync()
    {
        if (string.IsNullOrWhiteSpace(newCoupon.Code))
        {
            await ToastService.ShowWarningAsync(Loc["Required"]);
            return;
        }

        if (newCoupon.DiscountValue <= 0)
        {
            await ToastService.ShowWarningAsync(Loc["Required"]);
            return;
        }

        if (string.Equals(newCoupon.DiscountType, "Percent", StringComparison.OrdinalIgnoreCase) && newCoupon.DiscountValue > 100)
        {
            await ToastService.ShowWarningAsync(Loc["Error"]);
            return;
        }

        if (selectedScope == "Vendor" && !newCoupon.SelectedVendorId.HasValue)
        {
            await ToastService.ShowWarningAsync(Loc["Required"]);
            return;
        }

        var response = await CouponService.CreateCouponAsync(newCoupon);
        if (response.Success)
        {
            await ToastService.ShowSuccessAsync(Loc["Coupon created successfully"]);
            showCreatePopup = false;
            await LoadCouponsAsync();
        }
        else
        {
            await ToastService.ShowErrorAsync(response.ResponseEngMsg ?? Loc["Error"]);
        }
    }

    // --- Edit Coupon ---
    private void OpenEditModal(CouponItem coupon)
    {
        editCoupon = new EditCouponModel
        {
            CouponId = coupon.CouponId,
            Code = coupon.Code,
            DiscountType = coupon.DiscountType,
            DiscountValue = coupon.DiscountValue,
            MinOrderTotal = coupon.MinOrderTotal,
            MaxUses = coupon.MaxUses,
            ExpireDate = coupon.ExpireDate,
            IsActive = coupon.IsActive
        };
        showEditPopup = true;
    }

    private async Task SaveEditCouponAsync()
    {
        if (string.IsNullOrWhiteSpace(editCoupon.Code))
        {
            await ToastService.ShowWarningAsync(Loc["Required"]);
            return;
        }

        if (editCoupon.DiscountValue <= 0)
        {
            await ToastService.ShowWarningAsync(Loc["Required"]);
            return;
        }

        if (string.Equals(editCoupon.DiscountType, "Percent", StringComparison.OrdinalIgnoreCase) && editCoupon.DiscountValue > 100)
        {
            await ToastService.ShowWarningAsync(Loc["Error"]);
            return;
        }

        var response = await CouponService.EditCouponAsync(editCoupon);
        if (response.Success)
        {
            await ToastService.ShowSuccessAsync(Loc["Coupon status updated"]);
            showEditPopup = false;
            await LoadCouponsAsync();
        }
        else
        {
            await ToastService.ShowErrorAsync(response.ResponseEngMsg ?? Loc["Error"]);
        }
    }

    // --- Toggle Active ---
    private async Task ToggleActiveAsync(CouponItem coupon)
    {
        var editModel = new EditCouponModel
        {
            CouponId = coupon.CouponId,
            Code = coupon.Code,
            DiscountType = coupon.DiscountType,
            DiscountValue = coupon.DiscountValue,
            MinOrderTotal = coupon.MinOrderTotal,
            MaxUses = coupon.MaxUses,
            ExpireDate = coupon.ExpireDate,
            IsActive = !coupon.IsActive
        };

        var response = await CouponService.EditCouponAsync(editModel);
        if (response.Success)
        {
            coupon.IsActive = !coupon.IsActive;
            await ToastService.ShowSuccessAsync(Loc["Coupon status updated"]);
            StateHasChanged();
        }
        else
        {
            await ToastService.ShowErrorAsync(response.ResponseEngMsg ?? Loc["Error"]);
        }
    }

    // --- Delete Coupon ---
    private async Task DeleteCouponAsync(CouponItem coupon)
    {
        bool confirmed = await JSRuntime.InvokeAsync<bool>("confirm", $"{Loc["Are you sure you want to delete coupon"]} '{coupon.Code}'? {Loc["This action cannot be undone."]}");
        if (!confirmed) return;

        var response = await CouponService.DeleteCouponAsync(coupon.CouponId);
        if (response.Success)
        {
            await ToastService.ShowSuccessAsync(Loc["Coupon deleted successfully"]);
            allCoupons.RemoveAll(c => c.CouponId == coupon.CouponId);
            FilterCoupons();
        }
        else
        {
            await ToastService.ShowErrorAsync(response.ResponseEngMsg ?? Loc["Error"]);
        }
    }
}
