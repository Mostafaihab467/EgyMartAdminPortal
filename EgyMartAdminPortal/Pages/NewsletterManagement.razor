@page "/newsletter"
@using EgyMartAdminPortal.Models.Newsletter
@inject NewsletterService NewsletterService
@inject LocalizationService Loc
@inject ToastrService Toastr
@implements IDisposable

<div class="newsletter-page container-fluid py-4" dir="@(Loc.IsRtl ? "rtl" : "ltr")">

    <!-- Header & SignalR Status -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <div>
            <h2 class="fw-bold mb-1 d-flex align-items-center gap-2">
                <i class="fas fa-paper-plane text-primary"></i>
                @Loc["Newsletter & Notifications"]
            </h2>
            <p class="text-muted mb-0">
                @(Loc.IsRtl ? "إرسال إشعارات عامة للعملاء والموردين وإدارة النشرة البريدية ومراقبة الاتصال المباشر SignalR." : "Broadcast notifications to clients and vendors, manage subscribers, and monitor live SignalR events.")
            </p>
        </div>
        <div class="d-flex align-items-center gap-2">
            <span class="badge @(NewsletterService.IsConnected ? "bg-success" : "bg-danger") px-3 py-2 fs-6 rounded-pill d-flex align-items-center gap-2 shadow-sm">
                <span class="spinner-grow spinner-grow-sm @(NewsletterService.IsConnected ? "" : "d-none")" role="status"></span>
                <i class="fas @(NewsletterService.IsConnected ? "fa-wifi" : "fa-plane-slash")"></i>
                SignalR: @(NewsletterService.IsConnected ? Loc["Connected"] : Loc["Disconnected"])
            </span>
            <button class="btn btn-outline-primary btn-sm rounded-pill px-3" @onclick="RefreshAllData">
                <i class="fas fa-sync-alt @(isLoadingStats ? "fa-spin" : "")"></i>
            </button>
        </div>
    </div>

    <!-- Metric Cards -->
    <div class="row g-3 mb-4">
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card shadow-sm border-0 border-start border-primary border-4 rounded-3 h-100">
                <div class="card-body d-flex align-items-center justify-content-between p-3">
                    <div>
                        <div class="text-muted small fw-semibold">@Loc["Total Subscribers"]</div>
                        <div class="fs-3 fw-bold text-dark mt-1">@(stats?.TotalSubscribers ?? 0)</div>
                        <div class="small text-success mt-1">
                            <i class="fas fa-check-circle me-1"></i>@(stats?.ActiveSubscribers ?? 0) @Loc["Active Subscribers"]
                        </div>
                    </div>
                    <div class="bg-primary bg-opacity-10 text-primary p-3 rounded-circle">
                        <i class="fas fa-users fs-4"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card shadow-sm border-0 border-start border-info border-4 rounded-3 h-100">
                <div class="card-body d-flex align-items-center justify-content-between p-3">
                    <div>
                        <div class="text-muted small fw-semibold">@Loc["Total Broadcasts"]</div>
                        <div class="fs-3 fw-bold text-dark mt-1">@(stats?.TotalBroadcasts ?? 0)</div>
                        <div class="small text-muted mt-1">
                            @(Loc.IsRtl ? "تم إرسالها عبر النظام" : "Sent via system")
                        </div>
                    </div>
                    <div class="bg-info bg-opacity-10 text-info p-3 rounded-circle">
                        <i class="fas fa-bullhorn fs-4"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card shadow-sm border-0 border-start border-success border-4 rounded-3 h-100">
                <div class="card-body d-flex align-items-center justify-content-between p-3">
                    <div>
                        <div class="text-muted small fw-semibold">@Loc["Clients"]</div>
                        <div class="fs-3 fw-bold text-dark mt-1">@(stats?.TotalClients ?? 0)</div>
                        <div class="small text-muted mt-1">
                            @(Loc.IsRtl ? "عملاء مسجلين نشطين" : "Active registered clients")
                        </div>
                    </div>
                    <div class="bg-success bg-opacity-10 text-success p-3 rounded-circle">
                        <i class="fas fa-user-check fs-4"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card shadow-sm border-0 border-start border-warning border-4 rounded-3 h-100">
                <div class="card-body d-flex align-items-center justify-content-between p-3">
                    <div>
                        <div class="text-muted small fw-semibold">@Loc["Vendors"]</div>
                        <div class="fs-3 fw-bold text-dark mt-1">@(stats?.TotalVendors ?? 0)</div>
                        <div class="small text-muted mt-1">
                            @(Loc.IsRtl ? "موردين وتجار نشطين" : "Active suppliers/vendors")
                        </div>
                    </div>
                    <div class="bg-warning bg-opacity-10 text-warning p-3 rounded-circle">
                        <i class="fas fa-store fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Navigation Tabs -->
    <ul class="nav nav-pills mb-4 gap-2 bg-white p-2 rounded-3 shadow-sm" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link rounded-pill @(activeTab == "broadcast" ? "active" : "")" @onclick='() => SetTab("broadcast")'>
                <i class="fas fa-paper-plane me-1"></i> @Loc["Send Broadcast"]
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link rounded-pill @(activeTab == "subscribers" ? "active" : "")" @onclick='() => SetTab("subscribers")'>
                <i class="fas fa-address-book me-1"></i> @Loc["Subscribers"]
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link rounded-pill @(activeTab == "history" ? "active" : "")" @onclick='() => SetTab("history")'>
                <i class="fas fa-history me-1"></i> @Loc["Broadcast History"]
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link rounded-pill @(activeTab == "signalr" ? "active" : "")" @onclick='() => SetTab("signalr")'>
                <i class="fas fa-satellite-dish me-1"></i> @Loc["SignalR Monitor"]
                @if (liveNotifications.Count > 0)
                {
                    <span class="badge bg-danger rounded-pill ms-1">@liveNotifications.Count</span>
                }
            </button>
        </li>
    </ul>

    <!-- Tab 1: Send Broadcast Form -->
    @if (activeTab == "broadcast")
    {
        <div class="card shadow-sm border-0 rounded-4">
            <div class="card-header bg-white py-3 border-bottom">
                <h5 class="fw-bold mb-0 text-primary">
                    <i class="fas fa-bullhorn me-2"></i>@Loc["Broadcast Notification"]
                </h5>
            </div>
            <div class="card-body p-4">
                <div class="row g-4">
                    <div class="col-lg-8">
                        <EditForm Model="broadcastModel" OnValidSubmit="HandleSendBroadcast">
                            <div class="mb-3">
                                <label class="form-label fw-semibold">@Loc["Target Audience"] <span class="text-danger">*</span></label>
                                <select class="form-select" @bind="broadcastModel.TargetAudience">
                                    <option value="All">@Loc["All"]</option>
                                    <option value="Clients">@Loc["Clients"]</option>
                                    <option value="Vendors">@Loc["Vendors"]</option>
                                    <option value="Subscribers">@Loc["Subscribers"]</option>
                                </select>
                                <small class="text-muted">
                                    @(Loc.IsRtl ? "حدد الفئة المستهدفة لاستلام الإشعار المباشر والبريد." : "Choose the target group to receive the live notification.")
                                </small>
                            </div>

                            <div class="mb-3">
                                <label class="form-label fw-semibold">@Loc["Notification Title"] <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" @bind="broadcastModel.Title" placeholder="@(Loc.IsRtl ? "أدخل عنوان الإشعار..." : "Enter notification title...")" required />
                            </div>

                            <div class="mb-3">
                                <label class="form-label fw-semibold">@Loc["Notification Message"] <span class="text-danger">*</span></label>
                                <textarea class="form-control" rows="5" @bind="broadcastModel.Message" placeholder="@(Loc.IsRtl ? "اكتب محتوى الإشعار أو النشرة البريدية هنا..." : "Write notification or newsletter content here...")" required></textarea>
                            </div>

                            <div class="mb-4">
                                <label class="form-label fw-semibold">@Loc["Attachment (Image, PDF, File)"]</label>
                                <div class="border border-2 border-dashed rounded-3 p-3 text-center bg-light">
                                    <InputFile OnChange="HandleFileSelected" class="form-control" id="attachmentInput" />
                                    @if (selectedFile != null)
                                    {
                                        <div class="mt-3 p-2 bg-white rounded-3 border d-flex align-items-center justify-content-between">
                                            <div class="d-flex align-items-center gap-2">
                                                <i class="fas @GetFileIcon(selectedFile.Name) text-primary fs-4"></i>
                                                <div class="text-start">
                                                    <div class="fw-semibold small">@selectedFile.Name</div>
                                                    <div class="text-muted small">@FormatFileSize(selectedFile.Size)</div>
                                                </div>
                                            </div>
                                            <button type="button" class="btn btn-outline-danger btn-sm rounded-circle" @onclick="RemoveSelectedFile">
                                                <i class="fas fa-times"></i>
                                            </button>
                                        </div>
                                    }
                                    <small class="text-muted d-block mt-2">
                                        @(Loc.IsRtl ? "يدعم الصور (PNG, JPG)، ملفات PDF، المستندات، وأي نوع ملف حتى 30 ميجابايت." : "Supports Images (PNG, JPG), PDF files, documents, and any file up to 30MB.")
                                    </small>
                                </div>
                            </div>

                            <div class="d-flex justify-content-end gap-2">
                                <button type="button" class="btn btn-light px-4 rounded-pill" @onclick="ResetBroadcastForm">
                                    @(Loc.IsRtl ? "إعادة تعيين" : "Reset")
                                </button>
                                <button type="submit" class="btn btn-primary px-5 rounded-pill shadow-sm" disabled="@isSendingBroadcast">
                                    @if (isSendingBroadcast)
                                    {
                                        <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                                        @(Loc.IsRtl ? "جاري الإرسال..." : "Sending...")
                                    }
                                    else
                                    {
                                        <i class="fas fa-paper-plane me-2"></i>
                                        @Loc["Send Notification"]
                                    }
                                </button>
                            </div>
                        </EditForm>
                    </div>

                    <div class="col-lg-4">
                        <div class="card bg-light border-0 rounded-3 p-3 h-100">
                            <h6 class="fw-bold text-dark mb-3">
                                <i class="fas fa-eye me-2 text-primary"></i>@(Loc.IsRtl ? "معاينة الإشعار الفوري" : "Live Preview")
                            </h6>
                            <div class="card border shadow-sm rounded-3 bg-white p-3">
                                <div class="d-flex align-items-center justify-content-between mb-2">
                                    <span class="badge bg-primary rounded-pill">@(string.IsNullOrWhiteSpace(broadcastModel.TargetAudience) ? "All" : broadcastModel.TargetAudience)</span>
                                    <span class="text-muted small">@(Loc.IsRtl ? "الآن" : "Just now")</span>
                                </div>
                                <h6 class="fw-bold mb-2">@(string.IsNullOrWhiteSpace(broadcastModel.Title) ? (Loc.IsRtl ? "عنوان الإشعار يظهر هنا" : "Notification Title Preview") : broadcastModel.Title)</h6>
                                <p class="text-muted small mb-3">@(string.IsNullOrWhiteSpace(broadcastModel.Message) ? (Loc.IsRtl ? "محتوى الرسالة سيظهر هنا بشكل منظم للمستلمين..." : "Message content preview will be rendered here for recipients...") : broadcastModel.Message)</p>
                                @if (selectedFile != null)
                                {
                                    <div class="p-2 bg-light rounded-3 d-flex align-items-center gap-2 border">
                                        <i class="fas @GetFileIcon(selectedFile.Name) text-danger"></i>
                                        <span class="small fw-semibold text-truncate">@selectedFile.Name</span>
                                    </div>
                                }
                            </div>
                            <div class="alert alert-info mt-3 small mb-0">
                                <i class="fas fa-info-circle me-1"></i>
                                @(Loc.IsRtl ? "يتم بث هذا الإشعار لحظياً عبر خادم SignalR لجميع الأجهزة والمتصفحات المتصلة فور الضغط على إرسال." : "This notification will be broadcasted in real-time over SignalR to all connected users immediately.")
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- Tab 2: Subscribers Management -->
    @if (activeTab == "subscribers")
    {
        <div class="card shadow-sm border-0 rounded-4">
            <div class="card-header bg-white py-3 border-bottom d-flex flex-wrap justify-content-between align-items-center gap-3">
                <h5 class="fw-bold mb-0 text-primary">
                    <i class="fas fa-address-book me-2"></i>@Loc["Subscribers"]
                </h5>
                <button class="btn btn-primary btn-sm rounded-pill px-3 shadow-sm" @onclick="() => showAddSubscriberModal = true">
                    <i class="fas fa-plus me-1"></i>@Loc["Add Subscriber"]
                </button>
            </div>
            <div class="card-body p-4">
                <!-- Filters Row -->
                <div class="row g-2 mb-3">
                    <div class="col-md-5">
                        <div class="input-group">
                            <span class="input-group-text bg-white border-end-0">
                                <i class="fas fa-search text-muted"></i>
                            </span>
                            <input type="text" class="form-control border-start-0" placeholder="@(Loc.IsRtl ? "بحث بالبريد الإلكتروني..." : "Search by email...")" @bind="subscribersSearch" @bind:event="oninput" @onkeyup="HandleSubscribersSearch" />
                        </div>
                    </div>
                    <div class="col-md-3">
                        <select class="form-select" @bind="subscribersStatusFilter" @bind:after="LoadSubscribers">
                            <option value="">@Loc["All"] (الحالة)</option>
                            <option value="true">@Loc["Active Subscribers"]</option>
                            <option value="false">@Loc["Unsubscribed"]</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <select class="form-select" @bind="subscribersTypeFilter" @bind:after="LoadSubscribers">
                            <option value="">@Loc["All"] (النوع)</option>
                            <option value="Customer">@Loc["Clients"]</option>
                            <option value="Supplier">@Loc["Vendors"]</option>
                            <option value="Visitor">@(Loc.IsRtl ? "زائر" : "Visitor")</option>
                        </select>
                    </div>
                    <div class="col-md-1">
                        <button class="btn btn-outline-secondary w-100" @onclick="ResetSubscribersFilters">
                            <i class="fas fa-undo"></i>
                        </button>
                    </div>
                </div>

                <!-- Subscribers Table -->
                @if (isLoadingSubscribers)
                {
                    <div class="text-center py-5">
                        <div class="spinner-border text-primary" role="status"></div>
                        <p class="text-muted mt-2">@(Loc.IsRtl ? "جاري تحميل المشتركين..." : "Loading subscribers...")</p>
                    </div>
                }
                else if (subscribersList.Count == 0)
                {
                    <div class="text-center py-5 text-muted">
                        <i class="fas fa-envelope-open text-muted fs-1 mb-3"></i>
                        <p>@(Loc.IsRtl ? "لا يوجد مشتركون مطابقون للبحث." : "No subscribers match your search criteria.")</p>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th>#</th>
                                    <th>@Loc["Email Address"]</th>
                                    <th>@Loc["User Type"]</th>
                                    <th>@(Loc.IsRtl ? "الحالة" : "Status")</th>
                                    <th>@Loc["Subscribed At"]</th>
                                    <th>@Loc["Unsubscribed At"]</th>
                                    <th class="text-center">@(Loc.IsRtl ? "الإجراءات" : "Actions")</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var sub in subscribersList)
                                {
                                    <tr>
                                        <td class="text-muted small">@sub.SubscribeID</td>
                                        <td class="fw-semibold">@sub.EMailAddress</td>
                                        <td>
                                            <span class="badge bg-secondary rounded-pill">@sub.UserType</span>
                                        </td>
                                        <td>
                                            @if (sub.IsActive)
                                            {
                                                <span class="badge bg-success rounded-pill">
                                                    <i class="fas fa-check-circle me-1"></i>@(Loc.IsRtl ? "نشط" : "Active")
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-danger rounded-pill">
                                                    <i class="fas fa-ban me-1"></i>@Loc["Unsubscribed"]
                                                </span>
                                            }
                                        </td>
                                        <td class="small text-muted">@sub.AddDate.ToString("yyyy-MM-dd HH:mm")</td>
                                        <td class="small text-muted">@(sub.UnsubscribedAt.HasValue ? sub.UnsubscribedAt.Value.ToString("yyyy-MM-dd HH:mm") : "-")</td>
                                        <td class="text-center">
                                            <div class="btn-group btn-group-sm">
                                                @if (sub.IsActive)
                                                {
                                                    <button class="btn btn-outline-warning btn-sm" title="@Loc["Unsubscribe"]" @onclick="() => ToggleSubscription(sub)">
                                                        <i class="fas fa-user-slash"></i>
                                                    </button>
                                                }
                                                else
                                                {
                                                    <button class="btn btn-outline-success btn-sm" title="@Loc["Reactivate"]" @onclick="() => ToggleSubscription(sub)">
                                                        <i class="fas fa-user-check"></i>
                                                    </button>
                                                }
                                                <button class="btn btn-outline-danger btn-sm" title="@Loc["Delete Subscriber"]" @onclick="() => DeleteSubscriber(sub)">
                                                    <i class="fas fa-trash-alt"></i>
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <!-- Pagination -->
                    <div class="d-flex justify-content-between align-items-center mt-3 flex-wrap gap-2">
                        <div class="text-muted small">
                            @(Loc.IsRtl ? $"إجمالي المشتركين: {subscribersTotalCount}" : $"Total subscribers: {subscribersTotalCount}")
                        </div>
                        <div class="btn-group">
                            <button class="btn btn-outline-secondary btn-sm" disabled="@(subscribersPage <= 1)" @onclick="() => ChangeSubscribersPage(subscribersPage - 1)">
                                <i class="fas @(Loc.IsRtl ? "fa-chevron-right" : "fa-chevron-left")"></i>
                            </button>
                            <span class="btn btn-sm btn-light disabled">@(subscribersPage)</span>
                            <button class="btn btn-outline-secondary btn-sm" disabled="@(subscribersPage * subscribersPageSize >= subscribersTotalCount)" @onclick="() => ChangeSubscribersPage(subscribersPage + 1)">
                                <i class="fas @(Loc.IsRtl ? "fa-chevron-left" : "fa-chevron-right")"></i>
                            </button>
                        </div>
                    </div>
                }
            </div>
        </div>
    }

    <!-- Tab 3: Broadcast History -->
    @if (activeTab == "history")
    {
        <div class="card shadow-sm border-0 rounded-4">
            <div class="card-header bg-white py-3 border-bottom">
                <h5 class="fw-bold mb-0 text-primary">
                    <i class="fas fa-history me-2"></i>@Loc["Broadcast History"]
                </h5>
            </div>
            <div class="card-body p-4">
                @if (isLoadingBroadcasts)
                {
                    <div class="text-center py-5">
                        <div class="spinner-border text-primary" role="status"></div>
                        <p class="text-muted mt-2">@(Loc.IsRtl ? "جاري تحميل سجل الإشعارات..." : "Loading broadcast history...")</p>
                    </div>
                }
                else if (broadcastsList.Count == 0)
                {
                    <div class="text-center py-5 text-muted">
                        <i class="fas fa-inbox fs-1 mb-3"></i>
                        <p>@(Loc.IsRtl ? "لم يتم إرسال أي إشعارات بعد." : "No broadcasts have been sent yet.")</p>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th>#</th>
                                    <th>@Loc["Notification Title"]</th>
                                    <th>@Loc["Target Audience"]</th>
                                    <th>@Loc["Notification Message"]</th>
                                    <th>@(Loc.IsRtl ? "المرفق" : "Attachment")</th>
                                    <th>@Loc["Recipients"]</th>
                                    <th>@Loc["Sent Date"]</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var b in broadcastsList)
                                {
                                    <tr>
                                        <td class="text-muted small">@b.NewsletterId</td>
                                        <td class="fw-bold">@b.Title</td>
                                        <td>
                                            <span class="badge @GetAudienceBadge(b.TargetAudience) rounded-pill">@b.TargetAudience</span>
                                        </td>
                                        <td class="small text-muted" style="max-width: 300px;">
                                            <div class="text-truncate">@b.Message</div>
                                        </td>
                                        <td>
                                            @if (!string.IsNullOrWhiteSpace(b.AttachmentUrl))
                                            {
                                                <a href="@b.AttachmentUrl" target="_blank" class="btn btn-outline-primary btn-sm rounded-pill d-inline-flex align-items-center gap-1">
                                                    <i class="fas @GetFileIcon(b.AttachmentOriginalName ?? b.AttachmentUrl)"></i>
                                                    <span>@Loc["Download / View"]</span>
                                                </a>
                                            }
                                            else
                                            {
                                                <span class="text-muted small">-</span>
                                            }
                                        </td>
                                        <td>
                                            <span class="badge bg-light text-dark border">
                                                <i class="fas fa-check-double text-success me-1"></i>@b.SentCount
                                            </span>
                                        </td>
                                        <td class="small text-muted">@b.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <!-- Pagination -->
                    <div class="d-flex justify-content-between align-items-center mt-3 flex-wrap gap-2">
                        <div class="text-muted small">
                            @(Loc.IsRtl ? $"إجمالي الإشعارات: {broadcastsTotalCount}" : $"Total broadcasts: {broadcastsTotalCount}")
                        </div>
                        <div class="btn-group">
                            <button class="btn btn-outline-secondary btn-sm" disabled="@(broadcastsPage <= 1)" @onclick="() => ChangeBroadcastsPage(broadcastsPage - 1)">
                                <i class="fas @(Loc.IsRtl ? "fa-chevron-right" : "fa-chevron-left")"></i>
                            </button>
                            <span class="btn btn-sm btn-light disabled">@(broadcastsPage)</span>
                            <button class="btn btn-outline-secondary btn-sm" disabled="@(broadcastsPage * broadcastsPageSize >= broadcastsTotalCount)" @onclick="() => ChangeBroadcastsPage(broadcastsPage + 1)">
                                <i class="fas @(Loc.IsRtl ? "fa-chevron-left" : "fa-chevron-right")"></i>
                            </button>
                        </div>
                    </div>
                }
            </div>
        </div>
    }

    <!-- Tab 4: Live SignalR Monitor -->
    @if (activeTab == "signalr")
    {
        <div class="card shadow-sm border-0 rounded-4">
            <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                <h5 class="fw-bold mb-0 text-primary">
                    <i class="fas fa-satellite-dish me-2"></i>@Loc["Live Notification Feed"]
                </h5>
                <button class="btn btn-outline-secondary btn-sm rounded-pill" @onclick="ClearLiveFeed">
                    @(Loc.IsRtl ? "مسح السجل" : "Clear Feed")
                </button>
            </div>
            <div class="card-body p-4">
                @if (liveNotifications.Count == 0)
                {
                    <div class="text-center py-5 text-muted">
                        <i class="fas fa-bell-slash fs-1 mb-3 text-muted"></i>
                        <p>@Loc["No Notifications Received Yet"]</p>
                        <small class="text-muted">
                            @(Loc.IsRtl ? "عند إرسال أي إشعار جديد في النظام، سيظهر هنا في الوقت الفعلي عبر اتصال SignalR المباشر." : "Whenever a new notification is sent in the system, it will pop up here in real time over SignalR.")
                        </small>
                    </div>
                }
                else
                {
                    <div class="d-flex flex-column gap-3">
                        @foreach (var notif in liveNotifications)
                        {
                            <div class="card border-0 shadow-sm rounded-3 bg-light p-3 border-start border-4 border-primary">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="badge bg-primary rounded-pill">@notif.TargetAudience</span>
                                        <h6 class="fw-bold mb-0 text-dark">@notif.Title</h6>
                                    </div>
                                    <small class="text-muted">@notif.SentAt.ToString("HH:mm:ss")</small>
                                </div>
                                <p class="text-muted small mb-2">@notif.Message</p>
                                @if (!string.IsNullOrWhiteSpace(notif.AttachmentUrl))
                                {
                                    <div>
                                        <a href="@notif.AttachmentUrl" target="_blank" class="btn btn-outline-primary btn-sm rounded-pill">
                                            <i class="fas @GetFileIcon(notif.AttachmentOriginalName ?? notif.AttachmentUrl) me-1"></i>
                                            @notif.AttachmentOriginalName
                                        </a>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    }

</div>

<!-- Modal: Add Manual Subscriber -->
@if (showAddSubscriberModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);" dir="@(Loc.IsRtl ? "rtl" : "ltr")">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content rounded-4 shadow-lg border-0">
                <div class="modal-header border-bottom">
                    <h5 class="modal-title fw-bold text-primary">
                        <i class="fas fa-user-plus me-2"></i>@Loc["Add Subscriber"]
                    </h5>
                    <button type="button" class="btn-close" @onclick="() => showAddSubscriberModal = false"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">@Loc["Email Address"] <span class="text-danger">*</span></label>
                        <input type="email" class="form-control" @bind="newSubscriberEmail" placeholder="example@mail.com" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">@Loc["User Type"]</label>
                        <select class="form-select" @bind="newSubscriberUserType">
                            <option value="Customer">@Loc["Clients"]</option>
                            <option value="Supplier">@Loc["Vendors"]</option>
                            <option value="Visitor">@(Loc.IsRtl ? "زائر" : "Visitor")</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer border-top">
                    <button type="button" class="btn btn-light rounded-pill px-4" @onclick="() => showAddSubscriberModal = false">
                        @(Loc.IsRtl ? "إلغاء" : "Cancel")
                    </button>
                    <button type="button" class="btn btn-primary rounded-pill px-4" @onclick="HandleAddSubscriber" disabled="@string.IsNullOrWhiteSpace(newSubscriberEmail)">
                        @(Loc.IsRtl ? "إضافة المشترك" : "Add Subscriber")
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private string activeTab = "broadcast";
    private NewsletterStats? stats;
    private bool isLoadingStats = false;

    // Broadcast Form
    private SendBroadcastModel broadcastModel = new() { TargetAudience = "All" };
    private IBrowserFile? selectedFile;
    private bool isSendingBroadcast = false;

    // Subscribers Table
    private List<NewsletterSubscriber> subscribersList = new();
    private bool isLoadingSubscribers = false;
    private int subscribersPage = 1;
    private int subscribersPageSize = 10;
    private int subscribersTotalCount = 0;
    private string? subscribersSearch;
    private string? subscribersStatusFilter;
    private string? subscribersTypeFilter;

    // Broadcast History
    private List<NewsletterBroadcast> broadcastsList = new();
    private bool isLoadingBroadcasts = false;
    private int broadcastsPage = 1;
    private int broadcastsPageSize = 10;
    private int broadcastsTotalCount = 0;

    // SignalR live feed
    private List<NotificationPayload> liveNotifications = new();

    // Add Subscriber Modal
    private bool showAddSubscriberModal = false;
    private string newSubscriberEmail = string.Empty;
    private string newSubscriberUserType = "Customer";

    protected override async Task OnInitializedAsync()
    {
        Loc.OnLanguageChanged += HandleLanguageChanged;
        NewsletterService.OnNotificationReceived += HandleSignalRNotification;
        NewsletterService.OnConnectionStatusChanged += HandleConnectionStatusChanged;

        await NewsletterService.StartSignalRAsync();
        await RefreshAllData();
    }

    private void HandleLanguageChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    private async void HandleSignalRNotification(NotificationPayload payload)
    {
        liveNotifications.Insert(0, payload);
        await Toastr.ShowSuccessAsync(Loc.IsRtl ? $"إشعار جديد: {payload.Title}" : $"New Notification: {payload.Title}");
        await InvokeAsync(StateHasChanged);
    }

    private void HandleConnectionStatusChanged(bool isConnected)
    {
        InvokeAsync(StateHasChanged);
    }

    private async Task RefreshAllData()
    {
        await LoadStats();
        if (activeTab == "subscribers") await LoadSubscribers();
        if (activeTab == "history") await LoadBroadcasts();
    }

    private async Task SetTab(string tab)
    {
        activeTab = tab;
        if (tab == "subscribers") await LoadSubscribers();
        if (tab == "history") await LoadBroadcasts();
    }

    private async Task LoadStats()
    {
        isLoadingStats = true;
        stats = await NewsletterService.GetStatsAsync();
        isLoadingStats = false;
        StateHasChanged();
    }

    private async Task LoadSubscribers()
    {
        isLoadingSubscribers = true;
        bool? isActive = null;
        if (!string.IsNullOrWhiteSpace(subscribersStatusFilter))
        {
            if (bool.TryParse(subscribersStatusFilter, out var b)) isActive = b;
        }

        var res = await NewsletterService.GetSubscribersAsync(
            subscribersPage,
            subscribersPageSize,
            subscribersSearch,
            isActive,
            string.IsNullOrWhiteSpace(subscribersTypeFilter) ? null : subscribersTypeFilter
        );

        if (res != null)
        {
            subscribersList = res.Data ?? new();
            subscribersTotalCount = res.TotalCount;
        }

        isLoadingSubscribers = false;
        StateHasChanged();
    }

    private async Task HandleSubscribersSearch()
    {
        subscribersPage = 1;
        await LoadSubscribers();
    }

    private async Task ResetSubscribersFilters()
    {
        subscribersSearch = null;
        subscribersStatusFilter = null;
        subscribersTypeFilter = null;
        subscribersPage = 1;
        await LoadSubscribers();
    }

    private async Task ChangeSubscribersPage(int newPage)
    {
        subscribersPage = newPage;
        await LoadSubscribers();
    }

    private async Task ToggleSubscription(NewsletterSubscriber sub)
    {
        if (sub.IsActive)
        {
            var res = await NewsletterService.UnsubscribeAsync(sub.EMailAddress);
            if (res.Success)
            {
                await Toastr.ShowSuccessAsync(Loc.IsRtl ? "تم إلغاء الاشتراك بنجاح" : "Unsubscribed successfully");
                await LoadSubscribers();
                await LoadStats();
            }
            else
            {
                await Toastr.ShowErrorAsync(res.Message);
            }
        }
        else
        {
            var res = await NewsletterService.SubscribeAsync(sub.EMailAddress, sub.UserType);
            if (res.Success)
            {
                await Toastr.ShowSuccessAsync(Loc.IsRtl ? "تم إعادة تفعيل الاشتراك بنجاح" : "Reactivated subscription successfully");
                await LoadSubscribers();
                await LoadStats();
            }
            else
            {
                await Toastr.ShowErrorAsync(res.Message);
            }
        }
    }

    private async Task DeleteSubscriber(NewsletterSubscriber sub)
    {
        var res = await NewsletterService.DeleteSubscriberAsync(sub.SubscribeID);
        if (res.Success)
        {
            await Toastr.ShowSuccessAsync(Loc.IsRtl ? "تم حذف المشترك بنجاح" : "Subscriber deleted successfully");
            await LoadSubscribers();
            await LoadStats();
        }
        else
        {
            await Toastr.ShowErrorAsync(res.Message);
        }
    }

    private async Task HandleAddSubscriber()
    {
        if (string.IsNullOrWhiteSpace(newSubscriberEmail)) return;
        var res = await NewsletterService.SubscribeAsync(newSubscriberEmail, newSubscriberUserType);
        if (res.Success)
        {
            await Toastr.ShowSuccessAsync(Loc.IsRtl ? "تمت إضافة المشترك بنجاح" : "Subscriber added successfully");
            showAddSubscriberModal = false;
            newSubscriberEmail = string.Empty;
            await LoadSubscribers();
            await LoadStats();
        }
        else
        {
            await Toastr.ShowErrorAsync(res.Message);
        }
    }

    private void HandleFileSelected(InputFileChangeEventArgs e)
    {
        selectedFile = e.File;
    }

    private void RemoveSelectedFile()
    {
        selectedFile = null;
    }

    private void ResetBroadcastForm()
    {
        broadcastModel = new() { TargetAudience = "All" };
        selectedFile = null;
    }

    private async Task HandleSendBroadcast()
    {
        if (string.IsNullOrWhiteSpace(broadcastModel.Title) || string.IsNullOrWhiteSpace(broadcastModel.Message))
        {
            await Toastr.ShowErrorAsync(Loc.IsRtl ? "يرجى كتابة عنوان ورسالة الإشعار" : "Please enter title and message");
            return;
        }

        isSendingBroadcast = true;
        var res = await NewsletterService.SendBroadcastAsync(broadcastModel, selectedFile);
        isSendingBroadcast = false;

        if (res.Success)
        {
            await Toastr.ShowSuccessAsync(Loc["Sent Successfully"]);
            ResetBroadcastForm();
            await LoadStats();
        }
        else
        {
            await Toastr.ShowErrorAsync(res.Message);
        }
    }

    private async Task LoadBroadcasts()
    {
        isLoadingBroadcasts = true;
        var res = await NewsletterService.GetBroadcastsAsync(broadcastsPage, broadcastsPageSize);
        if (res != null)
        {
            broadcastsList = res.Data ?? new();
            broadcastsTotalCount = res.TotalCount;
        }
        isLoadingBroadcasts = false;
        StateHasChanged();
    }

    private async Task ChangeBroadcastsPage(int newPage)
    {
        broadcastsPage = newPage;
        await LoadBroadcasts();
    }

    private void ClearLiveFeed()
    {
        liveNotifications.Clear();
    }

    private string GetAudienceBadge(string audience)
    {
        return audience?.ToUpperInvariant() switch
        {
            "CLIENTS" => "bg-success",
            "VENDORS" => "bg-warning text-dark",
            "SUBSCRIBERS" => "bg-info",
            _ => "bg-primary"
        };
    }

    private string GetFileIcon(string fileName)
    {
        if (string.IsNullOrWhiteSpace(fileName)) return "fa-file";
        string ext = Path.GetExtension(fileName).ToLowerInvariant();
        return ext switch
        {
            ".jpg" or ".jpeg" or ".png" or ".gif" or ".webp" => "fa-file-image",
            ".pdf" => "fa-file-pdf",
            ".doc" or ".docx" => "fa-file-word",
            ".xls" or ".xlsx" or ".csv" => "fa-file-excel",
            ".zip" or ".rar" => "fa-file-archive",
            _ => "fa-file-alt"
        };
    }

    private string FormatFileSize(long bytes)
    {
        if (bytes >= 1024 * 1024)
            return $"{bytes / (1024.0 * 1024.0):F2} MB";
        if (bytes >= 1024)
            return $"{bytes / 1024.0:F1} KB";
        return $"{bytes} B";
    }

    public void Dispose()
    {
        Loc.OnLanguageChanged -= HandleLanguageChanged;
        NewsletterService.OnNotificationReceived -= HandleSignalRNotification;
        NewsletterService.OnConnectionStatusChanged -= HandleConnectionStatusChanged;
    }
}
