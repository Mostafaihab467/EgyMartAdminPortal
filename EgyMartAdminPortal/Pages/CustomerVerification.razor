@page "/customer"
@inject UserService UserService
@inject ToastrService ToastService


<PageTitle>Pending Customer</PageTitle>
<h3>Pending Customer</h3>


<div class="mt-3 text-center">
    <LoadingSpinner IsLoading="isLoading" />
</div>

@if (!isLoading)
{
    @if (allItems.Count == 0)
    {
        <p class="text-center">@notFound</p>
    }
    else
    {
        <PageSelect PageSize="@PageSize" Count="@allItems.Count" OnPageSizeChanged="HandlePageSizeChanged"></PageSelect>
        <!-- Search Input -->
        <div class="row mb-3">
            <div class="col-md-4">
                <div class="input-group">
                    <input type="text" class="form-control text-field" placeholder="Search by Display Name or Email"
                           @bind="searchTerm" @bind:event="oninput" @onkeyup="FilterCustomers" />
                    <button class="btn btn-outline-secondary" type="button" @onclick="ClearSearch">Clear</button>
                </div>
            </div>
        </div>
        <table class="table">
            <thead>
                <tr>
                    <th>UserID</th>
                    <th>Display Name</th>
                    <th>User Name</th>
                    <th>Registered Since</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in pagedItems)
                {
                    <tr id="user-@user.CustomerID" class="@(user.IsDeleted ? "slide-out" : "")">
                        <td>@user.CustomerID</td>
                        <td>@user.DisplayName</td>
                        <td>@user.UserName</td>
                        <td>@user.RegisterdSince</td>
                        <td>
                            <UserVerification UserID="@user.CustomerID" VerificationStatus="@user.VerificationStatus"
                                              VerifyUser="(status) => VerifyUserAsync(user.CustomerID, status)"
                                              OnUserUpdated="@(() => HandleUserUpdate(user))" />
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <!-- Pagination Component -->
        <MPagination TItem="Customer"
        Items="allItems"
        CurrentPage="@CurrentPage"
        PageSize="@PageSize"
        OnPageChanged="HandlePageChanged" />
    }
}

@code {
    private List<Customer> allItems = new();
    private List<Customer> filteredItems = new();
    private List<Customer> pagedItems = new();
    private string notFound = "No Pending Customers Found";
    private bool isLoading = true;
    private string searchTerm = "";
    private int CurrentPage = 1;
    private int PageSize = 25;

    protected override async Task OnInitializedAsync()
    {
        await GetPendingVerifyCustomersAsync();
    }

    private async Task GetPendingVerifyCustomersAsync()
    {
        try
        {
            var response = await UserService.GetPendingVerifyCustomersAsync();
            if (response.Success)
            {
                allItems = response.Data;
                filteredItems = allItems;
                isLoading = false;
                UpdatePagedItems();
            }
            else
            {
                isLoading = false;
                await ToastService.ShowErrorAsync(response.ResponseEngMsg);
            }

        }
        catch (Exception ex)
        {
            await ToastService.ShowErrorAsync(ex.Message);
        }
    }

    private async Task<bool> VerifyUserAsync(long userId, short status)
    {
        var user = allItems.FirstOrDefault(u => u.CustomerID == userId);
        if (user == null)
        {
            await ToastService.ShowErrorAsync("User not found.");
            return false;
        }

        var success = await UserService.VerifyCustomerAsync(userId, status);
        if (success)
        {
            user.VerificationStatus = status;
        }
        return success;
    }

    private void HandleUserUpdate(Customer user)
    {
        user.IsDeleted = true;
        StateHasChanged();
        Task.Delay(500).ContinueWith(_ =>
        {
            allItems.Remove(user);
            FilterCustomers();
            UpdatePagedItems();
            StateHasChanged();
        });
    }

    private void FilterCustomers()
    {
        if (string.IsNullOrWhiteSpace(searchTerm))
        {
            filteredItems = allItems;
        }
        else
        {
            var search = searchTerm.ToLower();
            filteredItems = allItems
                .Where(u => u.DisplayName?.ToLower().Contains(search) == true ||
                           u.UserName?.ToLower().Contains(search) == true)
                .ToList();
        }
        CurrentPage = 1;
        UpdatePagedItems();
    }

    private async Task ClearSearch()
    {
        searchTerm = "";
        await Task.Run(() => FilterCustomers());
    }

    private void UpdatePagedItems()
    {
        pagedItems = filteredItems.Skip((CurrentPage - 1) * PageSize).Take(PageSize).ToList();
    }

    private void HandlePageChanged(int newPage)
    {
        CurrentPage = newPage;
        UpdatePagedItems();
    }

    private void HandlePageSizeChanged(int newSize)
    {
        PageSize = newSize;
        CurrentPage = 1;
        UpdatePagedItems();

    }
}
