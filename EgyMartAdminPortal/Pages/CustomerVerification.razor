@page "/customer"
@inject UserService UserService
@inject ToastrService ToastService


<PageTitle>Pending Customer</PageTitle>
<h3>Pending Customer</h3>


<div class="mt-3 text-center">
    <LoadingSpinner IsLoading="isLoading" />
</div>

@if (!isLoading)
{
    @if (allItems.Count == 0)
    {
        <p class="text-center">@notFound</p>
    }
    else
    {
        <PageSelect PageSize="@PageSize" Count="@allItems.Count" OnPageSizeChanged="HandlePageSizeChanged"></PageSelect>
        <table class="table">
            <thead>
                <tr>
                    <th>UserID</th>
                    <th>Display Name</th>
                    <th>User Name</th>
                    <th>Registered Since</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in pagedItems)
                {
                    <tr id="user-@user.CustomerID" class="@(user.IsDeleting ? "slide-out" : "")">
                        <td>@user.CustomerID</td>
                        <td>@user.DisplayName</td>
                        <td>@user.UserName</td>
                        <td>@user.RegisterdSince</td>
                        <td>
                            <UserVerification CustomerID="@user.CustomerID" IsVerified="@user.IsVerified" IsRefused="@user.IsRefused"
                                              VerifyUser="@((isVerify) => VerifyUserAsync(user.CustomerID, isVerify))"
                                              OnUserUpdated="@(() => HandleUserUpdate(user))" />
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <!-- Pagination Component -->
        <MPagination TItem="Customer"
        Items="allItems"
        CurrentPage="@CurrentPage"
        PageSize="@PageSize"
        OnPageChanged="HandlePageChanged" />
    }
}

@code {
    private List<Customer> allItems = new();
    private List<Customer> pagedItems = new();
    private string notFound = "No Pending Customers Found";
    private bool isLoading = true;

    private int CurrentPage = 1;
    private int PageSize = 25;

    protected override async Task OnInitializedAsync()
    {
        await GetPendingVerifyCustomersAsync();
    }

    private async Task GetPendingVerifyCustomersAsync()
    {
        try
        {
            var response = await UserService.GetPendingVerifyCustomersAsync();
            if (response.Success)
            {
                allItems = response.Data;
                isLoading = false;
                UpdatePagedItems();
            }
            else
            {
                isLoading = false;
                await ToastService.ShowErrorAsync(response.ResponseEngMsg);
            }

        }
        catch (Exception ex)
        {
            await ToastService.ShowErrorAsync(ex.Message);
        }
    }

    private async Task<bool> VerifyUserAsync(long userId, bool isVerify)
    {
        return isVerify
            ? await UserService.VerifyCustomerAsync(userId, 2)
            : await UserService.VerifyCustomerAsync(userId, 2);
    }

    private void HandleUserUpdate(Customer user)
    {
        user.IsDeleting = true;
        StateHasChanged();
        Task.Delay(500).ContinueWith(_ =>
        {
            allItems.Remove(user);
            UpdatePagedItems();
            StateHasChanged();
        });
    }

    private void UpdatePagedItems()
    {
        pagedItems = allItems.Skip((CurrentPage - 1) * PageSize).Take(PageSize).ToList();
    }

    private void HandlePageChanged(int newPage)
    {
        CurrentPage = newPage;
        UpdatePagedItems();
    }

    private void HandlePageSizeChanged(int newSize)
    {
        PageSize = newSize;
        CurrentPage = 1;
        UpdatePagedItems();

    }
}
