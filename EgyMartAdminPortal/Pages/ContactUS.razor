@page "/contact-us"
@using System.ComponentModel.DataAnnotations
@inject ContactUsService ContactUsService
@inject LanguageService LanguageService
@inject ToastrService ToastService

@if (showCreateButton)
{
    <div class="alert alert-warning mx-3">
        No contact information found.
        <button class="btn btn-sm btn-primary ms-2" @onclick="ShowCreateForm">Create Contact Us</button>
    </div>
}

@if (showCreateForm)
{
    <EditForm Model="contact" OnValidSubmit="CreateContactUsAsync" class="mb-4 mx-3">
        <DataAnnotationsValidator />
        <ValidationSummary />
        <div class="row">
            <div class="col-md-6 mb-2">
                <label>Email</label>
                <InputText class="form-control" @bind-Value="contact.EmailAddress" />
            </div>
            <div class="col-md-6 mb-2">
                <label>Phone</label>
                <InputText class="form-control" @bind-Value="contact.PhoneNumber" />
            </div>
            <div class="col-md-12 mb-2">
                <label>Address</label>
                <InputText class="form-control" @bind-Value="contact.Address" />
            </div>
            <div class="col-md-6 mb-2">
                <label>Website</label>
                <InputText class="form-control" @bind-Value="contact.Website" />
            </div>
            <div class="col-md-3 mb-2">
                <label>Latitude</label>
                <InputNumber class="form-control" @bind-Value="contact.Latitude" />
            </div>
            <div class="col-md-3 mb-2">
                <label>Longitude</label>
                <InputNumber class="form-control" @bind-Value="contact.Longitude" />
            </div>
        </div>

        <button type="submit" class="btn btn-success">Create</button>
        <button type="button" class="btn btn-danger" @onclick="() => showCreateForm = false">Cancel</button>
    </EditForm>
}


@if (contact is null)
{
    <p><em>Loading...</em></p>
}
else
{
    <div class="contact-us-banner"></div>
    <div class="card mb-4 mx-3" style="margin-top: -120px !important;">
        <div class="row g-0">
            <div class="col-md-4">
                <div class="card-body">
                    <h5 class="card-title">Contact Details</h5>
                    <p class="card-text">
                        <div class="icon-box">
                            <i class="fa-solid fa-envelope"></i>
                        </div>
                        &nbsp; @contact.EmailAddress
                    </p>
                    <p class="card-text">
                        <div class="icon-box">
                            <i class="fa-solid fa-phone"></i>
                        </div>
                        &nbsp; @contact.PhoneNumber
                    </p>
                    <p class="card-text">
                        <div class="icon-box">
                            <i class="fa-solid fa-location-dot px-_15"></i>
                        </div>
                        &nbsp; @contact.Address
                    </p>
                    <p class="card-text">
                        <div class="icon-box">
                            <i class="fa-solid fa-globe"></i>
                        </div>
                        &nbsp; @contact.Website
                    </p>

                    <div class="mt-3">
                        <button class="btn btn-primary me-2" @onclick="ShowEditForm">Edit</button>
                        <button class="btn btn-secondary" @onclick="ShowTranslatePopup">Translate</button>
                    </div>
                </div>
            </div>
            <div class="col-md-8">
                <div class="mt-2 me-2">
                    <iframe width="100%"
                    height="340"
                    frameborder="0"
                    style="border:0"
                    allowfullscreen
                    loading="lazy"
                    referrerpolicy="no-referrer-when-downgrade"
                    src="https://www.google.com/maps?q=@contact.Latitude,@contact.Longitude&z=14&output=embed">
                    </iframe>
                </div>
            </div>
        </div>
    </div>

    @if (showEditForm)
    {
        <EditForm Model="contact" OnValidSubmit="SaveContactUsAsync" class="mb-4">
            <DataAnnotationsValidator />
            <ValidationSummary />

            <div class="row">
                <div class="col-md-6 mb-2">
                    <label>Email</label>
                    <InputText class="form-control" @bind-Value="contact.EmailAddress" />
                </div>
                <div class="col-md-6 mb-2">
                    <label>Phone</label>
                    <InputText class="form-control" @bind-Value="contact.PhoneNumber" />
                </div>
                <div class="col-md-12 mb-2">
                    <label>Address</label>
                    <InputText class="form-control" @bind-Value="contact.Address" />
                </div>
                <div class="col-md-6 mb-2">
                    <label>Website</label>
                    <InputText class="form-control" @bind-Value="contact.Website" />
                </div>
                <div class="col-md-3 mb-2">
                    <label>Latitude</label>
                    <InputNumber class="form-control" @bind-Value="contact.Latitude" />
                </div>
                <div class="col-md-3 mb-2">
                    <label>Longitude</label>
                    <InputNumber class="form-control" @bind-Value="contact.Longitude" />
                </div>
            </div>

            <button type="submit" class="btn btn-success">Save</button>
            <button type="button" class="btn btn-danger" @onclick="() => showEditForm = false">close</button>
        </EditForm>
    }

    @if (showTranslatePopup)
    {
        <div class="modal-backdrop fade show"></div>
        <div class="modal show d-block" tabindex="-1" role="dialog">
            <div class="modal-dialog" role="document">
                <div class="modal-content">
                    <EditForm Model="translationModel" OnValidSubmit="TranslateContactAsync">
                        <DataAnnotationsValidator />
                        <div class="modal-header">
                            <h5 class="modal-title">Translate Contact Info</h5>
                            <button type="button" class="btn-close" @onclick="CloseTranslatePopup"></button>
                        </div>
                        <div class="modal-body">
                            <div class="mb-3">
                                <label class="form-label">Select Language</label>
                                <select class="form-select" value="@selectedLanguage" @onchange="OnLanguageChanged">
                                    @foreach (var lang in allowedLanguages!)
                                    {
                                        <option value="@lang.Key">@lang.Value</option>
                                    }
                                </select>
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Translated Address</label>
                                <InputText class="form-control" @bind-Value="translationModel.Address" />
                                <ValidationMessage For="@(() => translationModel.Address)" />
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" @onclick="CloseTranslatePopup">Cancel</button>
                            <button type="submit" class="btn btn-primary" disabled="@IsTranslating">@(IsTranslating ? "Translating..." : "Translate")</button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    }
}

<style>
    .px-_15 {
    padding-right: .15rem !important;
    padding-left: .15rem !important;
    }
</style>

@code {
    private ContactUs? contact;
    private bool showEditForm = false;
    private bool showTranslatePopup = false;
    private bool IsTranslating = false;
    private bool showCreateButton = false;
    private bool showCreateForm = false;

    private Dictionary<int, string>? allowedLanguages;
    private ContactTr translationModel = new();
    private int selectedLanguage;


    protected override async Task OnInitializedAsync()
    {
        var list = await ContactUsService.GetByLangAsync(langID: 1);
        contact = list.LastOrDefault();
        showCreateButton = contact is null;
    }

    private void ShowEditForm() => showEditForm = true;
    private void HideEditForm() => showEditForm = false;

    private void ShowCreateForm()
    {
        contact = new ContactUs
            {
                LangID = 1
            };
        showCreateForm = true;
    }

    private async Task CreateContactUsAsync()
    {
        if (contact is not null)
        {
            var success = await ContactUsService.CreateContactUsAsync(contact);
            if (success)
            {
                showCreateForm = false;
                showCreateButton = false;

                await ToastService.ShowSuccessAsync("Contact Us created successfully!", "Success");

                var list = await ContactUsService.GetByLangAsync(langID: 1);
                contact = list.LastOrDefault();
            }
            else
            {
                await ToastService.ShowErrorAsync("Failed to create contact.", "Error");
            }
        }
    }

    private async Task SaveContactUsAsync()
    {
        if (contact is not null)
        {
            var success = await ContactUsService.UpdateContactUsAsync(contact);
            if (success)
            {
                showEditForm = false;
                await ToastService.ShowSuccessAsync("Contact Us Update completed!", "Success");
            }
        }
    }

    private async void ShowTranslatePopup()
    {
        allowedLanguages = await LanguageService.GetLanguagesAsync();

        selectedLanguage = allowedLanguages.Keys.Contains(2) ? 2 : allowedLanguages.Keys.FirstOrDefault();

        showTranslatePopup = true;
        translationModel = new ContactTr
            {
                LangID = selectedLanguage,
                Address = string.Empty
            };

        await LoadTranslationForLanguage(selectedLanguage);

    }

    private async Task OnLanguageChanged(ChangeEventArgs e)
    {
        if (e?.Value is null)
            return;

        if (int.TryParse(e.Value.ToString(), out int langId))
        {
            selectedLanguage = langId;
            translationModel.LangID = langId;

            await LoadTranslationForLanguage(langId);
            StateHasChanged();
        }
    }

    private async Task LoadTranslationForLanguage(int langId)
    {
        if (contact is null)
            return;

        var existingTranslation = (await ContactUsService.GetByLangAsync(langId))
            .LastOrDefault(c => c.BaseID == contact.ContactUsID);

        translationModel.Address = existingTranslation?.Address ?? string.Empty;
        StateHasChanged();
    }

    private void CloseTranslatePopup() => showTranslatePopup = false;

    private async Task TranslateContactAsync()
    {
        if (contact is null) return;

        var translated = new
            {
                BaseID = contact.ContactUsID,
                LangID = translationModel.LangID,
                Address = translationModel.Address
            };

        IsTranslating = true;
        var success = await ContactUsService.TranslateContactUsAsync(translated);
        if (success)
        {
            showTranslatePopup = false;
            await ToastService.ShowSuccessAsync("Contact Us Translate completed!", "Success");
            IsTranslating = false;
        }
        else
        {
            await ToastService.ShowErrorAsync("Contact Us Translate failed!", "Error");
            IsTranslating = false;
        }

    }

    public class ContactTr
    {

        [Required(ErrorMessage = "Address is required")]
        public string Address { get; set; } = string.Empty;

        public int LangID { get; set; }
    }

}
