@page "/faq"
@inject FAQService FAQService
@inject ToastrService ToastService

<PageTitle>FAQs Management</PageTitle>
<h3>FAQsManagement</h3>

<div class="mt-2">
    <button class="btn btn-primary" @onclick="() => ShowPopup()"><i class="fas fa-plus-circle"></i> Add New</button>
</div>

<Popup IsVisible="showPopup" Title="@popupTitle" Class="m-model" OnSave="CreateAsync" FormModel="newItem">
    <div class="form-group">
        <label for="qTitle"> Question</label>
        <input type="text" class="form-control" id="qTitle" @bind="newItem.QTitle" @ref="itemRef" />
        <ValidationMessage For="@(() => newItem.QTitle)" />
    </div>
    <div class="form-group">
        <label for="qAnswer">Answer</label>
        <CKEditor @bind-Value="@newItem.QAnswer" />
        <ValidationMessage For="@(() => newItem.QAnswer)" />
    </div>
    <div class="form-group">
        <label for="displayOrder">Display Order</label>
        <InputPositiveNumber Value="@newItem.DisplayOrder"
                             ValueChanged="@(value => { newItem.DisplayOrder = value; StateHasChanged(); })" />
        <ValidationMessage For="@(() => newItem.DisplayOrder)" />
    </div>
</Popup>

<div class="mt-3 text-center">
    <LoadingSpinner IsLoading="isLoading" />
</div>

@if (!isLoading)
{
    @if (allItems.Count == 0)
    {
        <p class="text-center">@notFound</p>
    }
    else
    {
        <PageSelect PageSize="@PageSize" Count="@allItems.Count" OnPageSizeChanged="HandlePageSizeChanged"></PageSelect>
        <div class="row">
            @foreach (var item in pagedItems)
            {
                <div class="col-md-4">
                    <div class="card mb-3">
                        <div class="card-header d-flex justify-content-between align-items-center">
                            <EditableField T="string" Value="@item.QTitle" Width="73" ValueChanged="value => SaveEdit(item, nameof(item.QTitle), value)" />
                            <span class="ms-auto cursor-pointer" @onclick="() => ToggleStatus(item.Qid, item.IsActive)">
                                <Badge Class="@($"p-2 {(item.IsActive ? "btn-success" : "btn-danger")}")"
                                       IndicatorType="BadgeIndicatorType.RoundedPill">
                                    @(item.IsActive ? "Active" : "Not Active")
                                </Badge>
                            </span>
                        </div>
                        <div class="card-body">
                            <EditableField T="string" InputType="textarea" Frame="true" Width="100" Value="@item.QAnswer" ValueChanged="value => SaveEdit(item, nameof(item.QAnswer), value)" />
                        </div>
                        <div class="card-footer">
                            <TranslatePopup Item="@newItem" Service="FAQService" Class="m-model" BaseID="item.Qid" OnTranslationSuccess="Refresh">
                                <label for="qTitle">Question Title</label>
                                <input id="qTitle" class="form-control" @bind="@newItem.QTitle" />
                                <ValidationMessage For="@(() => newItem.QTitle)" />
                                <label for="qAnswer" class="mt-2">Answer</label>
                                <CKEditor @bind-Value="@newItem.QAnswer" />
                                <ValidationMessage For="@(() => newItem.QAnswer)" />
                            </TranslatePopup>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
}

<!-- Pagination Component -->
<MPagination TItem="FAQ"
             Items="allItems"
             CurrentPage="@CurrentPage"
             PageSize="@PageSize"
             OnPageChanged="HandlePageChanged" />

@code {
    private List<FAQ> allItems = new();
    private List<FAQ> pagedItems = new();
    private FAQ newItem = new FAQ { QTitle = "", QAnswer = "" };
    public ElementReference itemRef;

    private bool isLoading = true;
    private string notFound = "No subscribtions Found";
    private string popupTitle = "Add New Question";
    private bool showPopup = false;
    private int CurrentPage = 1;
    private int PageSize = 25;

    protected override async Task OnInitializedAsync()
    {
        await GetAsync();
    }

    private void ShowPopup()
    {
        showPopup = true;
        newItem = new FAQ();
        StateHasChanged();
        Task.Delay(100).ContinueWith(async _ => await itemRef.FocusAsync());
    }

    private async Task CreateAsync()
    {
        var response = await FAQService.CreateAsync(newItem);

        if (response.IsSuccessStatusCode)
        {
            await ToastService.ShowSuccessAsync("Question Created Successfully", "Success");
            showPopup = false;
            await GetAsync();
        }
        else
        {
            await ToastService.ShowErrorAsync("Error While Creating New Question", "Error");
        }

    }

    private async Task SaveEdit(FAQ item, string fieldName, object newValue)
    {
        showPopup = false;
        var property = typeof(FAQ).GetProperty(fieldName);
        if (property == null) return;

        var currentValue = property.GetValue(item);
        if (currentValue?.ToString() == newValue?.ToString()) return;

        if (property.PropertyType == typeof(int) && int.TryParse(newValue!.ToString(), out int intValue))
        {
            property.SetValue(item, intValue);
        }
        else if (property.PropertyType == typeof(string))
        {
            property.SetValue(item, newValue!.ToString());
        }

        var response = await FAQService.EditAsync(item);
        if (response.IsSuccessStatusCode)
        {
            await ToastService.ShowSuccessAsync("Update successful", "Success");
        }
        else
        {
            await ToastService.ShowErrorAsync("Error updating question", "Error");
        }

        StateHasChanged();
    }

    private async Task GetAsync()
    {
        var response = await FAQService.GetAsync();
        if (response != null)
        {
            allItems = response;
            isLoading = false;
            UpdatePagedItems();
        }
        else
        {
            isLoading = false;
            await ToastService.ShowErrorAsync("Error While Getting Items", "Error");
        }
    }

    private async Task ToggleStatus(int ID, bool currentStatus)
    {
        showPopup = false;
        var item = allItems.FirstOrDefault(i => i.Qid == ID);

        if (item == null)
        {
            await ToastService.ShowErrorAsync("Item not found", "Error");
            return;
        }

        item.IsActive = !currentStatus;
        var response = await FAQService.ChangeStatusAsync(ID, item.IsActive);

        if (response.Data == 0)
        {
            item.IsActive = currentStatus;
            await ToastService.ShowErrorAsync("Error updating status", "Error");
        }

        StateHasChanged();
    }

    private void UpdatePagedItems()
    {
        pagedItems = allItems.Skip((CurrentPage - 1) * PageSize).Take(PageSize).ToList();
    }

    private void HandlePageChanged(int newPage)
    {
        CurrentPage = newPage;
        UpdatePagedItems();
    }

    private void HandlePageSizeChanged(int newSize)
    {
        PageSize = newSize;
        CurrentPage = 1;
        UpdatePagedItems();
    }

    private async Task Refresh()
    {
        await ToastService.ShowSuccessAsync("FAQ translation completed!", "Success");
    }
}
