@page "/subscribtions"
@using System.ComponentModel.DataAnnotations
@inject SubscribtionService SubscribtionService
@inject IJSRuntime JSRuntime

<PageTitle>Subscribtions Management</PageTitle>
<h3>Subscribtions</h3>

<EditForm Model="@this" OnValidSubmit="FetchSubscriptions">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="d-flex align-items-end gap-2 mb-3">
        <div>
            <label for="startDate" class="form-label">Start Date:</label>
            <input @bind="startDate" class="form-control" @ref="endDateInput" type="date"
                   max="@DateTime.Today.ToString("yyyy-MM-dd")" />
        </div>
        <div>
            <label for="endDate" class="form-label">End Date:</label>
            <input @bind="endDate" class="form-control" @ref="endDateInput" type="date"
                   min="@startDate.ToString("yyyy-MM-dd")"
                   max="@DateTime.Today.ToString("yyyy-MM-dd")" />

            <ValidationMessage For="@(() => endDate)" class="text-danger" />
        </div>
        <Button class="btn btn-primary" Type="BlazorBootstrap.ButtonType.Submit" TooltipTitle="Fetch Subscriptions" TooltipPlacement="TooltipPlacement.Top">
            <i class="fas fa-filter"></i>
        </Button>
    </div>
</EditForm>


<div class="mt-3 text-center">
    <LoadingSpinner IsLoading="isLoading" />
</div>

@if (!isLoading)
{
    @if (allItems.Count == 0)
    {
        <p class="text-center">@notFound</p>
    }
    else
    {
        <PageSelect PageSize="@PageSize" Count="@allItems.Count" OnPageSizeChanged="HandlePageSizeChanged">
            <Button class="btn btn-primary" TooltipTitle="Export to Excel" TooltipPlacement="TooltipPlacement.Top" data-bs-original-title="Export to Excel" @onclick="ExportToExcel">
                <i class="fas fa-file-csv"></i>
            </Button>
        </PageSelect>

        <table class="table">
            <thead>
                <tr>
                    <th>Email</th>
                    <th>Added Date</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var sub in pagedItems)
                {
                    <tr>
                        <td>@sub.EMailAddress</td>
                        <td>@sub.AddDate.ToString("yyyy-MM-dd HH:mm")</td>
                    </tr>
                }
            </tbody>
        </table>
    }
}

<!-- Pagination Component -->
<MPagination TItem="Subscribtion"
             Items="allItems"
             CurrentPage="@CurrentPage"
             PageSize="@PageSize"
             OnPageChanged="HandlePageChanged" />

<style>
    /* Remove clear (✖) button in Chrome, Edge, and Safari */
    input[type="date"]::-webkit-clear-button,
    input[type="date"]::-webkit-inner-spin-button {
        display: none;
    }

    /* Remove clear button in Firefox */
    input[type="date"]::-moz-clear {
        display: none;
    }

    /* Remove clear button in IE/Edge (Old versions) */
    input[type="date"]::-ms-clear {
        display: none;
    }
</style>
@code {
    private List<Subscribtion> allItems = new();
    private List<Subscribtion> pagedItems = new();

    private bool isLoading = false;
    private string notFound = "There are no subscribers yet. Please choose a longer period.";
    private int CurrentPage = 1;
    private int PageSize = 25;

    private DateTime startDate = DateTime.Today.AddMonths(-2);

    private ElementReference endDateInput;
    private DateTime endDate = DateTime.Today;

    protected override async Task OnInitializedAsync()
    {
        await FetchSubscriptions();
    }

    private async Task FetchSubscriptions()
    {
        isLoading = true;
        allItems = await SubscribtionService.GetSubscriptionsAsync(startDate, endDate);
        isLoading = false;
    }

    private async Task ExportToExcel()
    {
        await FetchSubscriptions();
        if (allItems.Count > 0)
        {
            try
            {
                await JSRuntime.InvokeVoidAsync("exportToExcel", "Subscriptions.xlsx", allItems);
            }
            catch (JSException ex)
            {
                Console.WriteLine($"JavaScript error: {ex.Message}");
            }
        }
    }

    private void UpdatePagedItems()
    {
        pagedItems = allItems.Skip((CurrentPage - 1) * PageSize).Take(PageSize).ToList();
    }

    private void HandlePageChanged(int newPage)
    {
        CurrentPage = newPage;
        UpdatePagedItems();
    }

    private void HandlePageSizeChanged(int newSize)
    {
        PageSize = newSize;
        CurrentPage = 1;
        UpdatePagedItems();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JSRuntime.InvokeVoidAsync("disableFutureDates", endDateInput);
        }
    }
}
