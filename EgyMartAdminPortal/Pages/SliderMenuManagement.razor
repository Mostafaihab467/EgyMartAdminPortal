@page "/slider-menu"
@inject SliderMenuService SliderMenuService
@inject ToastrService ToastService

<PageTitle>SliderMenu Management</PageTitle>
<h3>SliderMenuManagement</h3>

<div class="mt-2">
    <button class="btn btn-primary" @onclick="() => ShowPopup()"><i class="fas fa-plus-circle"></i> Add New</button>
</div>

<Popup IsVisible="showPopup" Title="@popupTitle" OnSave="CreateAsync" FormModel="newItem">
    <div class="form-group">
        <label for="mainTitle">Main Title</label>
        <input type="text" class="form-control" id="mainTitle" @bind="newItem.MainTitle" @ref="itemRef" />
        <ValidationMessage For="@(() => newItem.MainTitle)" />
    </div>
    <div class="form-group">
        <label for="shortTitle">Short Title</label>
        <input type="text" class="form-control" id="shortTitle" @bind="newItem.ShortTitle" />
        <ValidationMessage For="@(() => newItem.ShortTitle)" />
    </div>
    <div class="form-group">
        <label for="call2ActionMsg">Action Msg</label>
        <input type="text" class="form-control" id="call2ActionMsg" @bind="newItem.Call2ActionMsg" />
        <ValidationMessage For="@(() => newItem.Call2ActionMsg)" />
    </div>
    <div class="form-group">
        <label for="imageUpload">Upload Image</label>
        <FileDropZone InputFile="true" OnImageUploaded="@(EventCallback.Factory.Create<string>(this, HandleImageUploaded))" />
    </div>
    <div class="form-group">
        <label for="call2ActionURL">Action Url</label>
        <input type="text" class="form-control" id="call2ActionURL" @bind="newItem.Call2ActionURL" />
        <ValidationMessage For="@(() => newItem.Call2ActionURL)" />
    </div>
    <div class="form-group">
        <label for="displayOrder">Display Order</label>
        <InputPositiveNumber Value="@newItem.DisplayOrder"
        ValueChanged="@(value => { newItem.DisplayOrder = value; StateHasChanged(); })" />
        <ValidationMessage For="@(() => newItem.DisplayOrder)" />
    </div>
</Popup>

<div class="mt-3 text-center">
    <LoadingSpinner IsLoading="isLoading" />
</div>

@if (!isLoading)
{
    @if (allItems.Count == 0)
    {
        <p class="text-center">@notFound</p>
    }
    else
    {
        <PageSelect PageSize="@PageSize" Count="@allItems.Count" OnPageSizeChanged="HandlePageSizeChanged"></PageSelect>
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Main Title</th>
                    <th>Short Title</th>
                    <th>Action Msg</th>
                    <th>Image</th>
                    <th>Action Url</th>
                    <th>Display Order</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in pagedItems)
                {
                    <tr>
                        <td>
                            <EditableField T="string" Value="@item.MainTitle" Width="100" ValueChanged="value => SaveEdit(item, nameof(item.MainTitle), value)" />
                        </td>
                        <td>
                            <EditableField T="string" Value="@item.ShortTitle" Width="100" ValueChanged="value => SaveEdit(item, nameof(item.ShortTitle), value)" />
                        </td>
                        <td>
                            <EditableField T="string" Value="@item.Call2ActionMsg" Width="100" ValueChanged="value => SaveEdit(item, nameof(item.Call2ActionMsg), value)" />
                        </td>
                        <td class="cursor-pointer">
                            <FileDropZone Image="@item.ImageURL" CloseIcon="true" InputFile="false"
                                          OnImageUploaded="@(EventCallback.Factory.Create<string>(this, image => HandleEditImageUploaded(item, image)))" />
                        </td>
                        <td>
                            <EditableField T="string" Value="@item.Call2ActionURL" Width="100" ValueChanged="value => SaveEdit(item, nameof(item.Call2ActionURL), value)" />
                        </td>
                        <td>
                            <EditableField T="int" InputType="number" Value="@item.DisplayOrder" Width="7" ValueChanged="value => SaveEdit(item, nameof(item.DisplayOrder), value)" />
                        </td>
                        <td class="cursor-pointer" style="width: 10%;" @onclick="() => ToggleStatus(item.SliderID, item.IsActive)">
                            <Badge Class="@($"p-2 {(item.IsActive ? "btn-success" : "btn-danger")}")"
                            IndicatorType="BadgeIndicatorType.RoundedPill">
                                @(item.IsActive ? "Active" : "Not Active")
                            </Badge>
                        </td>
                        <td>
                            <TranslatePopup Item="@newItem" Service="SliderMenuService" BaseID="@item.SliderID"
                            OnTranslationSuccess="Refresh" CurrentData="@(new Dictionary<string, object>
                {
                    { "Call2ActionURL", item.Call2ActionURL },
                    { "ImageURL", item.ImageURL },
                })">
                                <label for="mainTitle">Main Title</label>
                                <input id="mainTitle" class="form-control" @bind="@newItem.MainTitle" />
                                <label for="shortTitle">Short Title</label>
                                <input id="shortTitle" class="form-control" @bind="@newItem.ShortTitle" />
                                <label for="call2ActionMsg">Action Msg</label>
                                <input id="call2ActionMsg" class="form-control" @bind="@newItem.Call2ActionMsg" />
                            </TranslatePopup>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
}

<!-- Pagination Component -->
<MPagination TItem="SliderMenu"
Items="allItems"
CurrentPage="@CurrentPage"
PageSize="@PageSize"
OnPageChanged="HandlePageChanged" />

@code {
    private List<SliderMenu> allItems = new();
    private List<SliderMenu> pagedItems = new();
    private SliderMenu newItem = new();
    public ElementReference itemRef;

    private bool isLoading = true;
    private string notFound = "No Pages Found";
    private string popupTitle = "Add New Page";
    private bool showPopup;
    private int CurrentPage = 1;
    private int PageSize = 25;

    protected override async Task OnInitializedAsync()
    {
        await GetAsync();
    }

    private void ShowPopup()
    {
        showPopup = true;
        newItem = new SliderMenu();
        Task.Delay(100).ContinueWith(async _ => await itemRef.FocusAsync());
    }

    private async Task CreateAsync()
    {
        var response = await SliderMenuService.CreateAsync(newItem);

        if (response.IsSuccessStatusCode)
        {
            await ToastService.ShowSuccessAsync("Menu Created Successfully", "Success");
            showPopup = false;
            await GetAsync();
        }
        else
        {
            await ToastService.ShowErrorAsync("Error While Creating New Menu", "Error");
        }

    }

    private async Task SaveEdit(SliderMenu item, string fieldName, object newValue)
    {
        showPopup = false;
        var property = typeof(SliderMenu).GetProperty(fieldName);
        if (property == null) return;

        var currentValue = property.GetValue(item);
        
        if (property.PropertyType == typeof(int))
        {
            if (int.TryParse(newValue?.ToString(), out int newIntValue) &&
                currentValue is int currentIntValue &&
                newIntValue == currentIntValue)
            {
                return;
            }
        }
        else if (property.PropertyType == typeof(string))
        {
            if (currentValue?.ToString() == newValue?.ToString()) return;
        }

        if (fieldName == nameof(SliderMenu.MainTitle) && string.IsNullOrWhiteSpace(newValue?.ToString()))
        {
            await ToastService.ShowErrorAsync("Menu Title is empty", "Validation Error");
            return;
        }

        if (fieldName == nameof(SliderMenu.ShortTitle) && string.IsNullOrWhiteSpace(newValue?.ToString()))
        {
            await ToastService.ShowErrorAsync("Short Title is empty", "Validation Error");
            return;
        }

        if (fieldName == nameof(SliderMenu.Call2ActionMsg) && string.IsNullOrWhiteSpace(newValue?.ToString()))
        {
            await ToastService.ShowErrorAsync("Action Message is empty", "Validation Error");
            return;
        }

        if (fieldName == nameof(SliderMenu.Call2ActionURL) && string.IsNullOrWhiteSpace(newValue?.ToString()))
        {
            await ToastService.ShowErrorAsync("Action URL is empty", "Validation Error");
            return;
        }

        if (property.PropertyType == typeof(int) && int.TryParse(newValue!.ToString(), out int intValue))
        {
            property.SetValue(item, intValue);
        }
        else if (property.PropertyType == typeof(string))
        {
            property.SetValue(item, newValue!.ToString());
        }

        var response = await SliderMenuService.EditAsync(item);
        if (response.IsSuccessStatusCode)
        {
            await ToastService.ShowSuccessAsync("Update successful", "Success");
        }
        else
        {
            await ToastService.ShowErrorAsync("Error updating menu", "Error");
        }

        StateHasChanged();
    }

    private async Task GetAsync()
    {
        var response = await SliderMenuService.GetAsync();
        if (response != null)
        {
            allItems = response;
            isLoading = false;
            UpdatePagedItems();
        }
        else
        {
            isLoading = false;
            await ToastService.ShowErrorAsync("Error While Getting Items", "Error");
        }
    }

    private async Task ToggleStatus(int ID, bool currentStatus)
    {
        showPopup = false;
        var item = allItems.FirstOrDefault(i => i.SliderID == ID);

        if (item == null)
        {
            await ToastService.ShowErrorAsync("Item not found", "Error");
            return;
        }

        item.IsActive = !currentStatus;
        var response = await SliderMenuService.ChangeStatusAsync(ID, item.IsActive);

        if (response.Data == 0)
        {
            item.IsActive = currentStatus;
            await ToastService.ShowErrorAsync("Error updating status", "Error");
        }

        StateHasChanged();
    }

    private void UpdatePagedItems()
    {
        pagedItems = allItems.Skip((CurrentPage - 1) * PageSize).Take(PageSize).ToList();
    }

    private void HandlePageChanged(int newPage)
    {
        CurrentPage = newPage;
        UpdatePagedItems();
    }

    private void HandlePageSizeChanged(int newSize)
    {
        PageSize = newSize;
        CurrentPage = 1;
        UpdatePagedItems();
    }

    private async Task Refresh()
    {
        await ToastService.ShowSuccessAsync("Menu translation completed!", "Success");
    }

    private async Task HandleImageUploaded(string base64Image)
    {
        // Strip the "data:image/png;base64," prefix if present
        if (base64Image.StartsWith("data:image"))
        {
            var base64Parts = base64Image.Split(',');
            newItem.ImageURL = base64Parts.Length > 1 ? base64Parts[1] : base64Image;
        }
        else
        {
            newItem.ImageURL = base64Image;
        }

        await InvokeAsync(StateHasChanged);
    }

    private async Task HandleEditImageUploaded(SliderMenu item, string base64Image)
    {
        if (item == null || string.IsNullOrWhiteSpace(base64Image))
            return;

        // ✅ Remove data URI prefix if it exists
        var base64Data = base64Image.Contains(",") ? base64Image.Split(',')[1] : base64Image;

        // Just for UI preview
        item.ImageURL = base64Image;

        var response = await SliderMenuService.EditSliderImageAsync(item.SliderID, base64Data);

        if (response)
        {
            await ToastService.ShowSuccessAsync("Image updated successfully!", "Success");
        }
        else
        {
            await ToastService.ShowErrorAsync("Failed to update image", "Error");
        }

        await GetAsync(); // Refresh
    }
}
