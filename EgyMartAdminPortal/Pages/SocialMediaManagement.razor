@page "/social-media"

@inject NavigationManager NavigationManager
@inject SocialMediaService SocialMediaService
@inject ToastrService ToastService

<PageTitle>Social Media Management</PageTitle>
<h1>Social Media Management</h1>
<div class="mt-2">
    <button class="btn btn-primary" @onclick="() => ShowPopup()"><i class="fas fa-plus-circle"></i> Add New</button>
</div>

<Popup IsVisible="showPopup" Title="@popupTitle" OnSave="CreateIcon">
    <div class="form-group">
        <label for="linkTitle">link Title</label>
        <input type="text" class="form-control" id="linkTitle" @bind="newItem.LinkTitle" @ref="itemRef" />
    </div>
    <div class="form-group">
        <label for="linkTarget">Link Url</label>
        <input type="text" class="form-control" id="linkTarget" @bind="newItem.LinkTarget" />
    </div>
    <div class="form-group">
        <label for="displayOrder">Display Order</label>
        <input type="number" class="form-control" id="displayOrder" @bind="newItem.DisplayOrder" />
    </div>
    <div class="form-group">
        <label for="linkIcon">Link Icon</label>
        <input type="text" class="form-control" id="linkIcon" @bind="newItem.LinkIcon" />
    </div>
</Popup>

<div class="mt-3 text-center">
    <LoadingSpinner IsLoading="isLoading" />
</div>


@if (!isLoading)
{
    @if (allItems.Count == 0)
    {
        <p class="text-center">@notFound</p>
    }
    else
    {
        <PageSelect PageSize="@PageSize" Count="@allItems.Count" OnPageSizeChanged="HandlePageSizeChanged"></PageSelect>
        <table class="table">
            <thead>
                <tr>
                    <th>Link Title</th>
                    <th>Link Url</th>
                    <th>Display Order</th>
                    <th>Link Icon</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in pagedItems)
                {
                    <tr id="ad-@item.LinkID">
                        <td class="cursor-pointer">
                            <EditableField T="string" Value="@item.LinkTitle" ValueChanged="value => SaveEdit(item, nameof(item.LinkTitle), value)" />
                        </td>
                        <td class="cursor-pointer">
                            <EditableField T="string" Value="@item.LinkTarget" ValueChanged="value => SaveEdit(item, nameof(item.LinkTarget), value)" />
                        </td>
                        <td class="cursor-pointer">
                            <EditableField T="int" InputType="number" Value="@item.DisplayOrder" ValueChanged="value => SaveEdit(item, nameof(item.DisplayOrder), value)" />
                        </td>
                        <td class="cursor-pointer">
                            <EditableField T="string" Value="@item.LinkIcon" ValueChanged="value => SaveEdit(item, nameof(item.LinkIcon), value)" />
                        </td>
                        <td class="cursor-pointer">
                            @if (item.IsActive)
                            {
                                <Badge Class="p-2 btn-success" IndicatorType="BadgeIndicatorType.RoundedPill" @onclick="() => ToggleStatus(item.LinkID, item.IsActive)">Active</Badge>
                            }
                            else
                            {
                                <Badge Class="p-2 btn-danger" IndicatorType="BadgeIndicatorType.RoundedPill" @onclick="() => ToggleStatus(item.LinkID, item.IsActive)">Not Active</Badge>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }

    <!-- Pagination Component -->
    <MPagination TItem="SocialMedia"
                 Items="allItems"
                 CurrentPage="@CurrentPage"
                 PageSize="@PageSize"
                 OnPageChanged="HandlePageChanged" />
}

@code {
    private List<SocialMedia> allItems = new();
    private List<SocialMedia> pagedItems = new();
    private SocialMedia newItem = new();
    public ElementReference itemRef;

    private string notFound = "No Social Icons Found";
    private string popupTitle = "Add New Icon";
    private bool showPopup = false;
    private bool isLoading = true;

    private int CurrentPage = 1;
    private int PageSize = 25;

    protected override async Task OnInitializedAsync()
    {
        await GetAsync();
    }

    private void ShowPopup()
    {
        showPopup = true;
        newItem = new SocialMedia();
        StateHasChanged();
        Task.Delay(100).ContinueWith(async _ => await itemRef.FocusAsync());
    }

    private async Task CreateIcon()
    {
        var response = await SocialMediaService.CreateAsync(newItem);

        if (response.IsSuccessStatusCode)
        {
            await ToastService.ShowSuccessAsync("Icon Created Successfully", "Success");
            showPopup = false;
            await GetAsync();
        }
        else
        {
            await ToastService.ShowErrorAsync("Error While Creating New Icon", "Error");
        }

    }

    private async Task GetAsync()
    {
        try
        {
            var response = await SocialMediaService.GetAsync();
            if (response.Success)
            {
                allItems = response.Data;
                isLoading = false;
                UpdatePagedItems();
            }
            else
            {
                await ToastService.ShowErrorAsync(response.ResponseEngMsg);
            }

        }
        catch (Exception ex)
        {
            await ToastService.ShowErrorAsync(ex.Message);
        }
    }

    private async Task ToggleStatus(short ID, bool currentStatus)
    {
        showPopup = false;
        var item = allItems.FirstOrDefault(i => i.LinkID == ID);

        if (item == null)
        {
            await ToastService.ShowErrorAsync("Item not found", "Error");
            return;
        }

        item.IsActive = !currentStatus;
        var response = await SocialMediaService.ChangeStatusAsync(ID, item.IsActive);

        if (response.Data == 0)
        {
            item.IsActive = currentStatus;
            await ToastService.ShowErrorAsync("Error updating status", "Error");
        }

        StateHasChanged();
    }

    private async Task SaveEdit(SocialMedia item, string fieldName, object newValue)
    {
        showPopup = false;
        var property = typeof(SocialMedia).GetProperty(fieldName);
        if (property == null) return;

        var currentValue = property.GetValue(item);
        if (currentValue?.ToString() == newValue?.ToString()) return;

        if (property.PropertyType == typeof(int) && int.TryParse(newValue!.ToString(), out int intValue))
        {
            property.SetValue(item, intValue);
        }
        else if (property.PropertyType == typeof(string))
        {
            property.SetValue(item, newValue!.ToString());
        }

        var response = await SocialMediaService.EditAsync(item);
        if (response.IsSuccessStatusCode)
        {
            await ToastService.ShowSuccessAsync("Update successful", "Success");
        }
        else
        {
            await ToastService.ShowErrorAsync("Error updating item", "Error");
        }

        StateHasChanged();
    }

    private void UpdatePagedItems()
    {
        pagedItems = allItems.Skip((CurrentPage - 1) * PageSize).Take(PageSize).ToList();
    }

    private void HandlePageChanged(int newPage)
    {
        CurrentPage = newPage;
        UpdatePagedItems();
    }

    private void HandlePageSizeChanged(int newSize)
    {
        showPopup = false;
        PageSize = newSize;
        CurrentPage = 1;
        UpdatePagedItems();

    }
}
