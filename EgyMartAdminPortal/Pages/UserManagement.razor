@page "/user-management"
@inject UserService UserService
@inject ToastrService ToastService

<PageTitle>User Management</PageTitle>
<h3 class="mb-4">User Management</h3>

<Popup IsVisible="showPopup" Title="@popupTitle" OnSave="CreateAsync" FormModel="@newItem">
    <div class="form-group">
        <label for="displayName">Display Name</label>
        <input type="text" class="form-control" id="displayName" @bind="newItem.DisplayName" @ref="itemRef" />
        <ValidationMessage For="@(() => newItem.DisplayName)" />
    </div>
    <div class="form-group">
        <label for="userName">Email</label>
        <input type="text" class="form-control" id="userName" @bind="newItem.UserName" />
        <ValidationMessage For="@(() => newItem.UserName)" />
    </div>
    <div class="form-group">
        <label for="password">Password</label>
        <div class="input-group">
            <input type="@(showPassword ? "text" : "password")"
            class="form-control"
            id="password"
            @bind="newItem.Password" />
            <span class="input-group-text bg-white border-start-0 border">
                <button type="button"
                class="btn btn-link p-0 m-pass"
                @onclick="TogglePasswordVisibility"
                tabindex="-1">
                    <i class="@GetEyeIcon()"></i>
                </button>
            </span>
        </div>
        <ValidationMessage For="@(() => newItem.Password)" />
    </div>
    <div class="form-group">
        <label for="confirmPassword">Repeat Password</label>
        <div class="input-group">
            <input type="@(showPassword ? "text" : "password")"
            class="form-control"
            id="confirmPassword"
            @bind="newItem.ConfirmPassword" />
            <span class="input-group-text bg-white border-start-0 border">
                <button type="button"
                class="btn btn-link p-0 m-pass"
                @onclick="TogglePasswordVisibility"
                tabindex="-1">
                    <i class="@GetEyeIcon()"></i>
                </button>
            </span>
        </div>
        <ValidationMessage For="@(() => newItem.ConfirmPassword)" />
    </div>
    <div class="form-group">
        <label for="userType">Type</label>
        <input type="text" class="form-control" id="userType" @bind="newItem.UserTypeID" />
        <ValidationMessage For="@(() => newItem.UserTypeID)" />
    </div>
</Popup>

<div class="mt-3 text-center">
    <LoadingSpinner IsLoading="isLoading" />
</div>

<div class="d-flex align-items-center">
    <ul class="nav nav-tabs border-0">
        @foreach (var tab in Tabs)
        {
            <li class="nav-item">
                <button class="nav-link @(tab.IsActive ? "active text-primary border-bottom border-primary" : "text-muted")"
                @onclick="() => SelectTab(tab)">
                    @tab.Name <span class="badge bg-light text-dark ms-1">@tab.Count</span>
                </button>
            </li>
        }
    </ul>
</div>

<div class="tab-content mt-3">
    <div class="row">
        @if (SelectedTab != null)
        {
            <div class="col-md-3 my-4">
                <div class="card add-admin-card cursor-pointer border-primary shadow-sm p-3 bg-white rounded-3 d-flex flex-column justify-content-between h-100" @onclick="AddUser">
                    <div class="card-body d-flex flex-column align-items-center justify-content-center text-center">
                        <i class="fa-solid fa-plus fa-2x text-primary mb-2"></i>
                        <h5 class="card-title text-primary mb-0">Add Admin</h5>
                    </div>
                </div>
            </div>
        }

        @foreach (var person in pagedItems)
        {
            <div class="col-md-3 my-4">
                <PeopleCard Person="@person" />
            </div>
        }
    </div>
</div>

@if (SelectedTab != null)
{
    <UserPagination TItem="Person" CurrentPage="@CurrentPage" PageSize="@SelectedTab.PageSize" TotalCount="@SelectedTab.Count" OnPageChanged="HandlePageChanged" />
}


<style>
    .row {
    display: flex;
    flex-wrap: wrap;
    }

    .col-md-3 {
    display: flex;
    justify-content: stretch;
    }

    .card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    height: 100%;
    width: 100%;
    }

    .add-admin-card {
    height: 100%;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

    .add-admin-card:hover {
    transform: scale(0.9);
    box-shadow: 0px 5px 15px rgba(0, 0, 255, 0.2);
    }

    .m-pass:focus {
    box-shadow: 0 0 0 0.1rem white, 0 0 0 0.1rem white !important;
    }

    .btn-link:hover {
    color: var(--primary-color) !important;
    }
</style>

@code {
    public class TabItem
    {
        public string Name { get; set; } = string.Empty;
        public int Count { get; set; }              // from usersCount
        public int PageSize { get; set; } = 50;
        public int TotalPages => (int)Math.Ceiling((double)Count / PageSize);
        public List<short> UserTypeIDs { get; set; } = new();
        public bool IsActive { get; set; }
        public bool IsDataLoaded { get; set; } = false;
    }


    private List<TabItem> Tabs = new();
    private List<Person> FilteredPeople = new();
    private List<Person> pagedItems = new();
    private List<Person> People = new();
    private Person newItem = new();
    private TabItem SelectedTab { get; set; } = default!;
    public ElementReference itemRef;

    private string popupTitle = "Add New Admin";
    private bool showPopup = false;
    private bool isLoading = false;
    private bool showPassword = false;

    private int CurrentPage = 1;
    private int PageSize = 50;

    protected override async Task OnInitializedAsync()
    {
        await LoadUserTypeCounts();
        foreach (var tab in Tabs)
        {
            tab.IsActive = false;
        }
    }

    private async Task LoadUserTypeCounts()
    {
        var result = await UserService.GetUsersTypesAsync();
        if (result.Success && result.Data is not null)
        {
            var groupedTabs = new List<TabItem>();

            // Admins: 3, 4, 5
            var adminTypes = result.Data.Where(t => new[] { 3, 4, 5 }.Contains(t.UserTypeID)).ToList();
            groupedTabs.Add(new TabItem
                {
                    Name = "Admins",
                    Count = adminTypes.Sum(a => a.UsersCount),
                    UserTypeIDs = adminTypes.Select(a => (short)a.UserTypeID).ToList()
                });

            // Customers
            var customerType = result.Data.FirstOrDefault(t => t.UserTypeID == 1);
            if (customerType != null)
            {
                groupedTabs.Add(new TabItem
                    {
                        Name = "Customers",
                        Count = customerType.UsersCount,
                        UserTypeIDs = new() { 1 }
                    });
            }

            // Suppliers
            var supplierType = result.Data.FirstOrDefault(t => t.UserTypeID == 2);
            if (supplierType != null)
            {
                groupedTabs.Add(new TabItem
                    {
                        Name = "Suppliers",
                        Count = supplierType.UsersCount,
                        UserTypeIDs = new() { 2 }
                    });
            }

            Tabs = groupedTabs;
            StateHasChanged();
        }
    }

    private async Task GetUsersByTypeAsync()
    {
        People.Clear();
        Tabs.Clear();

        var result = await UserService.GetUsersTypesAsync();

        if (result?.Success == true && result.Data != null)
        {
            foreach (var userType in result.Data)
            {
                var usersResult = await UserService.GetListByTypeAsync(userType.UserTypeID, CurrentPage, PageSize);

                if (usersResult?.Success == true && usersResult.Data != null)
                {
                    People.AddRange(usersResult.Data);

                    var displayName = userType.UserTypeID switch
                    {
                        3 or 4 or 5 => "Admins",
                        1 => "Customers",
                        2 => "Suppliers",
                        _ => userType.UserTypeTitle
                    };

                    Tabs.Add(new TabItem
                        {
                            Name = displayName,
                            Count = userType.UsersCount,
                            UserTypeIDs = new List<short> { userType.UserTypeID },
                            IsActive = false
                        });

                }
            }

            if (Tabs.Count > 0)
            {
                await SelectTab(Tabs.First());
            }
        }
    }

    private async Task SelectTab(TabItem selectedTab)
    {
        showPopup = false;

        isLoading = true;
        StateHasChanged();

        if (selectedTab == null) return;

        foreach (var tab in Tabs)
            tab.IsActive = tab == selectedTab;

        SelectedTab = selectedTab;
        CurrentPage = 1;

        if (!selectedTab.IsDataLoaded)
        {
            var people = new List<Person>();
            foreach (var userType in selectedTab.UserTypeIDs)
            {
                var result = await UserService.GetListByTypeAsync(userType, CurrentPage, PageSize);
                if (result.Success && result.Data != null)
                {
                    people.AddRange(result.Data);
                }
            }

            People.AddRange(people);
            selectedTab.IsDataLoaded = true;
        }

        UpdateFilteredPeople(selectedTab.UserTypeIDs);
        UpdatePagedItems();

        isLoading = false;
        StateHasChanged();
    }

    private void AddUser()
    {
        showPopup = true;
        newItem = new Person();
    }

    private async Task CreateAsync()
    {
        try
        {
            isLoading = true;
            newItem.UserTypeID = 5;
            newItem.FirstLogin = true;
            var response = await UserService.CreateUserAsync(newItem);

            if (response.Success)
            {
                newItem.UserID = response.Data.UserId;

                FilteredPeople.Add(newItem);

                UpdatePagedItems();

                var adminTab = Tabs.FirstOrDefault(t => t.Name == "Admins");
                if (adminTab != null)
                {
                    adminTab.Count++;
                    adminTab.IsDataLoaded = true;
                }

                await ToastService.ShowSuccessAsync("User Created Successfully", "Success");
                showPopup = false;
            }
            else
            {
                await ToastService.ShowErrorAsync(response.ResponseEngMsg ?? "Error While Creating New User", "Error");
            }
        }
        catch (Exception ex)
        {
            await ToastService.ShowErrorAsync($"Unexpected error: {ex.Message}", "Error");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    void UpdateFilteredPeople(List<short> userTypeIDs)
    {
        showPopup = false;
        FilteredPeople = People.Where(p => userTypeIDs.Contains(p.UserTypeID)).ToList();
        UpdatePagedItems();
    }

    private void UpdatePagedItems()
    {
        showPopup = false;
        pagedItems = FilteredPeople;
        StateHasChanged();
    }

    private async void HandlePageChanged(int newPage)
    {
        isLoading = true;
        StateHasChanged();

        showPopup = false;
        CurrentPage = newPage;

        FilteredPeople.Clear();

        if (SelectedTab != null)
        {
            var people = new List<Person>();

            foreach (var userType in SelectedTab.UserTypeIDs)
            {
                var result = await UserService.GetListByTypeAsync(userType, CurrentPage, PageSize);
                if (result.Success && result.Data != null)
                {
                    people.AddRange(result.Data);
                }
            }

            FilteredPeople = people;
            UpdatePagedItems();
        }
        isLoading = false;
        StateHasChanged();
    }


    private void TogglePasswordVisibility()
    {
        showPassword = !showPassword;
    }

    private string GetEyeIcon()
    {
        return showPassword ? "fas fa-eye-slash" : "fas fa-eye";
    }

    // private async Task HandleImageUploaded(string base64Image)
    // {
    //     newItem.ProfileImage = base64Image;
    //     await InvokeAsync(StateHasChanged);
    // }
}
