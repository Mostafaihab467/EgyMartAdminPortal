@page "/user-management"
@inject UserService UserService
@inject ToastrService ToastService

<PageTitle>User Management</PageTitle>
<h3 class="mb-4">User Management</h3>

<Popup IsVisible="showPopup" Title="@popupTitle" OnSave="CreateAsync" FormModel="@newItem">
    <div class="form-group">
        <label for="displayName">Display Name</label>
        <input type="text" class="form-control" id="displayName" @bind="newItem.DisplayName" @ref="itemRef" />
        <ValidationMessage For="@(() => newItem.DisplayName)" />
    </div>
    <div class="form-group">
        <label for="userName">Email</label>
        <input type="text" class="form-control" id="userName" @bind="newItem.UserName" />
        <ValidationMessage For="@(() => newItem.UserName)" />
    </div>
    <div class="form-group">
        <label for="profileImage">Profile Image</label>
        <FileDropZone InputFile="true" OnImageUploaded="@(EventCallback.Factory.Create<string>(this, HandleImageUploaded))" />
        <ValidationMessage For="@(() => newItem.ProfileImage)" />
    </div>
</Popup>

<div class="d-flex align-items-center">
    <ul class="nav nav-tabs border-0">
        @foreach (var tab in Tabs)
        {
            <li class="nav-item">
                <button class="nav-link @(tab.IsActive ? "active text-primary border-bottom border-primary" : "text-muted")"
                @onclick="() => SelectTab(tab)">
                    @tab.Name <span class="badge bg-light text-dark ms-1">@tab.Count</span>
                </button>
            </li>
        }
    </ul>
</div>

<div class="tab-content mt-3">
    <div class="row">
        @if (SelectedTab != null)
        {
            <div class="col-md-3 my-3">
                <div class="card add-admin-card cursor-pointer border-primary shadow-sm p-3 bg-white rounded-3 h-90 d-flex align-items-center justify-content-center" @onclick="AddUser">
                    <div class="card-body d-flex flex-column align-items-center justify-content-center text-center">
                        <i class="fa-solid fa-plus fa-2x text-primary mb-2"></i>
                        <h5 class="card-title text-primary mb-0">Add Admin</h5>
                    </div>
                </div>
            </div>
        }

        @foreach (var person in pagedItems)
        {
            <PeopleCard Person="@person" />
        }
    </div>
</div>

<MPagination TItem="Person"
Items="FilteredPeople"
CurrentPage="@CurrentPage"
PageSize="@PageSize"
OnPageChanged="HandlePageChanged" />

<style>
    .add-admin-card {
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

    .add-admin-card:hover {
    transform: scale(0.9);
    box-shadow: 0px 5px 15px rgba(0, 0, 255, 0.2);
    }
</style>

@code {
    public class TabItem
    {
        public string Name { get; set; } = string.Empty;
        public int Count { get; set; }
        public short UserTypeID { get; set; }
        public bool IsActive { get; set; }
    }

    private Dictionary<short, string> UserTypeNames = new()
    {
        { 5, "Admins" },
        { 2, "Suppliers" },
        { 1, "Customers" },
    };

    private List<TabItem> Tabs = new();
    private List<Person> FilteredPeople = new();
    private List<Person> pagedItems = new();
    private List<Person> People = new();
    private Person newItem = new();
    private TabItem SelectedTab { get; set; } = default!;
    public ElementReference itemRef;

    private string popupTitle = "Add New Admin";
    private bool showPopup = false;
    private bool isLoading = true;

    private int CurrentPage = 1;
    private int PageSize = 50;

    protected override async Task OnInitializedAsync()
    {
        await GetUsersByTypeAsync();
        showPopup = false;
    }

    private async Task GetUsersByTypeAsync()
    {
        People.Clear();
        foreach (var userType in UserTypeNames.Keys)
        {
            var result = await UserService.GetListByTypeAsync(userType, CurrentPage, PageSize);
            Console.WriteLine($"User Type: {userType},  result: {result?.ResponseEngMsg ?? "NULL"}");

            if (result?.Success == true && result.Data != null)
            {
                People.AddRange(result.Data);
            }
            else
            {
                Console.WriteLine($"User Type: {userType} failed or returned null data.");
            }

        }

        Tabs = People.GroupBy(p => p.UserTypeID)
                     .Select(g => new TabItem
                         {
                             Name = UserTypeNames.ContainsKey(g.Key) ? UserTypeNames[g.Key] : $"Type {g.Key}",
                             Count = g.Count(),
                             UserTypeID = g.Key,
                             IsActive = false
                         }).ToList();

        if (Tabs.Count > 0)
        {
            SelectTab(Tabs.First());
        }
    }

    void SelectTab(TabItem selectedTab)
    {
        showPopup = false;
        foreach (var tab in Tabs)
        {
            tab.IsActive = tab == selectedTab;
        }
        CurrentPage = 1;
        SelectedTab = selectedTab;
        UpdateFilteredPeople(selectedTab.UserTypeID);
    }

    void UpdateFilteredPeople(short userTypeID)
    {
        showPopup = false;
        FilteredPeople = (userTypeID == 0) ? People.ToList() : People.Where(p => p.UserTypeID == userTypeID).ToList();
        UpdatePagedItems();
    }

    private void AddUser()
    {
        showPopup = true;
        newItem = new Person();
    }

    private async Task CreateAsync()
    {
        try
        {
            newItem.UserTypeID = 1;
            newItem.FailLoginCount = 0;
            newItem.VerificationStatus = 0;
            newItem.IsActive = true;

            var response = await UserService.CreateUserAsync(newItem);

            if (response.Success)
            {
                newItem.UserID = response.Data;
                People.Add(newItem);
                UpdateFilteredPeople(SelectedTab.UserTypeID);

                await ToastService.ShowSuccessAsync("User Created Successfully", "Success");
                showPopup = false;
            }
            else
            {
                await ToastService.ShowErrorAsync(response.ResponseEngMsg ?? "Error While Creating New User", "Error");
            }
        }
        catch (Exception ex)
        {
            await ToastService.ShowErrorAsync($"Unexpected error: {ex.Message}", "Error");
        }
    }

    private async Task HandleImageUploaded(string base64Image)
    {
        newItem.ProfileImage = base64Image;
        await InvokeAsync(StateHasChanged);
    }

    private void UpdatePagedItems()
    {
        showPopup = false;
        pagedItems = FilteredPeople.Skip((CurrentPage - 1) * PageSize).Take(PageSize).ToList();
    }

    private void HandlePageChanged(int newPage)
    {
        showPopup = false;
        CurrentPage = newPage;
        UpdatePagedItems();
    }
}
