@page "/user-management"

<PageTitle>User Management</PageTitle>
<h3 class="mb-4">User Management</h3>

<div class="d-flex align-items-center">
    <ul class="nav nav-tabs border-0">
        @foreach (var tab in Tabs)
        {
            <li class="nav-item">
                <button class="nav-link @(tab.IsActive ? "active text-primary border-bottom border-primary" : "text-muted")"
                @onclick="() => SelectTab(tab)">
                    @tab.Name <span class="badge bg-light text-dark ms-1">@tab.Count</span>
                </button>
            </li>
        }
    </ul>
    @* <div class="ms-auto"> *@
    @*     <button class="btn btn-light bg-white"><i class="fa-solid fa-grip"></i></button> *@
    @*     <button class="btn btn-light bg-white"><i class="fa-solid fa-list-ul"></i></button> *@
    @* </div> *@
</div>

<div class="tab-content mt-3">
    <div class="row">
        @foreach (var person in pagedItems)
        {
            <PeopleCard Person="@person" />
        }
    </div>
</div>

<!-- Pagination Component -->
<MPagination TItem="Person"
Items="FilteredPeople"
CurrentPage="@CurrentPage"
PageSize="@PageSize"
OnPageChanged="HandlePageChanged" />

@code {
    public class TabItem
    {
        public string Name { get; set; } = string.Empty;
        public int Count { get; set; }
        public short UserTypeID { get; set; }
        public bool IsActive { get; set; }
    }

    private Dictionary<short, string> UserTypeNames = new()
    {
        { 1, "Admins" },
        { 2, "Suppliers" },
        { 3, "Customers" },
    };

    private List<TabItem> Tabs = new();
    private List<Person> FilteredPeople = new();
    private List<Person> pagedItems = new();
    private List<Person> People = new();

    private int CurrentPage = 1;
    private int PageSize = 12;

    protected override void OnInitialized()
    {
        GenerateUsers();

        // Add "All" tab with total count
        Tabs.Add(new TabItem
            {
                Name = "All",
                Count = People.Count,
                UserTypeID = 0, // Special value for "All"
                IsActive = true // Default active
            });

        // Generate user type tabs
        Tabs.AddRange(People.GroupBy(p => p.UserTypeID)
                            .Select(g => new TabItem
                                {
                                    Name = UserTypeNames.ContainsKey(g.Key) ? UserTypeNames[g.Key] : $"Type {g.Key}",
                                    Count = g.Count(),
                                    UserTypeID = g.Key,
                                    IsActive = false
                                }));

        UpdateFilteredPeople(0); // Show all by default
    }

    void SelectTab(TabItem selectedTab)
    {
        foreach (var tab in Tabs)
        {
            tab.IsActive = tab == selectedTab;
        }
        CurrentPage = 1;
        UpdateFilteredPeople(selectedTab.UserTypeID);
    }

    void UpdateFilteredPeople(short userTypeID)
    {
        FilteredPeople = (userTypeID == 0) ? People.ToList() : People.Where(p => p.UserTypeID == userTypeID).ToList();
        UpdatePagedItems();
    }

    private void GenerateUsers()
    {
        string[] names = { "John", "Jane", "Alice", "Bob", "Charlie", "David", "Eva", "Frank", "Grace", "Henry" };
        string[] surnames = { "Doe", "Smith", "Johnson", "Brown", "White", "Green", "Black", "Adams", "Clark", "Davis" };
        Random rnd = new Random();

        for (int i = 1; i <= 40; i++)
        {
            string firstName = names[rnd.Next(names.Length)];
            string lastName = surnames[rnd.Next(surnames.Length)];
            string email = $"{firstName.ToLower()}{lastName.ToLower()}{rnd.Next(10, 99)}@egymart.com";

            People.Add(new Person
                {
                    UserID = i,
                    UserTypeID = (short)rnd.Next(1, 4),
                    DisplayName = $"{firstName} {lastName}",
                    UserName = email,
                    ProfileImage = "https://picsum.photos/200/300",
                    RegisterdSince = new DateTime(rnd.Next(2015, 2023), rnd.Next(1, 13), rnd.Next(1, 28)), // Random date from 2015-2023
                    IsVerfied = rnd.Next(2) == 1, // Random true/false
                    IsActive = rnd.Next(2) == 1, // Random true/false
                    VerificationStatus = (short)rnd.Next(0, 3), // 0 = Pending, 1 = Verified, 2 = Denied
                    FailLoginCount = rnd.Next(0, 10) // Random login fail count
                });
        }
    }

    private void UpdatePagedItems()
    {
        
        pagedItems = FilteredPeople.Skip((CurrentPage - 1) * PageSize).Take(PageSize).ToList();
    }

    private void HandlePageChanged(int newPage)
    {
        CurrentPage = newPage;
        UpdatePagedItems();
    }
}
