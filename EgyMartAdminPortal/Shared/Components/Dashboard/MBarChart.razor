<div class="card shadow-sm p-4">
    <div class="bg-white d-flex fs-6 fw-bold justify-content-between align-items-center mb-3 p-0 border-bottom-0">
        <h6 class="fw-bold">@Title</h6>
        <div class="d-flex align-items-center gap-2">
            <span class="text-muted mb-1 fs-15">Last Week</span>
            <DashboardExportMenu FileName="@($"{GetSafeFileName(Title)}.xlsx")"
                                 SheetName="@Title"
                                 Rows="@ExportRows" />
        </div>
    </div>

    <svg width="100%" height="150" viewBox="0 1 250 80">
        @foreach (var data in SortedData)
        {
            <rect x="@GetXPosition(data.ViewDay!)" y="@GetYPosition(data.ViewsCount)"
                  width="@BarWidth" height="@GetBarHeight(data.ViewsCount)"
                  fill="@BarColor" rx="4"></rect>
            @((MarkupString)$"<text x='{GetXPosition(data.ViewDay!) + (BarWidth / 2)}' y='{GetYPosition(data.ViewsCount) - 5}' font-size='10' fill='black' text-anchor='middle'>{data.ViewsCount}</text>")
        }
    </svg>

    <div class="d-flex justify-content-between mt-1" style="margin-right: 0.6rem !important;
  margin-left: 0.8rem !important;">
        @foreach (var day in WeekDays)
        {
            <span class="text-muted small">@day</span>
        }
    </div>
</div>

@code {
    [Parameter] public string Title { get; set; } = "Title";
    [Parameter] public List<ViewDayData> ViewData { get; set; } = new();
    [Parameter] public string BarColor { get; set; } = "#990202";
    [Parameter] public int MaxHeight { get; set; } = 90;

    private readonly string[] WeekDays = { "Mo", "Tu", "We", "Th", "Fr", "Sa", "Su" };
    private const int BarSpacing = 35;
    private const int BarWidth = 25;

    private IEnumerable<ViewDayData> SortedData => (ViewData ?? new List<ViewDayData>())
    .Any() ? WeekDays.Select(d =>
        ViewData!.FirstOrDefault(v => GetShortDay(v.ViewDay!) == d) ?? new ViewDayData { ViewDay = d, ViewsCount = 0 })
    : new List<ViewDayData>();

    private IEnumerable<object> ExportRows => SortedData.Select(data => new
    {
        Day = data.ViewDay,
        Views = data.ViewsCount
    });


    private int GetXPosition(string day) => Array.IndexOf(WeekDays, GetShortDay(day)) * BarSpacing + 10;
    private int GetYPosition(int count) => 100 - (count * MaxHeight / (GetMaxViewCount() == 0 ? 1 : GetMaxViewCount()));
    private int GetBarHeight(int count) => (count * MaxHeight / (GetMaxViewCount() == 0 ? 1 : GetMaxViewCount()));
    private string GetShortDay(string? fullDay) => !string.IsNullOrEmpty(fullDay) && fullDay.Length >= 2 ? fullDay[..2] : "--";
    private int GetMaxViewCount() => ViewData.Any() ? ViewData.Max(v => v.ViewsCount) : 100;
    private static string GetSafeFileName(string value)
    {
        var invalidChars = Path.GetInvalidFileNameChars();
        var safeName = new string(value.Select(c => invalidChars.Contains(c) ? '-' : c).ToArray());
        return string.IsNullOrWhiteSpace(safeName) ? "Dashboard-Statistic" : safeName;
    }
}

<style>
    .card {
        max-width: 250px;
        border-radius: 10px;
    }

    .fs-15 {
        font-size: 12px;
    }
</style>
