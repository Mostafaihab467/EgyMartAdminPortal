@using System.ComponentModel.DataAnnotations
@if (IsVisible)
{
    <div class="modal d-block position-fixed top-0 start-0 w-100 h-100 bg-dark bg-opacity-75" style="z-index: 1050;">
        <div class="d-flex justify-content-center align-items-center h-100 px-3">
            <div class="modal-content p-4 shadow-lg w-50 responsive-modal">
                <div class="modal-header border-0">
                    <h5 class="modal-title">Change Password</h5>
                    <button type="button" class="btn-close" @onclick="OnClose"></button>
                </div>
                <div class="modal-body">
                    <EditForm Model="Model" OnValidSubmit="Submit">
                        <DataAnnotationsValidator />
                        <ValidationSummary />

                        <div class="mb-3 position-relative">
                            <label class="form-label">New Password</label>
                            <input type="@(ShowPassword ? "text" : "password")"
                                   class="form-control pe-5"
                                   @bind="Model.NewPassword"
                                   placeholder="Enter Your Password" />
                            <button type="button"
                                    class="btn btn-sm position-absolute end-0 translate-middle-y me-2"
                                    style="z-index: 2; top: 73% !important;"
                                    @onclick="TogglePasswordVisibility">
                                <i class="@(ShowPassword ? "bi bi-eye-slash" : "bi bi-eye")"></i>
                            </button>
                        </div>

                        <div class="mb-3 position-relative">
                            <label class="form-label">Confirm Password</label>
                            <input type="@(ShowPassword ? "text" : "password")"
                                   class="form-control"
                                   @bind="Model.ConfirmPassword"
                                   placeholder="Confirm Password" />
                        </div>

                        <div class="d-flex justify-content-end flex-wrap gap-2">
                            <button type="submit" class="btn btn-primary">Change</button>
                            <button type="button" class="btn btn-secondary" @onclick="OnClose">Cancel</button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
}


@code {
    [Parameter] public bool IsVisible { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public long UserID { get; set; }
    [Parameter] public Func<long, string, string, Task<bool>>? ChangePasswordMethod { get; set; }
    [Parameter] public EventCallback OnPasswordChanged { get; set; }

    private ChangePasswordModel Model { get; set; } = new();
    private bool ShowPassword { get; set; } = false;

    protected override Task OnInitializedAsync()
    {
        if (Model.NewPassword != null)
        {
            Model.NewPassword = string.Empty;
            Model.ConfirmPassword = string.Empty;
        }
        return Task.CompletedTask;
    }

    private void TogglePasswordVisibility()
    {
        ShowPassword = !ShowPassword;
    }

    private async Task Submit()
    {
        if (ChangePasswordMethod is not null)
        {
            var result = await ChangePasswordMethod.Invoke(UserID, Model.NewPassword, Model.ConfirmPassword);
            if (result)
            {
                await OnPasswordChanged.InvokeAsync();
            }
        }
    }

    public class ChangePasswordModel
    {
        [Required(ErrorMessage = "New Password is required.")]
        public string NewPassword { get; set; } = string.Empty;

        [Required(ErrorMessage = "Confirm Password is required.")]
        [Compare("NewPassword", ErrorMessage = "Passwords do not match.")]
        public string ConfirmPassword { get; set; } = string.Empty;
    }
}

<style>
    .modal-backdrop {
        z-index: 1040;
    }

    .modal-content {
        z-index: 1050;
    }

    .modal .modal-header {
        background-color: transparent !important;
    }

    .modal-body {
        padding: 20px;
    }

    .btn-close {
        background-color: transparent;
        border: none;
        font-size: 1.5rem;
    }

</style>