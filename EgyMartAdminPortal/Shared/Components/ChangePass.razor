@if (IsVisible)
{
    <div class="modal d-block position-fixed top-0 start-0 w-100 h-100 bg-dark bg-opacity-75" style="z-index: 1050;">
        <div class="d-flex justify-content-center align-items-center h-100">
            <div class="modal-content p-4 shadow-lg" style="width: 100%; max-width: 600px; border-radius: 10px; background-color: white;">
                <div class="modal-header">
                    <h5 class="modal-title">Change Password</h5>
                    <button type="button" class="btn-close" @onclick="OnClose"></button>
                </div>
                <div class="modal-body">
                    <EditForm Model="Model" OnValidSubmit="Submit">
                        <DataAnnotationsValidator />
                        <ValidationSummary />

                        <div class="mb-3">
                            <label class="form-label">New Password</label>
                            <InputText type="password" class="form-control" @bind-Value="Model.NewPassword" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Confirm Password</label>
                            <InputText type="password" class="form-control" @bind-Value="Model.ConfirmPassword" />
                        </div>

                        <div class="d-flex justify-content-end">
                            <button type="submit" class="btn btn-primary">Change</button>
                            <button type="button" class="btn btn-secondary ms-2" @onclick="OnClose">Cancel</button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsVisible { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public long UserID { get; set; }
    [Parameter] public Func<long, string, string, Task<bool>>? ChangePasswordMethod { get; set; }
    [Parameter] public EventCallback OnPasswordChanged { get; set; }

    private ChangePasswordModel Model { get; set; } = new();

    private async Task Submit()
    {
        if (ChangePasswordMethod is not null)
        {
            var result = await ChangePasswordMethod.Invoke(UserID, Model.NewPassword, Model.ConfirmPassword);
            if (result)
            {
                await OnPasswordChanged.InvokeAsync();
            }
        }
    }

    public class ChangePasswordModel
    {
        public string NewPassword { get; set; } = string.Empty;
        public string ConfirmPassword { get; set; } = string.Empty;
    }
}


<style>
    .modal-backdrop {
        z-index: 1040;
    }

    .modal-content {
        z-index: 1050;
    }

    .modal .modal-header {
        background-color: transparent !important;
    }

    .modal-body {
        padding: 20px;
    }

    .btn-close {
        background-color: transparent;
        border: none;
        font-size: 1.5rem;
    }

</style>