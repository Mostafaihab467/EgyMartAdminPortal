        <div class="dropdown-divider"></div>

        @* <a class="dropdown-item" href="/settings"><i class="fas fa-cog"></i> Settings</a> *@
        @* <a class="dropdown-item" href="/pricing"><i class="far fa-credit-card"></i> Pricing</a> *@
        @* <a class="dropdown-item" href="/faq"><i class="far fa-question-circle"></i> FAQ</a> *@

        <a class="dropdown-item" @onclick="Logout"><i class="fas fa-power-off"></i> Logout</a>
    </div>
