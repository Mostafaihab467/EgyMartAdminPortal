@* Shared/UserDropdown.razor *@
@inject NavigationManager Navigation
@inject AuthService AuthService

<li class="nav-item dropdown dropdown-user">
    <a class="nav-link dropdown-toggle dropdown-user-link" id="dropdown-user" href="" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
        <div class="user-nav d-sm-flex">
            <span class="user-name fw-bolder">@User!.DisplayName</span>
        </div>
        <span class="avatar">
            <img class="round" src="@User.ProfileImage" alt="avatar" height="40" width="40">
            <span class="avatar-status-online"></span>
        </span>
        <span>
            <i class="fa-solid fa-caret-down"></i>
        </span>
    </a>
    <div class="dropdown-menu dropdown-menu-end p-2" aria-labelledby="dropdown-user">
        <a class="dropdown-item fs-6"><i class="fas fa-unlock-alt"></i> Change Password</a>
        <div class="dropdown-divider"></div>
        <a class="dropdown-item fs-6" @onclick="Logout"><i class="fa-solid fa-right-from-bracket"></i> Logout</a>
    </div>
</li>

@code {
    [Parameter] public Person? User { get; set; }

    private async Task Logout() => await AuthService.LogoutAsync();
}