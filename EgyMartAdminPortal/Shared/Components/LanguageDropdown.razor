@inject NavigationManager Navigation
@inject LanguageService LanguageService

<li class="nav-item dropdown dropdown-language">
    <div class="dropdown">
        <a class="nav-link dropdown-toggle" id="dropdownFlag" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
            <i class="@SelectedLanguage?.FlagClass"></i>
            <span class="selected-language">@SelectedLanguage?.LangTitle</span>
        </a>
        @* <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="dropdownFlag"> *@
        @*     @foreach (var language in Languages) *@
        @*     { *@
        @*         <li> *@
        @*             <a class="dropdown-item" href="#" @onclick="() => ChangeLanguage(language)"> *@
        @*                 <i class="@language.FlagClass"></i> @language.LangTitle *@
        @*             </a> *@
        @*         </li> *@
        @*     } *@
        @* </ul> *@
    </div>
</li>

@code {
    private List<Language> Languages { get; set; } = new();
    private Language? SelectedLanguage { get; set; }

    protected override async Task OnInitializedAsync()
    {
        Languages = await LanguageService.GetAsync();
        SelectedLanguage = Languages.FirstOrDefault() ?? new Language { LangTitle = "English" };

        // Remove selected language from the list on initialization
        Languages.Remove(SelectedLanguage);
    }

    private void ChangeLanguage(Language language)
    {
        // Add the previous language back to the list
        if (SelectedLanguage != null)
        {
            Languages.Add(SelectedLanguage);
        }

        // Set the new selected language and remove it from the list
        SelectedLanguage = language;
        Languages.Remove(language);

        StateHasChanged();
    }
}
