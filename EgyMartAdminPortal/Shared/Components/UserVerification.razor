@inject ToastrService ToastService

<div class="d-inline-block">
    @if (VerificationStatus == 0)
    {
        <Button class="btn btn-primary me-2" TooltipTitle="Verify" TooltipPlacement="TooltipPlacement.Top"
                data-bs-original-title="Verify" @onclick="() => VerificationUser(1)">
            <i class="fas fa-user-check"></i>
        </Button>

        <Button class="btn btn-primary me-2" TooltipTitle="Deny" TooltipPlacement="TooltipPlacement.Top"
                data-bs-original-title="Deny" @onclick="() => VerificationUser(2)">
            <i class="fa-solid fa-ban"></i>
        </Button>
        @if (IsSupplier)
        {
            <Button class="btn btn-primary" TooltipTitle="Show Attachment" TooltipPlacement="TooltipPlacement.Top"
                    data-bs-original-title="Show Attachment" @onclick="() => ShowAttachement()">
                <i class="fa-solid fa-file-pdf"></i>
            </Button>
        }

    }
    else
    {
        <span class="@StatusClass">@StatusText</span>
    }
</div>

@code {
    [Parameter] public long UserID { get; set; }
    [Parameter] public int? VerificationStatus { get; set; } // 0 = Pending, 1 = Verified, 2 = Denied
    [Parameter] public bool IsSupplier { get; set; } = false;
    [Parameter] public EventCallback OnUserUpdated { get; set; }
    [Parameter] public EventCallback OnShowAttachment { get; set; }
    [Parameter] public Func<short, Task<bool>>? VerifyUser { get; set; }

    private string StatusText => VerificationStatus == 1 ? "Verified" : VerificationStatus == 2 ? "Denied" : "";
    private string StatusClass => VerificationStatus == 1 ? "text-success" : "text-danger";

    private async Task VerificationUser(short status)
    {
        if (VerifyUser != null)
        {
            var response = await VerifyUser.Invoke(status);

            if (response)
            {
                VerificationStatus = status;
                StateHasChanged();
                await Task.Delay(3000);
                await ToastService.ShowSuccessAsync(status == 1 ? "User Verified Successfully" : "User Denied Successfully", "Success");

                await OnUserUpdated.InvokeAsync();
            }
        }
    }

    private async Task ShowAttachement()
    {
        await OnShowAttachment.InvokeAsync(UserID);
    }
}
