@typeparam T
@inject IJSRuntime JSRuntime


@if (IsEditing)
{
    @if (InputType == "textarea" && Frame)
    {
        <div>
            <textarea id="@Id" style="width: 100%; display: block;" @bind="EditingValue"></textarea>
            <div class="mt-2">
                <button class="btn btn-primary me-2" @onclick="SaveEdit">Save</button>
                <button class="btn btn-secondary" @onclick="CancelEdit">Cancel</button>
            </div>
        </div>
    }
    else if (InputType == "textarea")
    {
        <textarea type="text"
                  class="form-control w-75"
                  value="@EditingValue"
                  @ref="InputElement"
                  @oninput="HandleInputChange"
                  @onkeyup="HandleKeyPress"
                  @onblur="SaveEdit" />
    }
    else
    {
        <input type="text"
               class="form-control w-75"
               value="@EditingValue"
               @ref="InputElement"
               @oninput="HandleInputChange"
               @onkeyup="HandleKeyPress"
               @onblur="SaveEdit" />
    }
}
else if (Frame)
{
    <span class="cursor-pointer w-75 preview-text"
          @onclick="StartEditing"
          @onmouseover="StartPreview"
          @onmouseout="HidePreview">
        @Value
    </span>
}
else if (InputType == "faIcon")
{
    <i class="@Value fs-5" @onclick="StartEditing"></i>
}
else
{
    <span class="cursor-pointer w-75" @onclick="StartEditing">@Value</span>
}

@if (!string.IsNullOrEmpty(HtmlPreview) && !IsEditing)
{
    <div class="html-preview" style="display: @(ShowPreview ? "block" : "none");">
        <iframe srcdoc="@HtmlPreview" class="img-thumbnail"></iframe>
    </div>
}

<style>
    .preview-text {
        overflow: hidden;
        white-space: nowrap;
        text-overflow: ellipsis;
        display: inline-block;
        max-width: 52rem;
    }

    .html-preview {
        position: absolute;
        width: 200px;
        height: 220px;
        border: 1px solid #ddd;
        box-shadow: 2px 2px 10px rgba(0, 0, 0, 0.1);
        background: white;
        overflow: hidden;
        z-index: 10;
    }

        .html-preview iframe {
            width: 100%;
            height: 100%;
            border: none;
        }
</style>

@code {
    private string? _id;
    private readonly string _uid = Guid.NewGuid().ToString("N");

    [Parameter] public string Id { get => _id ?? $"CKEditor_{_uid}"; set => _id = value; }
    [Parameter] public T? Value { get; set; }
    [Parameter] public EventCallback<T> ValueChanged { get; set; }
    [Parameter] public string InputType { get; set; } = "text"; // Supports "text", "textarea", "ionIcon", "faIcon"
    [Parameter] public bool Frame { get; set; } = false;

    private bool IsEditing { get; set; } = false;
    private string EditingValue { get; set; } = "";
    private string HtmlPreview { get; set; } = "";
    private bool ShowPreview { get; set; } = false;
    private ElementReference InputElement { get; set; }
    private DotNetObjectReference<EditableField<T>>? _dotNetRef;

    private async void StartPreview()
    {
        if (typeof(T) == typeof(string))
        {
            HtmlPreview = Value?.ToString() ?? "";
        }
        ShowPreview = true;
        await Task.Delay(300);
        StateHasChanged();
    }

    private void HidePreview()
    {
        ShowPreview = false;
        StateHasChanged();
    }

    private async void StartEditing()
    {
        EditingValue = Value?.ToString() ?? "";
        IsEditing = true;
        StateHasChanged();

        await Task.Delay(50);

        if (InputType == "textarea" && Frame)
        {
            _dotNetRef = DotNetObjectReference.Create(this);
            await JSRuntime.InvokeVoidAsync("CKEditorInterop.init", Id, _dotNetRef);
        }
        else
        {
            await InputElement.FocusAsync();
        }
    }

    private void HandleInputChange(ChangeEventArgs e)
    {
        EditingValue = e.Value?.ToString() ?? "";
    }

    private async Task HandleKeyPress(KeyboardEventArgs e)
    {
        var isCKEditor = InputType == "textarea" && await JSRuntime.InvokeAsync<bool>("isInsideCKEditor");

        if (e.Key == "Enter" && !isCKEditor)
        {
            await SaveEdit();
        }
        else if (e.Key == "Escape")
        {
            await CancelEdit();
        }
    }

    private async Task SaveEdit()
    {
        IsEditing = false;

        if (InputType == "textarea" && Frame)
        {
            try
            {
                EditingValue = await JSRuntime.InvokeAsync<string>("CKEditorInterop.getData", Id);
            }
            catch (Exception)
            {
            }
        }

        if (typeof(T) == typeof(int) && int.TryParse(EditingValue, out int intValue))
        {
            await ValueChanged.InvokeAsync((T)(object)intValue);
        }
        else if (typeof(T) == typeof(string))
        {
            await ValueChanged.InvokeAsync((T)(object)EditingValue);
        }
        else
        {
            try
            {
                T? convertedValue = (T)Convert.ChangeType(EditingValue, typeof(T));
                await ValueChanged.InvokeAsync(convertedValue);
            }
            catch
            {
                Console.WriteLine($"Failed to convert {EditingValue} to {typeof(T)}");
            }
        }

        await CleanupEditor();
    }



    private async Task CancelEdit()
    {
        IsEditing = false;
        EditingValue = Value?.ToString() ?? "";
        StateHasChanged();
        await CleanupEditor();
    }

    private async Task CleanupEditor()
    {
        if (InputType == "textarea" && Frame)
        {
            await JSRuntime.InvokeVoidAsync("CKEditorInterop.destroy", Id);
        }
    }

    [JSInvokable]
    public Task EditorDataChanged(string data)
    {
        try
        {
            EditingValue = data;
        }
        catch
        {
            Console.WriteLine($"Failed to convert {data} to {typeof(T)}");
        }
        return Task.CompletedTask;
    }

    public async ValueTask DisposeAsync()
    {
        if (_dotNetRef != null)
        {
            await CleanupEditor();
            _dotNetRef.Dispose();
            _dotNetRef = null;
        }
    }
}
