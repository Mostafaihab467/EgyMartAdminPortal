@inject UserService UserService
@inject ToastrService ToastService

<div class="card text-center shadow-sm p-3 bg-white rounded-3">
    <Tooltip class="position-absolute top-0 start-0 m-2" Title="Verification Status" Placement="TooltipPlacement.Top">
        <span class="badge @(Person.VerificationStatus == 1 ? "bg-success" : Person.VerificationStatus == 2 ? "bg-danger" : "bg-warning")">
            @(Person.VerificationStatus == 1 ? "Verified" : Person.VerificationStatus == 2 ? "Denied" : "Pending")
        </span>
    </Tooltip>
    <Tooltip class="position-absolute top-0 end-0 m-2" Title="User Type" Placement="TooltipPlacement.Top">
        <span class="badge bg-success">@((Person.UserTypeID == 5 ? "Admin" : Person.UserTypeID == 2 ? "Supplier" : "Customer"))</span>
    </Tooltip>

    <div class="d-flex justify-content-center">
        <div class="profile-image-container d-flex justify-content-center align-items-center">
            <img src="@CurrentImageUrl"
                 class="rounded border border-3 border-white shadow"
                 width="100"
                 height="100"
                 alt="@Person.DisplayName"
                 onerror="handleImageError(this);" />
        </div>
    </div>

    <div class="pt-2">
        <h6 class="mt-2">@Person.DisplayName</h6>
        <p class="text-muted">@Person.UserName</p>
        <div class="d-flex justify-content-center gap-3 my-3">
            <Button class="btn btn-light rounded-circle d-flex align-items-center justify-content-center shadow-sm width-10-per" TooltipTitle="@(Person.IsActive ? "Make Suspend" : "Make Active")" TooltipPlacement="TooltipPlacement.Top"
                    @onclick="SetActiveStatus">
                <i class="fa-solid @(Person.IsActive ? "fa-lock" : "fa-lock-open") text-primary"></i>
            </Button>
            @if (Person.UserTypeID == 5)
            {
                <Button class="btn btn-light rounded-circle d-flex align-items-center justify-content-center shadow-sm width-10-per" TooltipTitle="Reset Password" TooltipPlacement="TooltipPlacement.Top"
                        @onclick="ResetPassword">
                    <i class="fa-solid fa-rotate text-primary"></i>
                </Button>
            }
            @if (Person.UserTypeID == 1 || Person.UserTypeID == 2)
            {
                <div class="dropdown">
                    <Button class="btn btn-light rounded-circle d-flex align-items-center justify-content-center shadow-sm width-10-per dropdown-toggle"
                            data-bs-toggle="dropdown" aria-expanded="false"
                            TooltipTitle="More" TooltipPlacement="TooltipPlacement.Top">
                        <i class="fa-solid fa-ellipsis text-primary"></i>
                    </Button>
                    <ul class="dropdown-menu">
                        <li>
                            <button class="dropdown-item @(Person.VerificationStatus == 1 ? "disabled" : "")" @onclick="() => SetVerificationStatus(1)">
                                <i class="fa-solid fa-circle-check"></i> Make Verified
                            </button>
                        </li>
                        <li>
                            <button class="dropdown-item @(Person.VerificationStatus == 2 ? "disabled" : "")" @onclick="() => SetVerificationStatus(2)">
                                <i class="fa-solid fa-circle-xmark"></i> Make Denied
                            </button>
                        </li>
                    </ul>
                </div>
            }
        </div>

        <small class="text-muted">Registered Since: @Person.RCDate.ToString("dd MMM yyyy")</small>

        <div class="mt-2">
            <Tooltip Title="Active Status" Placement="TooltipPlacement.Top">
                <span class="badge @(Person.IsActive ? "bg-success" : "bg-danger")">@(Person.IsActive ? "Active" : "Suspend")</span>
            </Tooltip>
        </div>

        <div class="d-flex justify-content-between align-items-center mt-3 text-muted">
            <div class="d-flex align-items-center gap-4 px-2">
                <Tooltip Class="d-flex align-items-center gap-2 rounded-3 bg-light p-1" Title="Fail Login Count" Placement="TooltipPlacement.Top">
                    <i class="fa-solid fa-key"></i>
                    <span class="fs-6">@Person.FailLoginCount</span>
                </Tooltip>
            </div>
            @* <Tooltip Class="d-flex align-items-center gap-2 rounded-3 bg-light p-1" Title="Last Login Date" Placement="TooltipPlacement.Top"> *@
            @*     <span class="fs-6">@(Person.LADate?.ToString("dd MMM yyyy") ?? "N/A")</span> *@
            @*     <i class="bi bi-clock"></i> *@
            @* </Tooltip> *@
        </div>
    </div>
</div>

<style>
    .profile-image-container {
        margin-top: -20%;
    }
</style>

@code {
    [Parameter] public Person Person { get; set; } = new();

    private string CurrentImageUrl => string.IsNullOrEmpty(Person.ProfileImage) ? "images/avatars/user.jpg" : Person.ProfileImage;

    private async Task SetVerificationStatus(short status)
    {
        if (Person.VerificationStatus == status)
            return;

        bool isSuccess = false;

        if (Person.UserTypeID == 1) // Customer
        {
            isSuccess = await UserService.VerifyCustomerAsync(Person.UserID, status);
        }
        else if (Person.UserTypeID == 2) // Supplier
        {
            isSuccess = await UserService.VerifySupplierAsync(Person.UserID, status);
        }

        if (isSuccess)
        {
            Person.VerificationStatus = status;
            await ToastService.ShowSuccessAsync("Verification status updated.", "Success");
        }
        else
        {
            await ToastService.ShowErrorAsync("Failed to update verification status.", "Error");
        }
    }

    private async Task ResetPassword()
    {
        bool isSuccess = await UserService.ResetPasswordAsync(Person.UserID);
        if (isSuccess)
        {
            await ToastService.ShowSuccessAsync("Password reset successfully.", "Success");
        }
        else
        {
            await ToastService.ShowErrorAsync("Failed to reset the password.", "Error");
        }
    }

    private async void SetActiveStatus()
    {
        bool newStatus = !Person.IsActive;

        bool isSuccess = await UserService.StateUserAsync(Person.UserID, newStatus);

        if (isSuccess)
        {
            Person.IsActive = newStatus;
            StateHasChanged();
        }
        else
        {
            Console.WriteLine("Failed to update the user status.");
        }
    }
}
