@inject AuthService AuthService
@inject NavigationManager Navigation
@inject SessionTimeoutService SessionTimeoutService

@if (!_authChecked)
{
    <div class="d-flex justify-content-center align-items-center vh-100">
        <div class="spinner-border text-primary" role="status"></div>
    </div>
}
else if (_isAuthenticated || IsLoginRoute())
{
    <CascadingValue Value="AuthService.User">
        <Router AppAssembly="@typeof(App).Assembly">
            <Found Context="routeData">
                <RouteView RouteData="@routeData" DefaultLayout="@(routeData.PageType == typeof(Login) ? null : typeof(MainLayout))" />
                <FocusOnNavigate RouteData="@routeData" Selector="h1" />
            </Found>
            <NotFound>
                <PageTitle>Not found</PageTitle>
                <LayoutView Layout="@typeof(MainLayout)">
                    <p role="alert">Sorry, there's nothing at this address.</p>
                </LayoutView>
            </NotFound>
        </Router>
    </CascadingValue>
}

@code {
    private bool _authChecked = false;
    private bool _isAuthenticated = false;

    private bool IsLoginRoute() =>
        Navigation.ToBaseRelativePath(Navigation.Uri).StartsWith("login", StringComparison.OrdinalIgnoreCase);

    protected override async Task OnInitializedAsync()
    {
        _isAuthenticated = await AuthService.HasValidSessionAsync();
        _authChecked = true;

        if (_isAuthenticated)
        {
            await SessionTimeoutService.InitializeAsync();
        }
        else if (!IsLoginRoute())
        {
            Navigation.NavigateTo("/login", forceLoad: true);
        }
    }
}
