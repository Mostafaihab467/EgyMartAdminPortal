@inherits LayoutComponentBase
@inject AuthService AuthService
@implements IDisposable

<RadzenDialog />
<AuthGuard>
    <div class="bb-page @(Loc.IsRtl ? "rtl" : "ltr")" dir="@(Loc.IsRtl ? "rtl" : "ltr")">
        <NavMenu />
        <main>
            <HeaderNavMenu User="AuthService.User"></HeaderNavMenu>
            <article class="content pt-5 px-4 ms-0">
                @Body
            </article>
        </main>
    </div>
</AuthGuard>

@code {
    protected override async Task OnInitializedAsync()
    {
        Loc.OnLanguageChanged += HandleLanguageChanged;
        await Loc.InitializeAsync();
    }

    private void HandleLanguageChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Loc.OnLanguageChanged -= HandleLanguageChanged;
    }
}
